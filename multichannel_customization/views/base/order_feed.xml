        <record model="ir.ui.view" id="order_feed_form_view">
            <field name="name">order.feed.form</field>
            <field name="model">order.feed</field>
            <field name="inherit_id" ref="odoo_multi_channel_sale.order_feed_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='invoice_country_id']" position="after">
                    <field name="company_name" 	readonly="state == 'done'"/>
                     <field name="customer_tag" 	readonly="state == 'done'"/>
                    
                </xpath>

                <field name="customer_company" position="after">
                    <field name="refund_json" groups="base.group_no_one" readonly="1"/>
                </field>
            </field>
        </record>

    </data>
</openerp>
