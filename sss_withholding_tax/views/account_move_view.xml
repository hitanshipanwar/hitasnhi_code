<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//page/field[@name='invoice_line_ids']/tree/field[@name='tax_ids']"
                position="after"
            >
                <field name="wt_tax_id" options="{'no_create': True}" optional="show" />
            </xpath>
            <xpath
                expr="//page/field[@name='invoice_line_ids']/form//field[@name='tax_ids']"
                position="after"
            >
                <field name="wt_tax_id" options="{'no_create': True}" optional="hide" />
            </xpath>
            <xpath
                expr="//page/field[@name='line_ids']/tree/field[@name='tax_ids']"
                position="after"
            >
                <field name="wt_tax_id" options="{'no_create': True}" optional="hide" />
            </xpath>
            <xpath
                expr="//page/field[@name='line_ids']/form//field[@name='tax_ids']"
                position="after"
            >
                <field name="wt_tax_id" options="{'no_create': True}" optional="hide" />
            </xpath>
           <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    class="oe_stat_button"
                    name="button_wt_certs"
                    string="WT Certs"
                    type="object"
                    groups="account.group_account_invoice"
                    icon="fa-bars"
                    attrs="{'invisible': [('cert_count', '=', 0)]}">
                    <field name="cert_count" widget="statinfo" string="WT Certs"/>
                </button>
                <field name="wt_cert_ids" invisible="1" />
                <field name="wt_cert_cancel" invisible="1" />
            </xpath>
            <!-- Add Button In One2many -->
            <xpath
                expr="//page/field[@name='invoice_line_ids']/tree/field[@name='price_subtotal']"
                position="after"
            >
                <button name="create_wt_certificate" string="Create WT Certificate" type="object" class="btn btn-primary" attrs="{'invisible': ['|',('parent.payment_state', '!=', 'paid'),
                    ('wt_tax_id', '=', False)]}"/>
            </xpath>

        </field>
    </record>
</odoo>