<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="paperformat_withholding_tax" model="report.paperformat">
        <field name="name">Withholding tax A4</field>
        <field name="default" eval="True" />
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">2</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">0</field>
        <field name="dpi">98</field>
    </record>
    <record id="withholding_tax_pdf_report" model="ir.actions.report">
        <field name="name">WT Certificates (pdf)</field>
        <field name="model">withholding.tax.cert</field>
        <field name="report_name">sss_withholding_tax.wt_cert_form</field>
        <field name="report_file">sss_withholding_tax.wt_cert_form</field>
        <field name="report_type">qweb-pdf</field>
        <!-- <field name="print_report_name">(object._get_report_base_filename())</field> -->
        <field
            name="paperformat_id"
            ref="sss_withholding_tax.paperformat_withholding_tax"
        />
        <field name="binding_model_id" ref="model_withholding_tax_cert" />
        <field name="binding_type">report</field>
    </record>
</odoo>
