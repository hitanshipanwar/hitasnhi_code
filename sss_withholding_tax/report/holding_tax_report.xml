                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <input type="checkbox" id="check12" name="check12" value="check12"/>
                                            <label for="check12">ออกภาษีให้ครั้งเดียว</label>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <input type="checkbox" id="check13" name="check13" value="check13"/>
                                            <label for="check13">อื่นๆ (ระบุ)</label>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                            <td style="width: 53%;">
                                <table>
                                    <tr>
                                        <td style="text-alidn: center;">ขอรับรองว่าข้อความและตัวเลขดังกล่าวข้างต้น
                                            ถูกต้องตรงกับความจริงทุกประการ
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            ลงชื่อ<hr style="border: none;
                                  border-top: 5px dotted #f00;
                                  color: #fff;
                                  background-color: #fff;
                                  height: 1px;
                                  width: 50%;"/>ผู้มีหน้าที่หักภาษี ณ ที่จ่าย
                                            <hr style="border: none;
                                  border-top: 5px dotted #f00;
                                  color: #fff;
                                  background-color: #fff;
                                  height: 1px;
                                  width: 50%;"/>วัน เดือน ปี ที่ออกหนังสือรับรองฯ
                                        </td>
                                    </tr>
                                </table>
                            </td>
                            <td style="width: 27%;">
                                <table>
                                    <tr>
                                        <td>stamp</td>
                                    </tr>
                                </table>
                            </td>
