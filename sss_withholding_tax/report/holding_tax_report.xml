                    </table>

                    <div class="row pt-2">
                        <div style="width: 50%;">
                            <b>คำเตือน</b>
                            <span style="margin: 30px;"></span>
                            ผู้มีหน้าที่ออกหนังสือรับรองการหักภาษี ณ. ที่จ่าย
                            ฝ่าฝืนไม่ปฏิบัติตามมาตรา 50 ทวิ แห่งประมวลรัษฎากร
                            ต้องรับโทษทางอาญา ตามมาตรา 35 แห่งประมวลรัษฎากร
                        </div>
                        <div style="width: 50%;">
                            <b>หมายเหตุ</b>
                            เลขประจำตัวผู้เสียภาษีอากร (13 หลัก)* หมายถึง
                            1.กรณีบุคคลธรรมดาไทย ให้ใช้เลขประจำตัวประชาชนของกรมการปกครอง
                            2.กรณีนิติบุคคล ให้ใช้เลขทะเบียนนิติบุคคลของกรมพัฒนาธุรกิจการค้า
                            3.กรณีอื่น ๆ นอกเหนือจาก 1.และ 2.ให้ใช้เลขประจำตัวผู้เสียภาษีอากร(13 หลัก)
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_holding_tax" model="ir.actions.report">
        <field name="name">Holding Tax</field>
        <field name="model">withholding.tax.cert</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sss_withholding_tax.report_holding_tax</field>
        <field name="report_file">sss_withholding_tax.report_holding_tax</field>
        <field name="binding_model_id" ref="sss_withholding_tax.model_withholding_tax_cert"/>
        <field name="paperformat_id" ref="paperformat_letter"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
