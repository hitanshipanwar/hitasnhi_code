                        </div>
                        <div style="width: 30%;">
                            <div class="row">
                                จำนวนเงิน<span style="margin: 40px;"></span> บาท
                            </div>
                        </div>
                    </div>

                    <table style="width: 100%;">
                        <tr>
                            <td style="width: 20%;">
                                <table>
                                    <tr>
                                        <td>
                                            ผู้จ่ายเงิน
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <input type="checkbox" id="check10" name="check10" value="check10"/>
