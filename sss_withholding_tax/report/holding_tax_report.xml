                                <div class="row">
                                    <span style="margin-left: 20px;">
                                        <b>Address</b>
                                    </span>
                                    <div style="margin-left: 25px; border-bottom: 3px dashed #f00;
                                        text-decoration: none;
                                        width: 800px;">
                                        <span style="color: blue;">
