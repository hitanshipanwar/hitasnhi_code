<odoo>
    <data>
        <!-- Wizard Form -->
        <record id="timesheet_report_wizard_form_view" model="ir.ui.view">
            <field name="name">timesheet_report_wizard_report_form_view</field>
            <field name="model">timesheet.report.wizard</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Timesheet Report">
                    <h3>Timesheet Report Print </h3>
                    <group>
                        <group>
                             <field name="start_date"  required="1"/>
                             <field name="type" widget="radio"/>
                        </group>
                        <group>
                            <field name="end_date" required="1"/>
                             <field name="employee_ids" attrs="{'invisible': [('type', '=', 'project')]}" widget="many2many_tags"/>
                             <field name="project_ids" attrs="{'invisible': [('type', '=', 'employee')]}" widget="many2many_tags"/>
                            <field name="file"  invisible="1"/>
                        </group>
                    </group>
                    <br/>
                    <footer>
                        <button name="print_xlsx_report" type="object" string="Print" class = "oe_highlight" />
                        <button string="Cancel" class="btn-primary" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>

        <!-- Action For Wizard -->
        <record id="timesheet_report_wizard_action" model="ir.actions.act_window">
            <field name="name">Timesheet Report</field>
            <field name="res_model">timesheet.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="timesheet_report_wizard_form_view"/>
            <field name="target">new</field>
        </record>

        <menuitem id="timesheet_report_menu"
                  name="Timesheet Report"
                  parent="hr_timesheet.menu_timesheets_reports"
                  sequence="0" action="timesheet_report_wizard_action"
                  groups="hr_timesheet.group_timesheet_manager"/>

    </data>
</odoo>