<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>
		<record id="hr_project_task_form_view" model="ir.ui.view">
            <field name="name">project.task.form.view</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="arch" type="xml">
                <xpath expr="//header/button[@name='action_assign_to_me']" position="after">
                    <button name="print_xlsx_report" string="Print Report" type="object" class="oe_highlight"/>
                </xpath>
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="planned_date"/>
                </xpath>
                <xpath expr="//field[@name='user_ids']" position="after">
                	<!-- <field name="estimated_time" attrs="{'readonly':[('is_user','=', True)]}"/> -->
                	<field name="is_user"  invisible="1"/>
                </xpath>
            </field>
        </record>
	</data>
</odoo>