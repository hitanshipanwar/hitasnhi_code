<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>
		<record id="hr_project_form_view" model="ir.ui.view">
            <field name="name">project.project.form.view</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.edit_project"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="print_xlsx_report" string="Project Progress Report" type="object" class="oe_highlight" groups="project.group_project_manager"/>
                </xpath>
                <xpath expr="//field[@name='user_id']" position="after">
                    <field name="email_send_to" widget="many2many_tags" groups="base.group_erp_manager"/>
                    <field name="timesheet_app_ids" widget="many2many_tags" groups="base.group_erp_manager"/>
                </xpath>
            </field>
        </record>

        <record id="inherited_hr_project_form_view_inherited" model="ir.ui.view">
            <field name="name">project.project.form.view</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="hr_timesheet.project_invoice_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='allocated_hours']" position="after">
                    <field name="progress" widget="progressbar"/>
                </xpath>
            </field>
        </record>
	</data>
</odoo>