<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="form_view_hr_leave_inherit_wfh" model="ir.ui.view">
        <field name="name">hr.leave.inherit</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
           <xpath expr="//group[@name='col_left']/field[@name='holiday_status_id']" position="after">
           		<field name="is_work_from_home_leave"/>
           </xpath>
        </field>
    </record>

    <record id="form_view_hr_leave_type_inherit_wfh" model="ir.ui.view">
        <field name="name">hr.leave.type.inherit</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
        <field name="arch" type="xml">
           <xpath expr="//group[@name='allocation_validation']/field[@name='requires_allocation']" position="after">
                <field name="is_work_from_home_leave_type" />
           </xpath>
        </field>
    </record>
</odoo>