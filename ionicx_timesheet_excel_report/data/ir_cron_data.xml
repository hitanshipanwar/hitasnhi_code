<?xml version="1.0" encoding="utf-8" ?>
<odoo>
	<data noupdate="1">

		<!-- CRON - Timesheet Reminder -->

		<record id="ir_cron_estimation_timesheet_daily" model="ir.cron">
			<field name="name">Estimated Timesheet Record: Daily Estimated Record</field>
			<field name="interval_number">1</field>
			<field name="interval_type">weeks</field>
			<field name="nextcall" eval="(DateTime.now().replace(hour=4, minute=30, second=0, microsecond=0) + timedelta(days=(0 - DateTime.now().weekday()) % 7)).strftime('%Y-%m-%d %H:%M:%S')"/>
			<field name="numbercall">-1</field>
			<field name="model_id" ref="project.model_project_project"/>
			<field name="state">code</field>
			<field name="code">model.check_project_timesheet()</field>
			<field name="active" eval="True"/>
		</record>

		<record id="ir_cron_exceeded_timesheet_allocated_hrs" model="ir.cron">
			<field name="name">Exceeded Timesheet Record</field>
			<field name="interval_number">1</field>
			<field name="interval_type">weeks</field>
			<field name="nextcall" eval="(DateTime.now().replace(hour=5, minute=30, second=0, microsecond=0) + timedelta(days=(0 - DateTime.now().weekday()) % 7)).strftime('%Y-%m-%d %H:%M:%S')"/>
			<field name="numbercall">-1</field>
			<field name="model_id" ref="project.model_project_project"/>
			<field name="state">code</field>
			<field name="code">model.check_project_and_task_hours()</field>
			<field name="active" eval="True"/>
		</record>

	</data>
</odoo>
