<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="paperformat_label_report" model="report.paperformat">
        <field name="name">Paperformat for Product Labels Report</field>
        <field name="default" eval="True"/>
        <field name="format">custom</field>
        <field name="page_height">42</field>
        <field name="page_width">73</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">2</field>
        <field name="margin_bottom">2</field>
        <field name="margin_left">2</field>
        <field name="margin_right">2</field>
        <field name="header_spacing">2</field>
        <field name="header_line" eval="False"/>
        <field name="dpi">90</field>
    </record>

    <report
        id="action_report_product_labels"
        model="stock.picking"
        string="Product Labels"
        report_type="qweb-pdf"
        name="product_labels.report_product_labels"
        file="product_labels.report_product_labels"
        paperformat="product_labels.paperformat_label_report"
    />

</odoo>
