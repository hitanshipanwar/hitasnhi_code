<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="supplier_review_page" name="Dashboard Project">
      <t t-call="website.layout">
        <form class="oe_solar_form" method="POST" action="/supplier/bid">
        <div class="oe_structure oe_empty" id="oe_structure_website_sale_products_1"/>
        <div id="wrap" class="oe_structure">
          <section id="review_page_main">
            <div class="container">
              <div class="row">
                <div class="col-sm-12" style="padding: 0;">
                  <div class="col-sm-4" style="padding: 0;">
                    <div class="review_project_heading">
                      <h3><t t-esc="record_id.customer_project_name"/></h3>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <section id="review_page_all_detail">
            <div class="secion_review">
              <div class="container secion_review">
                <div class="row">
                  <div class="col-sm-12">
                    <div class="project_all_view">
                      <!-- <div class="col-sm-3">
                        <div class="project_name_review">
                          <h5>Address</h5>
                          <span><t t-esc="record_id.street"/>  <t t-esc="record_id.house_number_or_name"/>,<br></br><t t-esc="record_id.city"/>  <t t-esc="record_id.state_id.name"/>,  <t t-esc="record_id.zip"/></span>
                        </div>
                      </div> -->
                      <div class="col-sm-3" t-if="record_id.solar_size">
                        <div class="project_size_solar_review">
                          <h5>Size of solar system</h5>
                          <span t-esc="dict(record_id.fields_get(allfields=['solar_size'])['solar_size']['selection'])[record_id.solar_size]"></span>
                        </div>
                      </div>
                      <div class="col-sm-3">
                        <div class="project_status_review">
                          <h5>Status</h5>
                          <span><t t-if="record_id.customer_project_state" t-esc="dict(record_id.fields_get(allfields=['customer_project_state'])['customer_project_state']['selection'])[record_id.customer_project_state]"/></span>
                        </div>
                      </div>
                      <div class="col-sm-3"></div>
                      <div class="col-sm-3">
                        <div class="project_bid_count_review">
                          <t t-set="total" t-value="0"/>
                            <t t-foreach="record_id.supplier_bids_ids" t-as="count"> 
                              <t t-set="total" t-value="total+1"/>
                            </t>
                          <span><t t-esc="total"/></span>
                          <h5>Bid Count</h5>
                        </div>
                      </div>
                    </div>
                  </div>

                  <div class="col-sm-12">
                    <div class="other_details_review">
                      <span>Other details</span>
                    </div>
                  </div>

                  <div class="col-sm-12">
                  <div class="project_all_view">
                    <div class="col-sm-4" t-if="record_id.property_option_new">
                      <div class="project_name_ques_review">
                        <h5>Do you own or rent your property?</h5>
                        <span t-esc="dict(record_id.fields_get(allfields=['property_option_new'])['property_option_new']['selection'])[record_id.property_option_new]"></span>
                      </div>
                    </div>

                    <div class="col-sm-4" t-if="record_id.upgrade_system">
                      <div class="project_name_ques_review">
                        <h5>Do you want to upgrade existing system?</h5>
                        <span t-esc="dict(record_id.fields_get(allfields=['upgrade_system'])['upgrade_system']['selection'])[record_id.upgrade_system]"></span>
                      </div>
                    </div>

                    <div class="col-sm-4" t-if="record_id.roof_type">
                      <div class="project_name_ques_review">
                        <h5>Type of roof</h5>
                        <span t-esc="dict(record_id.fields_get(allfields=['roof_type'])['roof_type']['selection'])[record_id.roof_type]"></span>
                      </div>
                      <div t-if="record_id.roof_text_box">
                        <h5>Specify Roof Type</h5>
                        <span t-esc="record_id.roof_text_box"></span>
                      </div>
                    </div>
                  </div>
                  </div>

                  <div class="col-sm-12">
                    <div class="project_all_view">
                      <div class="col-sm-4" t-if="record_id.shading_issue">
                        <div class="project_name_ques_review">
                          <h5>Do you have any shading issues?</h5>
                          <span t-esc="dict(record_id.fields_get(allfields=['shading_issue'])['shading_issue']['selection'])[record_id.shading_issue]"></span>
                          
                        </div>
                      </div>
                      
                      <div class="col-sm-4" t-if="record_id.property_select">
                        <div class="project_name_ques_review">
                          <h5>About your proposed installation property</h5>
                          <span t-esc="dict(record_id.fields_get(allfields=['property_select'])['property_select']['selection'])[record_id.property_select]"></span>
                        </div>
                      </div>

                      <div class="col-sm-4" t-if="record_id.pay_quarterly">
                        <div class="project_name_ques_review">
                          <h5>How much you pay quarterly for electricity?</h5>
                          <span t-esc="dict(record_id.fields_get(allfields=['pay_quarterly'])['pay_quarterly']['selection'])[record_id.pay_quarterly]"></span>
                        </div>
                      </div>
                    </div>
                  </div>

                  <div class="col-sm-12">
                    <div class="project_all_view">
                      <div class="col-sm-4" t-if="record_id.solar_system">
                        <div class="project_name_ques_review">
                          <h5>Do you already have a solar system?</h5>
                          <span t-esc="dict(record_id.fields_get(allfields=['solar_system'])['solar_system']['selection'])[record_id.solar_system]"></span>
                        </div>
                      </div>
                      <div class="col-sm-4" t-if="record_id.solar_type">
                        <div class="project_name_ques_review">
                          <h5>What type of solar panels are you looking for?</h5>
                          <span t-esc="dict(record_id.fields_get(allfields=['solar_type'])['solar_type']['selection'])[record_id.solar_type]"></span>

                          <t t-foreach="img_data" t-as="img">
                            <t t-if="img.ques_id == 'five' ">
                              <div class="solar_panels_img">
                                <t t-if="record_id.solar_type == img.solar_type">
                                  <t t-foreach="img.choose_img_id" t-as="rec">
                                    <div class="standard_quality_img type_solar_panels">
                                      <img t-attf-src="data:image/png;base64,#{rec.datas}"/>
                                    </div>
                                  </t>
                                </t>
                              </div>
                            </t>
                          </t>

                          <span t-if="record_id.type_box" t-esc="record_id.type_box"></span>
                        </div>
                      </div>
                      <div class="col-sm-4" t-if="record_id.solar_size">
                        <div class="project_name_ques_review">
                          <h5>What size solar system are you looking for?</h5>
                          <span t-esc="dict(record_id.fields_get(allfields=['solar_size'])['solar_size']['selection'])[record_id.solar_size]"></span>
                          <span t-if="record_id.specify_box" t-esc="record_id.specify_box"></span>
                        </div>
                      </div>
                  </div>
                </div>
                <!-- ++3 +++ -->
                <div class="col-sm-12">
                    <div class="project_all_view">
                      <div class="col-sm-4" t-if="record_id.remove_panels">
                        <div class="project_name_ques_review">
                          <h5>Do you want to Remove existing Panels?</h5>
                          <span t-esc="dict(record_id.fields_get(allfields=['remove_panels'])['remove_panels']['selection'])[record_id.remove_panels]"></span>
                        </div>
                      </div>
                      <div class="col-sm-4" t-if="record_id.inverter_type">
                        <div class="project_name_ques_review">
                          <h5>What type of inverter are you looking for?</h5>
                          <span t-esc="dict(record_id.fields_get(allfields=['inverter_type'])['inverter_type']['selection'])[record_id.inverter_type]"></span>

                          <t t-foreach="img_data" t-as="img">
                            <t t-if="img.ques_id == 'six' ">
                              <div class="solar_panels_img_top_inverter">
                                <t t-if="record_id.inverter_type == img.inverter_type">
                                  <t t-foreach="img.choose_img_id" t-as="rec">
                                    <div class="standard_quality_img type_solar_panels">
                                      <img t-attf-src="data:image/png;base64,#{rec.datas}"/>
                                    </div>
                                  </t>
                                </t>
                              </div>
                            </t>
                          </t>
                          
                          <span t-if="record_id.brand_box" t-esc="record_id.brand_box"></span>
                        </div>
                      </div>
                      <div class="col-sm-4" t-if="record_id.cash_fin">
                        <div class="project_name_ques_review">
                          <h5>Looking to buy cash or finance</h5>
                          <span t-esc="dict(record_id.fields_get(allfields=['cash_fin'])['cash_fin']['selection'])[record_id.cash_fin]"></span>
                        </div>
                      </div>
                  </div>
                </div>
                <!-- +++4+++ -->
                <div class="col-sm-12">
                    <div class="project_all_view">
                      <div class="col-sm-4" t-if="record_id.no_panels">
                        <div class="project_name_ques_review">
                          <h5>How many existing panels You want to remove?</h5>
                          <span t-esc="record_id.no_panels"></span>
                        </div>
                      </div>
                      <div class="col-sm-4" t-if="record_id.property_type">
                        <div class="project_name_ques_review">
                          <h5>Type of the property</h5>
                          <span t-esc="dict(record_id.fields_get(allfields=['property_type'])['property_type']['selection'])[record_id.property_type]"></span>
                        </div>
                      </div>
                      <div class="col-sm-4" t-if="record_id.comment_box">
                        <div class="project_name_ques_review">
                          <h5>Anything else would you like to tell us?</h5>
                          <span t-esc="record_id.comment_box"></span>
                        </div>
                      </div>
                  </div>
                </div>
                <!-- +++ 5 +++ -->
                <div class="col-sm-12">
                    <div class="project_all_view">
                      <div class="col-sm-4" t-if="record_id.add_panels">
                        <div class="project_name_ques_review">
                          <h5>Do you want to add more panels?</h5>
                          <span t-esc="dict(record_id.fields_get(allfields=['add_panels'])['add_panels']['selection'])[record_id.add_panels]"></span>
                        </div>
                      </div>

                      <div class="col-sm-4" t-if="record_id.story_no">
                        <div class="project_name_ques_review">
                          <h5>Number of story</h5>
                          <span t-esc="dict(record_id.fields_get(allfields=['story_no'])['story_no']['selection'])[record_id.story_no]"></span>
                        </div>
                      </div>

                      <div class="col-sm-4" t-if="record_id.add_battery">
                        <div class="project_name_ques_review">
                          <h5>Do you need to add battery storage?</h5>
                          <span t-esc="dict(record_id.fields_get(allfields=['add_battery'])['add_battery']['selection'])[record_id.add_battery]"></span>
                        </div>
                      </div>
                  </div>
                </div>

                <!-- +++ 6 +++ -->
                <div class="col-sm-12">
                  <div class="project_all_view">
                    <div class="col-sm-4" t-if="record_id.add_battery">
                        <div class="project_name_ques_review">
                          <h5 t-if="record_id.existing_solar">Size of the existing solar system</h5>
                          <span t-if="record_id.existing_solar" t-esc="record_id.existing_solar"></span>
                        </div>
                      </div>

                      <div class="col-sm-4" t-if="record_id.add_battery">
                        <div class="project_name_ques_review">
                          <h5 t-if="record_id.inverter_brand">Inverter Brand</h5>
                          <span t-if="record_id.inverter_brand" t-esc="record_id.inverter_brand"></span>
                        </div>
                      </div>

                      <div class="col-sm-4" t-if="record_id.add_battery">
                        <div class="project_name_ques_review">
                        <h5 t-if="record_id.inverter_phase">Inverter phase</h5>
                        <span t-if="record_id.inverter_phase" t-esc="record_id.inverter_phase"></span>
                        </div>
                      </div>
                  </div>
              </div>

              <!-- +++ 7 +++ -->
                <div class="col-sm-12">
                    <div class="project_all_view">
                      <div class="col-sm-4">
                        <div class="project_name_ques_review">
                          <h5 t-if="record_id.battery_backup">Need Battery Backup ?</h5>
                          <span t-if="record_id.battery_backup" t-esc="record_id.battery_backup"></span>
                        </div>
                      </div>

                      <div class="col-sm-4" t-if="record_id.add_battery">
                        <div class="project_name_ques_review">
                          <h5 t-if="record_id.inverter_capacity">Inverter capacity</h5>
                          <span t-if="record_id.inverter_capacity" t-esc="record_id.inverter_capacity"></span>
                        </div>
                      </div>

                      <div class="col-sm-4" t-if="record_id.add_battery">
                        <div class="project_name_ques_review">
                          <h5 t-if="record_id.storage_size">Specify the battery storage size?</h5>
                          <span t-if="record_id.storage_size" t-esc="record_id.storage_size"></span>
                        </div>
                      </div>
                  </div>
                </div>
              </div>
              <div class="row">
                <div class="col-sm-12" style="padding: 0;">
                  <div class="review_project_heading_border">
                  </div>
                </div>
              </div>

              <div class="row">
                <div class="col-sm-12" style="padding: 0;">
                  <div class="review_project_heading">
                    <h3>Project Images</h3>
                  </div>
                </div>
              </div>

              <div class="row">
                <div class="image_column" t-if="record_id.house">
                  <span>House</span>
                  <div class="house_img" t-if="record_id.house">
                    <img t-attf-src="data:image/png;base64,#{record_id.house}" class="house_images"></img>   
                  </div>
                </div>
                <div class="image_column" t-if="record_id.roof">
                  <span>Roof</span>
                  <div class="house_img" t-if="record_id.roof">
                    <img t-attf-src="data:image/png;base64,#{record_id.roof}" class="house_images"></img>   
                  </div>
                </div>
                <div class="image_column" t-if="record_id.inverter_wall">
                  <span>Inverter Wall</span>
                  <div class="house_img" t-if="record_id.inverter_wall">
                    <img t-attf-src="data:image/png;base64,#{record_id.inverter_wall}" class="house_images"></img>   
                  </div>
                </div>
                <div class="image_column" t-if="record_id.meter_box">
                  <span>MeterBox</span>
                  <div class="house_img" t-if="record_id.meter_box">
                    <img t-attf-src="data:image/png;base64,#{record_id.meter_box}" class="house_images"></img>   
                  </div>
                </div>
                <div class="image_column" t-if="record_id.meter_box_2">
                  <span>MeterBox-2</span>
                  <div class="house_img" t-if="record_id.meter_box_2">
                    <img t-attf-src="data:image/png;base64,#{record_id.meter_box_2}" class="house_images"></img>   
                  </div>
                </div>
                <div class="image_column" t-if="record_id.electricity_bill">
                  <span>Electricity bill</span>
                  <div class="house_img" t-if="record_id.electricity_bill">
                    <t t-set="extension" t-value="record_id.electricity_bill_name.rsplit('.', 1)[1]"/>
                    <div t-if="extension == 'pdf' or extension == 'docx'" class="o_portal_chatter_attachment mb-2 position-relative text-center">
                      <a t-attf-href="/web/content/solar.system/#{record_id.id}/electricity_bill?download=true&amp;" target="_blank">
                        <img src="/airbid_master/static/src/image/pdf_logo.png" class="house_images_customer"></img>  
                      </a>
                    </div>
                    <div t-else="">
                      <img t-attf-src="data:image/png;base64,#{record_id.electricity_bill}" class="house_images"></img>
                    </div>
                  </div>
                </div>
                <div class="image_column" t-if="record_id.other_img">
                  <!-- t-if="record_id.add_battery == 'no'" -->
                  <div class="house_img" t-if="record_id.add_battery != 'yes'">
                    <span>Roof Layout</span>
                    <img t-attf-src="data:image/png;base64,#{record_id.other_img}" class="house_images"></img>
                  </div>
                </div>
              </div>
            </div>
          </div>
          </section>

          <section id="supplier_review_view_button">
            <div class="container">
                <div class="row">
                    <div class="col-sm-12">
                      <div class="row">
                          <div class="col-sm-12">
                            <div class="supplier_review_sup_view_all">
                              <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                              <input type="hidden" name="record_id" t-att-value="record_id.id"/>

                              <input type="hidden" name="status" t-att-value="status"/>

                              <t t-set="flag" t-value="0"/>
                                <t t-foreach="record_id.supplier_bids_ids" t-as="bids">
                                  <t t-if="bids.supplier_id.id == request.env.user.partner_id.id">
                                    <t t-set="flag" t-value="1"/>
                                  </t>
                                </t>
                              <t t-if="record_id.customer_project_state == 'open'">
                                <!-- <t t-if="record_id.track_start_remaining"> -->
                                  <button type="submit" class="supplier_review_view_all" t-if="flag == 0" >Bid Now</button>
                                <!-- </t> -->
                              </t>
                              
                              <t t-if="flag == 1">
                                <a t-attf-href="#{'/supplier/edit/bid?bid_id=%s'%(record_id.id)}" type="submit" class="btn supplier_edit_view_all" t-if="record_id.supplier_project_state == 'inprogress'">Edit Bid</a>
                              </t>
                            </div>
                          </div>
                      </div>  
                  </div>
              </div>
          </div>
        </section>
        </div>
      </form>
      </t>
    </template>
</odoo>