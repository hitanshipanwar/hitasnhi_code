<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>
    <template id="supplier_edit_bid_detail" name="Supplier Bid Detail">
      <t t-call="website.layout">
        <form class="bid_form" method="post" action="/edit/bid" enctype="multipart/form-data">
        <div class="oe_structure oe_empty" id="oe_structure_website_sale_products_1"/>
        <div id="wrap" class="oe_structure">
          <section id="features">
            <div class="container" style="padding:0">
              <div class="row">
                <div class="col-sm-12">
                  <div class="col-sm-3">
                      <div class="supplier_choose_supplier_comm_img">
                        <span>
                          <t t-if="not bid_data">
                          <img t-attf-src="data:image/png;base64,#{record_id.other_img}" class="supplier_review_img_comm"/>
                          </t>

                          <t t-if="bid_data">
                          <img t-attf-src="data:image/png;base64,#{bid_data.solar_project_id.other_img}" class="supplier_review_img_comm"/>
                          </t>
                          
                        </span>
                      </div>
                    </div>
                </div>
              </div>
            </div>
          </section>

          <section class="make_your_bid_now_section">
            <div class="container">
                <div class="row">
                  <div class="col-md-12">
                    <div class="make_your_bid_now">
                      <span>Make your Bid Now</span>
                    </div>
                  </div>
                </div>
              </div>
          </section>

          <section id="suplllier_bid_section">
            <div class="content">
              <div class="container">
                <div class="row">
                  <div class="col-md-12">
                    <div class="form h-100">
                      <form class="mb-5" method="post" id="contactForm" name="contactForm">
                        <t t-if="bid_data.solar_project_id.upgrade_system == 'yes' or bid_data.solar_project_id.solar_system != 'yes'">
                          <div class="row">
                            <div class="col-sm-4">
                              <div class="supplier_choose_supplier_comm">
                                <label for="" class="col-form-label suppler_disp_name">Bid Description</label>

                                <t t-if="bid_data">
                                <textarea id="supplier_choose_supplier_comment" name="supplier_choose_supplier_comment" class="form-control suppler_disp_name_input" rows="5" cols="50" required="required" t-esc="bid_data.bid_desc"/>
                              </t>
                              </div>
                            </div>
                          </div>
                        </t>
                        <!-- <input type="text" class="form-control suppler_disp_name_input float_number_input_only" name="system" id="system_size_name" t-att-value="bid_data.solar_project_id.battery_backup"/> -->
                        <!-- </div> -->
                        <t t-if="bid_data.solar_project_id.upgrade_system == 'yes' or bid_data.solar_project_id.solar_system != 'yes'">
                            <div class="row">
                              <div class="col-md-4 form-group">
                                <label for="" class="col-form-label suppler_disp_name">System Size</label>
                                
                                <input type="text" class="form-control suppler_disp_name_input float_number_input_only" name="system" id="system_size_name" required="required"  t-if="bid_data" t-att-value="bid_data.system_size">
                                </input>
                                  <span class="kw">KW</span>
                              </div>
                              <div class="col-md-4 form-group">
                                <label for="" class="col-form-label suppler_disp_name">No of panels</label>

                                <input type="text" class="form-control suppler_disp_name_input
                                  number_input_only" name="no_panel" id="no_of_panels"   required="required" t-if="bid_data" t-att-value="bid_data.panels_no"/>
                              </div>
                              <div class="col-md-4 form-group">
                                <label for="" class="col-form-label suppler_disp_name">Panel Brand</label>

                                <input type="text" class="form-control suppler_disp_name_input
                                  text_input_only" name="brand_panel" id="panel_brand"   required="required" t-if="bid_data" t-att-value="bid_data.panels_brand"/>
                              </div>
                            </div>

                            <div class="row">
                              <div class="col-md-4 form-group">
                                <label for="" class="col-form-label suppler_disp_name">Panel power class</label>
                                
                                <input type="text" class="form-control suppler_disp_name_input float_number_input_only" name="power" id="panel_power_classs"  required="required" t-if="bid_data" t-att-value="bid_data.power_class"/>
                                <span class="kw">W</span>
                              </div>
                              <div class="col-md-4 form-group">
                                <label for="" class="col-form-label suppler_disp_name">Made in</label>

                                <input type="text" class="form-control suppler_disp_name_input text_input_only" name="country_panel" id="made_in"  required="required" t-if="bid_data" t-att-value="bid_data.made_country"/>
                              </div>
                              <div class="col-md-4 form-group">
                                <label for="" class="col-form-label suppler_disp_name">Type</label>

                                <input type="text" class="form-control suppler_disp_name_input text_input_only" name="type_panel" id="panel_type"  required="required" t-if="bid_data" t-att-value="bid_data.solar_type"/>
                              </div>
                            </div>

                            <div class="row">
                              <div class="col-md-4 form-group">
                                <label for="" class="col-form-label suppler_disp_name">Manufacturer’s  Warranty</label>
                                <input type="text" class="form-control suppler_disp_name_input number_input_only" name="manu_panel" id="manufacturer_warranty"  required="required" t-if="bid_data" t-att-value="bid_data.manu_year"/>
                                <span class="years">Years</span>
                              </div>
                              <div class="col-md-4 form-group">
                                <label for="" class="col-form-label suppler_disp_name">Performance Warranty</label>

                                <input type="text" class="form-control suppler_disp_name_input
                                  number_input_only" name="panel_per" id="performance_warranty"   required="required" t-if="bid_data" t-att-value="bid_data.per_year"/>
                                <span class="years">Years</span>
                              </div>
                            </div>

                            <div class="row">
                              <div class="col-md-12">
                                <div class="supplier_bid_border"/>
                              </div>
                            </div>

                            <div class="row">
                              <div class="col-md-4 form-group">
                                <label for="" class="col-form-label suppler_disp_name">Inverter Brand</label>

                                <input type="text" class="form-control suppler_disp_name_input text_input_only" name="brand_inverter" id="supllier_inverter_brand"  required="required" t-if="bid_data" t-att-value="bid_data.inverter_brand"/>
                              </div>
                              <div class="col-md-4 form-group">
                                <label for="" class="col-form-label suppler_disp_name">Inverter Size</label>

                                <input type="text" class="form-control suppler_disp_name_input float_number_input_only" name="size_int" id="supllier_inverter_size"   required="required" t-if="bid_data" t-att-value="bid_data.inverter_size"/>
                                  <span class="kw">KW</span>
                              </div>
                              <div class="col-md-4 form-group">
                                <label for="" class="col-form-label suppler_disp_name">Made in</label>

                                <input type="text" class="form-control suppler_disp_name_input text_input_only" name="country_inverter" id="made_in_sup"  required="required" t-if="bid_data" t-att-value="bid_data.manu_country"/>
                              </div>
                            </div>

                            <div class="row">
                              <div class="col-md-4 form-group">
                                <label for="" class="col-form-label suppler_disp_name">Manufacturer’s  Warranty</label>

                                <input type="text" class="form-control suppler_disp_name_input number_input_only" name="manu_inverter" id="manufacturer_warranty_sup" required="required" t-if="bid_data" t-att-value="bid_data.warranty"/>
                                <span class="years">Years</span>
                              </div>
                            </div>

                            <div class="row">
                              <div class="col-md-12">
                                <div class="supplier_bid_border"/>
                              </div>
                            </div>

                            <div class="row">
                              <div class="col-md-4 form-group">
                                <label for="" class="col-form-label suppler_disp_name">Workmanship warranty</label>

                                <input type="text" class="form-control suppler_disp_name_input number_input_only" name="inverter_per" id="workmanship_warranty" required="required" t-if="bid_data" t-att-value="bid_data.work_warranty"/>
                                <span class="years">Years</span>
                              </div>
                              

                            <t t-if="bid_data">
                              <div class="col-md-4 form-group"  t-if="bid_data.solar_project_id.cash_fin == 'cash'">
                                <label for="" class="col-form-label suppler_disp_name">Full Price after STC discount Incl.GST</label>
                                <input type="text" class="form-control suppler_disp_name_input number_input_only" name="price" id="full_price_stc_discount" t-att-value="bid_data.full_price"/>
                                <span class="currency_view">$</span>
                                <p class="price_includes_double_storey">This price includes Double storey, 3ph, meter upgrade etc.<br/>
                                Customer will pay you after installation.</p>
                              </div>
                            </t>
                            </div>


                          <t t-if="bid_data">
                            <div class="row" t-if="bid_data.solar_project_id.cash_fin == 'finance'">
                              <div class="col-md-4 form-group">
                                <span class="currency_view">$</span>
                                <label for="" class="col-form-label suppler_disp_name">Finance Price</label>
                                <input type="text" class="form-control suppler_disp_name_input" name="price_finance" id="price_finance" t-att-value="bid_data.final_price"/>
                                <span class="years">P/W</span>
                              </div>
                              <div class="col-md-1 form-group">
                                  <span class="for">for</span>
                                </div>
                              <div class="col-md-4 form-group">
                                 <label for="" class="col-form-label suppler_disp_name"></label>
                                <input type="text" class="form-control suppler_disp_name_input" name="months" id="months" t-att-value="bid_data.months"/>
                                <span class="years">Months</span>
                              </div>
                            </div>
                          </t>
                        </t>
                      

                      <!-- +++++++++++++++++++++++++++++++betri ++++++++++ -->
                      <t t-if="bid_data.solar_project_id.add_battery == 'yes' or bid_data.solar_project_id.battery_backup == 'yes'">
                      <!-- <t t-if="record_id.add_battery == 'yes' or record_id.battery_backup == 'yes'"> -->
                        <div class="row">
                          <div class="col-md-12">
                            <div class="battery"><lable id="how_it_work_attchment_photo_multi_lable">Battery Information</lable></div>
                          </div>
                        </div>

                        <div class="row">
                          <div class="col-md-4 form-group" t-if="bid_data.battery_size_kwh">
                            <label for="" class="col-form-label suppler_disp_name" >System Size</label>
                            <input type="text" class="form-control suppler_disp_name_input float_number_input_only" name="battery_system_size_name" id="battery_system_size_name" t-att-value="bid_data.battery_size_kwh">
                            </input>
                              <span class="kw">KW</span>
                          </div>
                        </div>

                        <!-- SEND FOR CORRECTION ++++++++++++== -->
                          

                          <!-- Sunen Start -->
                          <!-- <t t-set="count" t-value="1"/> -->
                          
                          <t t-set="count" t-value="1"/>
                          <t t-if="bid_data.battery_doc_attachment_ids">
                            <t t-foreach="bid_data.battery_doc_attachment_ids" t-as="lg">
                                <!-- <t t-set="battery_information_count" value="battery_information_count++" /> -->
                            <div id="battery_information_hide_show" class='battery_information_hide_show'>
                            <div class="row">
                              <div class="col-md-4 form-group">
                                <label for="" class="col-form-label suppler_disp_name" id="battery_information_brand_lable">product Brand</label>
                                <input type="text" class="form-control suppler_disp_name_input text_input_only" 
                                   t-attf-id="battery_information_brand{{count}}" t-attf-name="battery_information_brand{{count}}" t-att-value="lg.battery_product_Brand" />
                              </div>
                              <div class="col-md-4 form-group">
                                <label for="" class="col-form-label suppler_disp_name" id="battery_information_model_lable">product model no</label>
                                <input type="text" class="form-control suppler_disp_name_input float_number_input_only" 
                                  t-attf-id="battery_information_model{{count}}" t-attf-name="battery_information_model{{count}}" t-att-value="lg.battery_product_model_no" />
                                  <!-- <span class="kw" id="battery_information_model_kw">KW</span> -->
                              </div>

                              <div class="col-md-4 form-group">
                                <label for="" class="col-form-label suppler_disp_name" id="battery_information_made_in_lable">Made in</label>
                                <input type="text" class="form-control suppler_disp_name_input text_input_only"
                                t-attf-id="battery_information_made_in{{count}}" t-attf-name="battery_information_made_in{{count}}" t-att-value="lg.battery_made_in"/>
                              </div>
                            </div>

                            <div class="row">
                              <div class="col-md-4 form-group">
                                <label for="" class="col-form-label suppler_disp_name" id="battery_information_product_warranty_lable">product warranty</label>
                                <input type="text" class="form-control suppler_disp_name_input float_number_input_only"  t-attf-id="battery_information_product_warranty{{count}}" t-attf-name="battery_information_product_warranty{{count}}" t-att-value="lg.battery_product_warranty"/>
                              </div>
                               <div class="col-md-4 form-group">
                                  <label for="" class="col-form-label suppler_disp_name" id="battery_information_product_datasheet_lable">upload datasheet</label>
                                  <input type="file" accept=".jpg,.png,.jpeg" t-attf-id="battery_information_product_datasheet_img{{count}}" t-attf-name="battery_information_product_datasheet_img{{count}}" t-att-value="lg.battery_attch_img"/>
                                  <t t-if="lg.battery_attch_img">
                                    <img t-attf-src="data:image/png;base64,#{lg.battery_attch_img}" t-attf-name="battery_edit_att{{count}}" style="height: 100px;width:100px;margin: 10px 10px 10px 10px" t-attf-id="battery_edit_att{{count}}" t-att-value="lg.battery_attch_img"/>
                                    <textarea t-attf-name="battery_information_product_datasheet_file#{count}" t-attf-id='battery_information_product_datasheet_file#{count}' hidden="hidden"><t t-esc="lg.battery_attch_img" hidden="hidden" class="binary_attchment_hide"/></textarea>
                                  </t>
                                  <button type="button" t-attf-id="btn_example_file_reset{{count}}" class='del_clear_file_view'><img src='/airbid_master/static/src/image/delete.png' class='clear_data' id='clear_data'></img></button>
                              </div>
                              <div id="field_2" class="column col-sm-3"><img src="/airbid_master/static/src/image/delete.png" class="delete_icon_pro" id="delete_icon_pro" t-attf-name="delete_icon{{count}}" t-att-data-line-id="lg.id" data-toggle="tooltip" data-original-title="Delete"></img></div>
                            </div>
                          </div>
                           <input type="checkbox" id="is_saved{{count}}" t-attf-name="is_saved{{count}}" checked='checked' hidden="hidden"/>

                         <t t-set="count" t-value="count+1" hidden="hidden"/>
                          </t>
                        </t>
                         <input type="number" t-attf-value="{{count-1}}" name="battery_information_count" id="battery_information_count" hidden="hidden"/>
                          <!-- Sunen End -->

                        <button type="button" id="battery_information_add" class="battery_information_add btn btn-primary">Add Product</button>


                        <div class="row">
                          <div class="col-md-12">
                            <div class="battery_info_hed"><lable id="how_it_work_attchment_photo_multi_lable">Inverter Information</lable></div>
                          </div>
                        </div>

                        <div class="row">
                          <div class="col-md-4 form-group">
                            <label for="" class="col-form-label suppler_disp_name">Inverter</label>
                              <select name="pets" id="battary_select">
                                  <option value="inbuilt_in_box">Inbuilt in box</option>
                                  <option value="supplied_sepretly">Supplied sepretly</option>
                              </select>
                          </div>
                        </div>

                        

                        <!-- +++++++++++++ Inbuilt in box ++++++++++++++++++++++ -->
                        <div class="row" id="inbuilt_in_box_hide">
                          <div class="col-md-12">
                            <div class="battery_info_hed"><lable id="how_it_work_attchment_photo_multi_lable">Inbuilt in box</lable></div>
                          </div>
                        </div>

                        <div class="inbuilt_in_box_set">
                          <div class="row">
                              <div class="col-md-4 form-group">
                                <label for="" class="col-form-label suppler_disp_name" id="inbuilt_made_in_brand">product Brand</label>
                                <input type="text" class="form-control suppler_disp_name_input text_input_only" name="inbuilt_product_brand" id="inbuilt_product_brand" t-att-value="bid_data.inbuilt_product_Brand"/>
                              </div>
                              <div class="col-md-4 form-group">
                                <label for="" class="col-form-label suppler_disp_name" id="inbuilt_made_in_model_mo">product model no</label>
                                <input type="text" class="form-control suppler_disp_name_input float_number_input_only" name="inbuilt_product_model_no" id="inbuilt_product_model_no" t-att-value="bid_data.inbuilt_product_model_no"/>
                                  <!-- <span class="kw" id="inbuilt_made_in_model_mo_kw">KW</span> -->
                              </div>
                              <div class="col-md-4 form-group">
                                <label for="" class="col-form-label suppler_disp_name" id="inbuilt_made_in_lable">Made in</label>
                                <input type="text" class="form-control suppler_disp_name_input text_input_only" name="inbuilt_made_in" id="inbuilt_made_in" t-att-value="bid_data.inbuilt_made_in"/>
                              </div>
                            </div>

                            <div class="row">
                              <div class="col-md-4 form-group">
                                <label for="" class="col-form-label suppler_disp_name" id="inbuilt_product_warranty_lable">product warranty </label>
                                <input type="text" class="form-control suppler_disp_name_input float_number_input_only" name="inbuilt_product_warranty" id="inbuilt_product_warranty" t-att-value="bid_data.inbuilt_product_warranty"/>

                                <!-- <input type="text" class="form-control suppler_disp_name_input text_input_only" name="brand_inverter" id="supllier_inverter_brand"  t-if="bid_data" t-att-value="bid_data.inverter_brand"/> -->
                              </div>
                              <div class="col-md-6 form-group" id="Inbuilt_in_box_hide">
                                <label for="" class="col-form-label suppler_disp_name" id="inbuilt_attchment_photo_multi_lable">upload datasheet</label>
                                <input type="file" accept=".jpg,.png,.jpeg" name="inbuilt_attchment_photo_multi" id="inbuilt_attchment_photo_multi" multiple="multiple"/>
                                <!-- <img src="/airbid_master/static/src/image/delete.png" class="delete_icon_pro" id="del_inbuilt_img" name="del_inbuilt_img"></img> -->
                                <!-- bid_data.inbuilt_doc_attachment_ids -->
                                <!-- nnn -->
                                <t t-set="count_inb" t-value="0"/>
                                <t t-foreach="bid_data.inbuilt_doc_attachment_ids" t-as="inb_doc">
                                    <t t-set="count_inb" t-value="count_inb+1"/>
                                    <img t-attf-src="data:image/png;base64,#{inb_doc.datas}" t-attf-name="inb_doc_att_img{{count_inb}}" style="margin: 10px 10px 10px 10px" t-attf-id="inb_doc_att_img{{count_inb}}" t-att-value="inb_doc.datas" class="inb_doc_att_img"/>
                                    <span>
                                      <input type='text' t-attf-name='inb_line_id{{count_inb}}' t-attf-id='inb_line_id{{count_inb}}' t-attf-value='{{inb_doc.id}}' hidden="hidden"/>
                                      <img src="/airbid_master/static/src/image/delete.png" class="delete_icon_pro" t-attf-id="del_inb_img{{count_inb}}"></img>
                                    </span>
                                </t>
                                <input type='text' id='inb_removed_list' t-attf-name='inb_removed_list' hidden="hidden"/>
                                <input type='text' id='inb_count' t-attf-name='inb_count{{count_inb}}' t-attf-value='{{count_inb}}' hidden="hidden"/>
                                <!-- nnn -->

                              </div>
                            </div>
                          </div>
                        <!-- +++++++++++++ Inbuilt in box END ++++++++++++++++++++++ -->

                        <!-- +++++++++++++ Supplied sepretly ++++++++++++++++++++++ -->
                        <div class="row" id="supplied_sepretly_hide">
                          <div class="col-md-12">
                            <div class="battery_info_hed"><lable id="how_it_work_attchment_photo_multi_lable">Supplied sepretly</lable></div>
                          </div>
                        </div>

                        <div class="row">
                          <div class="col-md-4 form-group">
                            <label for="" class="col-form-label suppler_disp_name" id="supplied_sepretly_brand_lable">Inverter brand</label>
                            <input type="text" class="form-control suppler_disp_name_input text_input_only" name="supplied_sepretly_brand" id="supplied_sepretly_brand" t-att-value="bid_data.supplied_product_Brand"/>
                          </div>
                          <div class="col-md-4 form-group">
                            <label for="" class="col-form-label suppler_disp_name" id="supplied_sepretly_size_lable">Inverter size</label>
                            <input type="text" class="form-control suppler_disp_name_input float_number_input_only" name="supplied_sepretly_size" id="supplied_sepretly_size" t-att-value="bid_data.supplied_product_model_no"/>
                              <!-- <span class="kw" id="supplied_sepretly_size_lable_kw">KW</span> -->
                          </div>
                          <div class="col-md-4 form-group">
                            <label for="" class="col-form-label suppler_disp_name" id="supplied_sepretly_made_lable">Made in</label>
                            <input type="text" class="form-control suppler_disp_name_input text_input_only" name="supplied_sepretly_made_in" id="supplied_sepretly_made_in" t-att-value="bid_data.supplied_product_warranty"/>
                          </div>
                        </div>

                        <div class="row">
                          <div class="col-md-4 form-group">
                            <label for="" class="col-form-label suppler_disp_name" id="supplied_sepretly_inverter_warranty_lable">Inverter warranty</label>
                            <input type="text" class="form-control suppler_disp_name_input float_number_input_only" name="supplied_sepretly_inverter_warranty" id="supplied_sepretly_inverter_warranty" t-att-value="bid_data.supplied_product_warranty"/>
                          </div>
                          <div class="col-md-6 form-group" id="supplied_sepretly_select_hide">
                            <label for="" class="col-form-label suppler_disp_name" id="supplied_sepretly_attchment_photo_multi_lable">upload datasheet</label>
                            <input type="file" accept=".jpg,.png,.jpeg" name="supplied_sepretly_attchment_photo_multi" id="supplied_sepretly_attchment_photo_multi" multiple="multiple" />
                            <!-- <img src="/airbid_master/static/src/image/delete.png" class="delete_icon_pro" id="del_sup_inv_img" name="del_sup_inv_img"></img> -->
                            <!-- JJJ -->
                            <t t-set="count_inv" t-value="0"/>
                            <t t-foreach="bid_data.supplied_doc_attachment_ids" t-as="sup_inv_doc">
