                <!-- battary MULTIPLE +++++++==-->

                <table style="border-collapse: collapse; width: 100%;" border="1">
                <tbody>
                <tr>
                <td style="width: 20%;" id="panel_details">product Brand</td>
                <td style="width: 20%;" id="panel_details">product model no</td>
                <td style="width: 20%;" id="panel_details">product warranty</td>
                <td style="width: 20%;" id="panel_details">Made in</td>
                <td style="width: 20%;" id="panel_details">upload datasheet</td>
                </tr>
                <t t-set='c' t-value='0'/>
                <t t-foreach="data.get('attached_files')" t-as="img">
                  <t t-set='c' t-value='c+1'/>
                  <tr>
                    <td style="width: 20%;text-align: center;">
                      <t t-esc="img.get('battery_name')"/>
                      <input type="text" t-attf-name="battery_name_#{c}" t-attf-id='battery_name#{c}' t-attf-value="#{img.get('battery_name')}" hidden="hidden"></input>
                    </td>
                    <td style="width: 20%;text-align: center;">
                      <t t-esc="img.get('battery_model')"/>
                      <input type="text" t-attf-name="battery_model_#{c}" t-attf-id='battery_model#{c}' t-attf-value="#{img.get('battery_model')}" hidden="hidden"></input>
                    </td>
                    <td style="width: 20%;text-align: center;">
                      <t t-esc="img.get('battery_made_in')"/>
                      <input type="text" t-attf-name="battery_made_in_#{c}" t-attf-id='battery_made_in#{c}' t-attf-value="#{img.get('battery_made_in')}" hidden="hidden"></input>
                    </td>
                    <td style="width: 20%;text-align: center;">
                      <t t-esc="img.get('battery_warranty')"/>
                      <input type="text" t-attf-name="battery_warranty_#{c}" t-attf-id='battery_warranty#{c}' t-attf-value="#{img.get('battery_warranty')}" hidden="hidden"></input>
                    </td>
                    <td style="width: 20%;text-align: center;">
                      <img t-attf-src="data:image/png;base64,#{img.get('datas')}" name="attached_files_img_bianry" style="height: 100px;width:100px;margin: 10px 10px 10px 10px" id="electricity_img" t-att-value="img.get('datas')"/>
                      <div style="display:none;">
                        <textarea t-attf-name="file_#{c}" t-attf-id='file_#{c}'><t t-esc="img.get('datas')" style="display:none !important;" hidden="hidden" class="binary_attchment_hide"/></textarea>

                        <input type="hidden" t-attf-name="file_name_#{c}" t-attf-id='file_name_#{c}' t-attf-value="#{img.get('name')}"/>
                      </div>
                    </td>
                  </tr>
                </t>
                <input type="hidden" name="count" t-attf-value="#{c}"/>
