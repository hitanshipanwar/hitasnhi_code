																<t t-foreach="rec.supplier_bids_ids" t-as="count"> 
																	<t t-set="total" t-value="total+1"/>
																</t>
																<span><t t-esc="total"/></span>
																<h5>Bid Count</h5>
															</div>
														</div>
													</div>

													<div class="row">
														<div class="col-sm-12">
															<div class="project_bor_ca_mobile">
																	<input type="submit" class="btn project_bor_ca_mobile_btn" id="view_detail_res" value="View Project Detail"></input>
																	<input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
																	<input type="hidden" name="record_id" t-att-value="rec.id"/>
															</div>
														</div>
													</div>
													
												</div>
											</form>
									</t>
								</t>

								</div>
								<div class="col-sm-4">
									<div class="project_des" t-if="data.supplier_bids_ids">
										<h3>Recent Bids</h3>
									</div>


									<div class="pro_main_bids" t-if="data.supplier_bids_ids">
										<div class="project_recent_bids">
											<t t-set="index" t-value="0"/>
											<t t-foreach="data" t-as="rec">
											<t t-foreach="rec.supplier_bids_ids" t-as="supplier">
												<div class="row" id="supplier_project_name_recent_bid">
												<div class="col-sm-12">
													<div class="project_name_recent_bid">
														<span><t t-esc="rec.customer_project_name"/></span>
													</div>
													<div class="project_name_recent_bid_detail">
															<t t-if="supplier.supplier_id.image_1920">
															<img t-attf-src="data:image/png;base64,#{supplier.supplier_id.image_1920}" class="supplier_img"/>
														</t>
															<t t-else="">
																<img src="/airbid_master/static/src/image/profile.png" class="supplier_img" loading="lazy"/>
															</t>

														<t t-if="rec.project_create_date" t-set="remaining_date" t-value="(rec.project_create_date +relativedelta(days =+ 3)) - datetime.date.today()"/>
														<t t-set="index" t-value="index+1"/>
														<t t-if="remaining_date.days &gt; 0">
															<span class="supplier_name">Supplier <t t-esc="index"/>
															<br/><img src="/airbid_master/static/src/image/Star1.png"/></span>
														</t>

														<t t-if="remaining_date.days &lt;= 0">
															<span class="supplier_name">
															<t t-esc="supplier.supplier_id.name"/>
															<br/><img src="/airbid_master/static/src/image/Star1.png"/></span>
														</t>

														<p class="supplier_ammount" t-if="supplier.full_price">$<t t-esc="supplier.full_price"/><br/><span>Bid Amount</span></p>
														<p class="supplier_ammount" t-if="supplier.final_price">$<t t-esc="supplier.final_price"/> p/w for <t t-esc="supplier.months"/> Months<br/><span>Bid Amount</span></p>
													</div>
													<div class="supp_bids_line"></div>
												</div>
											</div>
										</t>
									</t>
										</div>
										<div class="view_all_supplier" id="view_all_supplier">
											<a href="#" class="view_sup_line" id="view_sup_line">View All</a>
										</div>

										<div class="view_all_supplier" id="view_less_supplier">
											<a href="#" class="view_sup_line" id="view_sup_line">View Less</a>
										</div>
									</div>
								</div>
							</div>
						</div>
					</section>

				</div>
			</t>
		</template>

</odoo>