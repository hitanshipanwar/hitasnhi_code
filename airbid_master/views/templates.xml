	<!-- project data submit...................... -->
	<template id="submit_project_form" name="Project">
		<t t-call="web.login_layout">
			<form class="project_form" method="post">
				<div class="submit_details">
					<h1 id="submit_details">Thank You</h1>
					<h3 id="submit_details">Your project is submitted.</h3>
					<p id="submit_details">Your Refrence Number is <t t-esc="ref_no"/></p>
				</div>
			</form>
		</t>
	</template> 

	<!-- bid data submit......................... -->
	<template id="submit_bid_form" name="Bid">
		<t t-call="web.login_layout">
			<form class="bid_form" method="post">
				<div class="submit_bid_details">
					<h1 id="submit_details">Thank You</h1>
					<h3 id="submit_details">Your Bid is submitted.</h3>
					<p id="submit_details">Your Refrence Number is <t t-esc="ref_sup_no"/></p>
				</div>
			</form>
		</t>
	</template> 
</odoo>
