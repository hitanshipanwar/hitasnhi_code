                    <tr><td>
                      <span class="compair_all_detail_customer">System Size</span>
                    </td></tr>
                    <tr><td>
                      <span class="compair_all_detail_customer no_of_panels">No of panels</span>
                    </td></tr>
                    <tr><td>
                      <span class="compair_all_detail_customer">Panel Brand</span>
                    </td></tr>
                    <tr><td>
                      <span class="compair_all_detail_customer">made in</span>
                    </td></tr>
                    <tr><td>
                      <span class="compair_all_detail_customer">Type</span>
                    </td></tr>
                    <tr><td>
                      <span class="compair_all_detail_customer">Manufacturer's Warranty</span>
                    </td></tr>
                    <tr><td>
                      <span class="compair_all_detail_customer no_of_panels">Performance Warranty</span>
                    </td></tr>
                    <tr><td>
                      <span class="compair_all_detail_customer">Inverter Brand</span>
                    </td></tr>
                    <tr><td>
                      <span class="compair_all_detail_customer">Inverter size</span>
                    </td></tr>
                    <tr><td>
                      <span class="compair_all_detail_customer">made in</span>
                    </td></tr>
                    <tr><td>
                      <span class="compair_all_detail_customer no_of_panels">Manufacturer's Warranty</span>
