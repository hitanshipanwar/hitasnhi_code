                      <tr t-if="bid.solar_project_id.cash_fin == 'cash'">
                        <td class="compair_price_list">
                          <span class="no_of_panels">
                            $ <t t-esc="bid.full_price"/>
                          </span>
                        </td>
                      </tr>
                      <tr t-if="bid.solar_project_id.cash_fin == 'finance'">
                        <td class="compair_price_list">
                          <span class="no_of_panels">
                            <t t-esc="bid.final_price"/> for p/w 
                            <t t-esc="bid.months"/> Months
                          </span>
