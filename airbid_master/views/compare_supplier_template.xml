                      <span class="compair_all_detail_customer no_of_panels">Finance Price</span>
                    </td></tr>

                    <tr><td>
                      <span class="compair_all_detail_customer">Battery Size (kwh)</span>
                    </td></tr>
                    <t t-foreach="data" t-as="bid">
                      <td>
                        <span class="compair_all_detail_customer">Battery Product Brand </span>
                      </td>
                      <tr t-foreach="bid.battery_doc_attachment_ids" t-as="bat">
                        <td>
                          <!-- <span class="compair_all_detail_customer">Battery Product Brand </span> -->
                        </td>
                      </tr>
                      
                      <td>
                         <span class="compair_all_detail_customer">Battery Product Model No</span>
                      </td>
                      <tr t-foreach="bid.battery_doc_attachment_ids" t-as="bat">
                        <td>
                        </td>
                      </tr>

                      <td>
                         <span class="compair_all_detail_customer">Battery Product Warranty</span>
                      </td>
                      <tr t-foreach="bid.battery_doc_attachment_ids" t-as="bat"><td>
                        <span class="compair_all_detail_customer"></span>
                      </td></tr>

                      <td>
                         <span class="compair_all_detail_customer">Battery Made in</span>
                      </td>
                      <tr t-foreach="bid.battery_doc_attachment_ids" t-as="bat"><td>
                        <span class="compair_all_detail_customer"></span>
                      </td></tr>

                      <tr><td>
                        <span class="compair_all_detail_customer">Inventor Option</span>
                      </td></tr>

                      <!-- INVENTOR ============= -->
                      <td t-if="bid.inverter_doc_attachment_ids">
                        <span class="compair_all_detail_customer">Inverter Product Brand </span>
                      </td>
                      <tr t-if="bid.inverter_doc_attachment_ids" t-foreach="bid.inverter_doc_attachment_ids" t-as="bat">
                        <td>
                          <span class="compair_all_detail_customer"></span>
                        </td>
                      </tr>
                      
                      <td t-if="bid.inverter_doc_attachment_ids">
                         <span class="compair_all_detail_customer">Inverter Product Model No</span>
                      </td>
                      <tr t-if="bid.inverter_doc_attachment_ids" t-foreach="bid.inverter_doc_attachment_ids" t-as="bat">
                        <td ><span class="compair_all_detail_customer"></span>
                        </td>
                      </tr>

                      <td t-if="bid.inverter_doc_attachment_ids">
                         <span class="compair_all_detail_customer">Inverter Product Warranty</span>
                      </td>
                      <tr t-if="bid.inverter_doc_attachment_ids" t-foreach="bid.inverter_doc_attachment_ids" t-as="bat">
