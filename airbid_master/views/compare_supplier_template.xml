                                <button type="submit" class="choose_supplier_compair" disabled="disabled">Choose Supplier</button>  
                              </i>
                            </t>  

                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                            <input type="hidden" name="project_img" id="project_id" t-att-value="bid.id"/>

                            <input type="hidden" name="record_id" t-att-value="bid.id"/>
                          </form>
