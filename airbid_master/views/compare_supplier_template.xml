                      </tr>

                      <tr t-if="bid.inverter_doc_attachment_ids"><td class="compair_price_list" style="font-weight:700;">WARRANTY NO</td></tr>
                      <tr t-if="bid.inverter_doc_attachment_ids" t-foreach="bid.inverter_doc_attachment_ids" t-as="inv">
                        <td class="compair_price_list">
                          <t t-esc="inv.inverter_product_warranty"/>
                        </td>
                      </tr>

                      <tr t-if="bid.inverter_doc_attachment_ids"><td class="compair_price_list" style="font-weight:700;">BATTERY MADE IN</td></tr>
                      <tr t-if="bid.inverter_doc_attachment_ids" t-foreach="bid.inverter_doc_attachment_ids" t-as="inv">
