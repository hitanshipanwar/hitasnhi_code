                </div>
                  
                  <t t-foreach="data" t-as="bid">
                 <div id="supplier_bid_data" t-att-value="bid.id">
                    <table>
                      <tr>
                        <td style="width:23%;border-left: 1px solid #D8DADD !important;border-top: 1px solid #D8DADD !important;border-right: 1px solid #D8DADD !important;background: #fff;text-align: center;" scope="col" abbr="Starter">
                          <span class="compair_show_more show_less" style="display:none">show less <img src="/airbid_master/static/src/image/vector_less.png"/></span>
                          <br/>
                            <form class="oe_solar_form" method="POST" action="/supplier/details">
                                <button type="submit" class="choose_supplier_compair" t-if="bid.solar_project_id.is_finsh_time">Choose Supplier</button>

                                <t t-if="not bid.solar_project_id.is_finsh_time" data-toggle="tooltip" title="Button Enable After Project Time finish">
                                  <i data-toggle="tooltip" title="Button Enable After Project Time finish">
                                    <button type="submit" class="choose_supplier_compair" disabled="disabled">Choose Supplier</button>
                                  </i>
                                </t>

                                <script>
                                  $(document).ready(function(){
                                    $('[data-toggle="tooltip"]').tooltip();   
                                  });
                                  </script>

                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="project_img" id="project_id" t-att-value="bid.id"/>
                                <input type="hidden" name="record_id" t-att-value="bid.id"/>
                            </form>

                            <h4 class="compair_name"><t t-esc="bid.supplier_id.company_name"/></h4>

                            <a href="#" class="compair_website_name"><t t-esc="bid.supplier_id.website"/></a><br/>

                            <img t-attf-src="data:image/png;base64,#{bid.supplier_id.company_logo}" style="margin: 20px 0 0px 0px;height: 42px;"/>

                            <div class="show_less_more">
                              <span>Since <t t-esc="bid.supplier_id.year"/></span><br></br>
                              <span><t t-esc="bid.supplier_id.residential + bid.supplier_id.commercial"/> Total Installation</span><br></br>
                              <span>Cerfiticates</span><br></br>
                              
                              <img class="supplier_cer myBtn" t-attf-src="data:image/png;base64,#{bid.supplier_id.retailer}" />
                              <img class="supplier_cer myBtn" t-attf-src="data:image/png;base64,#{bid.supplier_id.member}" /><br></br>
                              <img class="supplier_cer myBtn" t-attf-src="data:image/png;base64,#{bid.supplier_id.iso}" />
                              <img class="supplier_cer myBtn" t-attf-src="data:image/png;base64,#{bid.supplier_id.document} "/><br></br>

                            </div>

                            <div id="myModal" class="modal" style="display: none;">
                              <div class="modal-content text-center questation_popup image_popup">
                                <div id="navbar">
                                  <i class="fa fa-plus" style="font-size:35px;color:#F16363;padding: 0px 20px;" onclick="zoomin()"></i>
                                  <i class="fa fa-minus" style="font-size:35px;color:#F16363;padding: 0px 20px;" onclick="zoomout()"></i>
                                </div>
                              <span class="close"><i id="cross_icon" class="fa fa-close"/></span>
                              <div class="text-center main" style="width:100%;height:100%;overflow:auto;">
                                <img src="" class="section" id="image_preview"/>
                              </div>
                              </div>
                            </div>
                        </td>
                      </tr>

                      <tr>
                        <td class="compair_price_list">
