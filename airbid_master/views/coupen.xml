<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="sale_coupon_program_view_coupon_program_form" model="ir.ui.view">
        <field name="name">coupon.program.form</field>
        <field name="model">coupon.program</field>
        <field name="inherit_id" ref="coupon.coupon_program_view_coupon_program_form"/>
        <field name="arch" type="xml">
        	<!-- <field name='rule_min_quantity' position='after'> -->
        	<xpath expr="//label[@for='rule_minimum_amount']" position="before">
        		<label for="is_bid_coupon" string="Is BID Coupon?"/>
        		<div>
        		 	<field name='is_bid_coupon' class="oe_inline"/>
        		</div>
        	</xpath>
            <field name='discount_line_product_id' position='after'>
                <field name='bid_product_id'/>
            </field>
        </field>
    </record>
</odoo>
