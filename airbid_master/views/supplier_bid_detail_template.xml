<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>
    <template id="supplier_bid_detail" name="Supplier Bid Detail">
      <t t-call="website.layout">
        <form class="bid_form" method="post" action="/supplier/bid/review" enctype="multipart/form-data">
        <div class="oe_structure oe_empty" id="oe_structure_website_sale_products_1"/>
        <div id="wrap" class="oe_structure">
          <section id="features">
            <div class="container" style="padding:0">
              <div class="row">
                <div class="col-sm-12">
                  <div class="col-sm-3">
                      <div class="supplier_choose_supplier_comm_img">
                        <span>
                          <t t-if="not bid_data">
                            <img t-attf-src="data:image/png;base64,#{record_id.other_img}" class="supplier_review_img_comm"/>
                          </t>

                          <t t-if="bid_data">
                            <img t-attf-src="data:image/png;base64,#{bid_data.solar_project_id.other_img}" class="supplier_review_img_comm"/>
                          </t>
                          
                        </span>
                      </div>
                    </div>
                </div>
              </div>
            </div>
          </section>

          <section class="make_your_bid_now_section">
            <div class="container">
                <div class="row">
                  <div class="col-md-12">
                    <div class="make_your_bid_now">
                      <span>Make your Bid Now</span>
                    </div>
                  </div>
                </div>
              </div>
          </section>

          <section id="suplllier_bid_section">
            <div class="content">
              <div class="container">
                <div class="row">
                  <div class="col-md-12">
                    <div class="form h-100">
                      <div class="mb-5" id="contactForm" name="contactForm">
                        <t t-if="record_id.upgrade_system == 'yes' or record_id.solar_system == 'no'">
                          <div class="row">
                            <div class="col-sm-4">
                              <div class="supplier_choose_supplier_comm">
                                <label for="" class="col-form-label suppler_disp_name">Bid Description</label>
                                <t t-if="not bid_data">
                                  <textarea id="supplier_choose_supplier_comment" name="supplier_choose_supplier_comment" class="form-control suppler_disp_name_input" rows="5" cols="50"></textarea>
                                </t>

                                <t t-if="bid_data">
                                  <textarea id="supplier_choose_supplier_comment" name="supplier_choose_supplier_comment" class="form-control suppler_disp_name_input" rows="5" cols="50" t-esc="bid_data.bid_desc"/>
                                </t>
                              </div>
                            </div>
                          </div>
                        </t>

                        <t t-if="record_id.upgrade_system == 'yes' or record_id.solar_system == 'no'">
                          <div class="row">
                            <div class="col-md-4 form-group">
                              <label for="" class="col-form-label suppler_disp_name">System Size</label>
                              <input type="text" class="form-control suppler_disp_name_input float_number_input_only" name="system" id="system_size_name" t-if="not bid_data">
                              </input>

                              <input type="text" class="form-control suppler_disp_name_input float_number_input_only" name="system" id="system_size_name"  t-if="bid_data" t-att-value="bid_data.system_size">
                              </input>
                              <span class="kw">KW</span>
                            </div>
                            <div class="col-md-4 form-group">
                              <label for="" class="col-form-label suppler_disp_name">No of panels</label>
                              <input type="text" class="form-control suppler_disp_name_input
                                number_input_only" name="no_panel" id="no_of_panels"   t-if="not bid_data"/>

                              <input type="text" class="form-control suppler_disp_name_input
                                number_input_only" name="no_panel" id="no_of_panels" t-if="bid_data" t-att-value="bid_data.panels_no"/>
                            </div>
                            <div class="col-md-4 form-group">
                              <label for="" class="col-form-label suppler_disp_name">Panel Brand</label>
                              <input type="text" class="form-control suppler_disp_name_input
                                text_input_only" name="brand_panel" id="panel_brand"   t-if="not bid_data"/>

                              <input type="text" class="form-control suppler_disp_name_input
                                text_input_only" name="brand_panel" id="panel_brand"   t-if="bid_data" t-att-value="bid_data.panels_brand"/>
                            </div>
                          </div>
                        

                          <div class="row">
                            <div class="col-md-4 form-group">
                              <label for="" class="col-form-label suppler_disp_name">Panel power class</label>
                              <input type="text" class="form-control suppler_disp_name_input float_number_input_only" name="power" id="panel_power_classs"  t-if="not bid_data"/>

                              <input type="text" class="form-control suppler_disp_name_input float_number_input_only" name="power" id="panel_power_classs"  t-if="bid_data" t-att-value="bid_data.power_class"/>
                              <span class="kw">W</span>
                            </div>
                            <div class="col-md-4 form-group">
                              <label for="" class="col-form-label suppler_disp_name">Made in</label>
                              <input type="text" class="form-control suppler_disp_name_input text_input_only" name="country_panel" id="made_in"  t-if="not bid_data"/>

                              <input type="text" class="form-control suppler_disp_name_input text_input_only" name="country_panel" id="made_in"  t-if="bid_data" t-att-value="bid_data.made_country"/>
                            </div>
                            <div class="col-md-4 form-group">
                              <label for="" class="col-form-label suppler_disp_name">Type</label>
                              <input type="text" class="form-control suppler_disp_name_input text_input_only" name="type_panel" id="panel_type"  t-if="not bid_data"/>

                              <input type="text" class="form-control suppler_disp_name_input text_input_only" name="type_panel" id="panel_type"  t-if="bid_data" t-att-value="bid_data.solar_type"/>
                            </div>
                          </div>

                          <div class="row">
                            <div class="col-md-4 form-group">
                              <label for="" class="col-form-label suppler_disp_name">Manufacturer’s  Warranty</label>
                              <input type="text" class="form-control suppler_disp_name_input number_input_only" name="manu_panel" id="manufacturer_warranty"  t-if="not bid_data"/>

                              <input type="text" class="form-control suppler_disp_name_input number_input_only" name="manu_panel" id="manufacturer_warranty"  t-if="bid_data" t-att-value="bid_data.manu_year"/>
                              <span class="years">Years</span>
                            </div>
                            <div class="col-md-4 form-group">
                              <label for="" class="col-form-label suppler_disp_name">Performance Warranty</label>
                              <input type="text" class="form-control suppler_disp_name_input
                                number_input_only" name="panel_per" id="performance_warranty"   t-if="not bid_data"/>

                              <input type="text" class="form-control suppler_disp_name_input
                                number_input_only" name="panel_per" id="performance_warranty"   t-if="bid_data" t-att-value="bid_data.per_year"/>
                              <span class="years">Years</span>
                            </div>
                          </div>

                          <div class="row">
                            <div class="col-md-12">
                              <div class="supplier_bid_border"/>
                            </div>
                          </div>

                          <div class="row">
                            <div class="col-md-4 form-group">
                              <label for="" class="col-form-label suppler_disp_name">Inverter Brand</label>
                              <input type="text" class="form-control suppler_disp_name_input text_input_only" name="brand_inverter" id="supllier_inverter_brand"  t-if="not bid_data"/>

                              <input type="text" class="form-control suppler_disp_name_input text_input_only" name="brand_inverter" id="supllier_inverter_brand"  t-if="bid_data" t-att-value="bid_data.inverter_brand"/>
                            </div>
                            <div class="col-md-4 form-group">
                              <label for="" class="col-form-label suppler_disp_name">Inverter Size</label>
                              <input type="text" class="form-control suppler_disp_name_input float_number_input_only" name="size_int" id="supllier_inverter_size"   t-if="not bid_data"/>

                              <input type="text" class="form-control suppler_disp_name_input float_number_input_only" name="size_int" id="supllier_inverter_size"   t-if="bid_data" t-att-value="bid_data.inverter_size"/>
                                <span class="kw">KW</span>
                            </div>
                            <div class="col-md-4 form-group">
                              <label for="" class="col-form-label suppler_disp_name">Made in</label>
                              <input type="text" class="form-control suppler_disp_name_input text_input_only" name="country_inverter" id="made_in_sup"  t-if="not bid_data"/>

                              <input type="text" class="form-control suppler_disp_name_input text_input_only" name="country_inverter" id="made_in_sup"  t-if="bid_data" t-att-value="bid_data.manu_country"/>
                            </div>
                          </div>

                          <div class="row">
                            <div class="col-md-4 form-group">
                              <label for="" class="col-form-label suppler_disp_name">Manufacturer’s  Warranty</label>
                              <input type="text" class="form-control suppler_disp_name_input number_input_only" name="manu_inverter" id="manufacturer_warranty_sup" t-if="not bid_data"/>

                              <input type="text" class="form-control suppler_disp_name_input number_input_only" name="manu_inverter" id="manufacturer_warranty_sup" t-if="bid_data" t-att-value="bid_data.warranty"/>
                              <span class="years">Years</span>
                            </div>
                          </div>

                          <div class="row">
                            <div class="col-md-12">
                              <div class="supplier_bid_border"/>
                            </div>
                          </div>

                          <div class="row">
                            <div class="col-md-4 form-group">
                              <label for="" class="col-form-label suppler_disp_name">Workmanship warranty</label>
                              <input type="text" class="form-control suppler_disp_name_input number_input_only" name="inverter_per" id="workmanship_warranty" t-if="not bid_data"/>

                              <input type="text" class="form-control suppler_disp_name_input number_input_only" name="inverter_per" id="workmanship_warranty" t-if="bid_data" t-att-value="bid_data.work_warranty"/>
                              <span class="years">Years</span>
                            </div>
                            
                            <t t-if="not bid_data">
                              <div class="col-md-4 form-group"  t-if="record_id.cash_fin == 'cash'">
                                <label for="" class="col-form-label suppler_disp_name">Full Price after STC discount Incl.GST</label>
                                <input type="text" class="form-control suppler_disp_name_input number_input_only" name="price" id="full_price_stc_discount"/>
                                <span class="currency_view">$</span>
                                <p class="price_includes_double_storey">This price includes Double storey, 3ph, meter upgrade etc.<br/>
                                Customer will pay you after installation.</p>
                              </div>
                            </t>

                            <t t-if="bid_data">
                              <div class="col-md-4 form-group"  t-if="bid_data.solar_project_id.cash_fin == 'cash'">
                                <label for="" class="col-form-label suppler_disp_name">Full Price after STC discount Incl.GST</label>
                                <input type="text" class="form-control suppler_disp_name_input number_input_only" name="price" id="full_price_stc_discount" t-att-value="bid_data.full_price"/>
                                <span class="currency_view">$</span>
                                <p class="price_includes_double_storey">This price includes Double storey, 3ph, meter upgrade etc.<br/>
                                Customer will pay you after installation.</p>
                              </div>
                            </t>
                          </div>

                          <t t-if="not bid_data">
                            <div class="row" t-if="record_id.cash_fin == 'finance'">
                              <div class="col-md-4 form-group">
                                <span class="currency_view">$</span>
                                <label for="" class="col-form-label suppler_disp_name">Finance Price</label>
                                <input type="text" class="form-control suppler_disp_name_input number_input_only" name="price_finance" id="price_finance"/>
                                <span class="years">P/W</span>
                              </div>
                              <div class="col-md-1 form-group">
                                  <span class="for">for</span>
                                </div>
                              <div class="col-md-4 form-group">
                                 <label for="" class="col-form-label suppler_disp_name"></label>
                                <input type="text" class="form-control suppler_disp_name_input number_input_only" name="months" id="months"/>
                                <span class="years">Months</span>
                              </div>
                            </div>
                          </t>

                          <t t-if="bid_data">
                            <div class="row" t-if="bid_data.solar_project_id.cash_fin == 'finance'">
                              <div class="col-md-4 form-group">
                                <span class="currency_view">$</span>
                                <label for="" class="col-form-label suppler_disp_name">Finance Price</label>
                                <input type="text" class="form-control suppler_disp_name_input" name="price_finance" id="price_finance" t-att-value="bid_data.final_price"/>
                                <span class="years">P/W</span>
                              </div>
                              <div class="col-md-1 form-group">
                                  <span class="for">for</span>
                                </div>
                              <div class="col-md-4 form-group">
                                 <label for="" class="col-form-label suppler_disp_name"></label>
                                <input type="text" class="form-control suppler_disp_name_input" name="months" id="months" t-att-value="bid_data.months"/>
                                <span class="years">Months</span>
                              </div>
                            </div>
                          </t>

                          <div class="row">
                            <div class="col-md-12">
                              <div class="supplier_bid_border"/>
                            </div>
                          </div>

                        </t>
                      <!-- +++++++++++++++++++++++++++++++betri ++++++++++ -->
                      <t t-if="record_id.add_battery == 'yes' or record_id.battery_backup == 'yes'">
                        <div class="row">
                          <div class="col-md-12">
                            <div class="battery"><lable id="how_it_work_attchment_photo_multi_lable">Battery Information</lable></div>
                          </div>
                        </div>

                        <div class="row">
                          <div class="col-md-4 form-group">
                            <label for="" class="col-form-label suppler_disp_name">System Size</label>
                            <input type="text" class="form-control suppler_disp_name_input float_number_input_only" name="battery_system_size_name" id="battery_system_size_name">
                            </input>

                            <!-- <input type="text" class="form-control suppler_disp_name_input float_number_input_only" name="system" id="system_size_name"  t-if="bid_data" t-att-value="bid_data.system_size"> -->
                            <!-- </input> -->
                              <!-- <span class="kw">KW</span> -->
                          </div>
                        </div>

                        <button type="button" id="battery_information_add" class="battery_information_add btn btn-primary">Add Product</button>

                        <input type="text" name="battery_information_count" id="battery_information_count" value="1" hidden="hidden"/>

