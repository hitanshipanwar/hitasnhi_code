<?xml version="1.0" encoding="UTF-8"?>

<odoo>
	<data>

		<record id="account_move_form_view_inherited" model="ir.ui.view">
	        <field name="name">account.mone.form.view</field>
	        <field name="model">account.move</field>
	        <field name="inherit_id" ref="account.view_move_form"/>
	        <field name="arch" type="xml">
	        	<xpath expr="//page[@name='other_info']" position="inside">
                    <group>
                    	<group>
                    		<field name="zone"/>
                    		<field name="buyer_id"/>
                    		<field name="invoice_value"/>
                    		<field name="invoice_dt"/>
                    		<field name="additional_detail_ref"/>
                    	</group>
                    	<group>
                    		<field name="delivery_dt"/>
                    		<field name="vehicle_no"/>
                    		<field name="path_with_hyperlink"/>
                    		<field name="value_or_per"/>
                    	</group>
                    </group>
	            </xpath>
	        </field>
	    </record>

	    <record id="account_move_form_view_inherited" model="ir.ui.view">
            <field name="name">account.move.form.view</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
            	<xpath expr="//field[@name='partner_id']" position="after">
            		<field name="autocomplete" attrs="{'invisible':[('is_po', '=', True)]}"/>
            		<field name="purchase_ref" attrs="{'invisible':[('is_po', '=', False)]}"/>
            		<field name="is_po" invisible="1"/>
            	</xpath>
            </field>
        </record>

        <record id="purchase_order_form_view_inherited" model="ir.ui.view">
            <field name="name">purchase.order.form.view</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
            	<xpath expr="//field[@name='partner_id']" position="after">
            		<field name="is_po" invisible="1"/>
            	</xpath>
            </field>
        </record>


        <record id="sales_commission_rule_tree_view" model="ir.ui.view">
	        <field name="name">sales.commission.rule.tree.view</field>
	        <field name="model">sales.commission.rule</field>
	        <field name="arch" type="xml">
	            <tree>
	            	<field name="name"/>
	            	<field name="min_sales_amount"/>
	            	<field name="commission_per"/>
	            </tree>
	        </field>
	    </record>

	    <record id="sales_commission_rule_form_view" model="ir.ui.view">
	        <field name="name">sales.commission.rule.form.view</field>
	        <field name="model">sales.commission.rule</field>
	        <field name="arch" type="xml">
	           <form>
	           	<sheet>
	           		<group>
	           			<field name="name"/>
		            	<field name="min_sales_amount"/>
		            	<field name="commission_per"/>
	           		</group>
	           	</sheet>
	           </form>
	        </field>
	    </record>

	    <record id="sales_commission_rule_action_view" model="ir.actions.act_window">
	        <field name="name">Sales Commission Rule</field>
	        <field name="type">ir.actions.act_window</field>
	        <field name="res_model">sales.commission.rule</field>
	        <field name="view_mode">tree,form</field>
	    </record>

	    <record id="sale_order_form_view_inherited" model="ir.ui.view">
            <field name="name">sale.order.form.view</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
            	<xpath expr="//group/group/field[@name='partner_id']" position="after">
            		<field name="sales_commission"/>
            		<field name="total_com"/>
            	</xpath>
            </field>
        </record>

	   <menuitem id="sales_commission_rule"
                name="Sales Commission Rule"
                parent="sale.sale_menu_root"
                action="ionicx_paylip.sales_commission_rule_action_view"
                sequence="30"/>

	</data>
</odoo>