<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_delivery_carrier_form_with_fixed_price" model="ir.ui.view">
        <field name="name">delivery.carrier.form</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
        	<xpath expr="//page[@name='pricing']/group/group/field[@name='fixed_price']" position='after'>
        		<field name="service_type"/>
        		<field name="weight_unit_custom"/>
                <field name="carrier_logo" widget="image"/>
            </xpath>
        </field>
    </record>

</odoo>