<?xml version="1.0" encoding="UTF-8"?>
<odoo>

	<data>
        <!-- Inherit the return picking wizard form view -->
        <record id="view_stock_return_picking_form_inherit" model="ir.ui.view">
            <field name="name">stock.return.picking.form.inherit</field>
            <field name="model">stock.return.picking</field>
            <field name="inherit_id" ref="stock.view_stock_return_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[2]" position="after">
                    <group>
                        <field name="shipping_carrier_ids" options="{'no_create': True, 'no_open': True}" nolabel="1" attrs="{'invisible': ['|', ('show_mo_validation', '=', False), ('is_with_label', '=', False)]}">
                            <tree edit="0" create="0" delete="0">
                                <field name="carrier_id"/>
                                <field name="min_cost"/>
                            </tree>
                        </field>
                    </group>
                </xpath>
                 <xpath expr="//field[@name='location_id']" position="after">
                    <!-- <field name="min_cost"/> -->
                    <field name="is_return_wiz" invisible="1"/>
                    <field name="is_with_label" invisible="1"/>
                    <field name="show_mo_validation" invisible="1"/>
                    <field name="package_qty" attrs="{'invisible': ['|', ('show_mo_validation', '=', False), ('is_with_label', '=', False)]}"/>
                    <field name="carrier_id"  options="{'no_create': True, 'no_open': True, 'no_create_edit': True}" attrs="{'invisible': ['|', ('show_mo_validation', '=', False), ('is_with_label', '=', False)]}"/>
                    <field name="available_carrier_ids" invisible="1"/>
                    <button name="get_rate" type="object" string="Get Rate" class="btn-primary" attrs="{'invisible': ['|', ('show_mo_validation', '=', False), ('is_with_label', '=', False)]}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>