<odoo>
    <data>
        <!-- adicionando el rfc y regimen fiscal al header para los distintos formatos externos -->
        <template id="external_layout_boxed" inherit_id="web.external_layout_boxed">
            <xpath expr="//ul[@name='company_address_list']/li[last()]" position="after">
                <li t-if="company.country_id.code == 'MX'">
                    <span>RFC: <t t-esc="company.vat"/></span>
                </li>
                <li t-if="company.country_id.code == 'MX' and company.partner_id and company.partner_id.l10n_mx_edi_fiscal_regime">
                    Régimen fiscal: <span t-field="company.partner_id.l10n_mx_edi_fiscal_regime"/>
                </li>
            </xpath>
            <xpath expr="//ul[@name='company_address_list']" position="attributes">
                <attribute name="style">font-size:12px;</attribute>
            </xpath>
        </template>

        <template id="external_layout_striped" inherit_id="web.external_layout_striped">
            <xpath expr="//ul[@name='company_address_list']/li[last()]" position="after">
                <li t-if="company.country_id.code == 'MX'">
                    <span>RFC: <t t-esc="company.vat"/></span>
                </li>
                <li t-if="company.country_id.code == 'MX' and company.partner_id and company.partner_id.l10n_mx_edi_fiscal_regime">
                    Régimen fiscal: <span t-field="company.partner_id.l10n_mx_edi_fiscal_regime"/>
                </li>
            </xpath>
            <xpath expr="//ul[@name='company_address_list']" position="attributes">
                <attribute name="style">font-size:12px;</attribute>
            </xpath>
        </template>

        <template id="external_layout_bold" inherit_id="web.external_layout_bold">
            <xpath expr="//ul[@name='company_address_list']/li[last()]" position="after">
                <li t-if="company.country_id.code == 'MX'">
                    <span>RFC: <t t-esc="company.vat"/></span>
                </li>
                <li t-if="company.country_id.code == 'MX' and company.partner_id and company.partner_id.l10n_mx_edi_fiscal_regime">
                    Régimen fiscal: <span t-field="company.partner_id.l10n_mx_edi_fiscal_regime"/>
                </li>
            </xpath>
            <xpath expr="//ul[@name='company_address_list']" position="attributes">
                <attribute name="style">font-size:12px;</attribute>
