        <template id="external_layout_standard" inherit_id="web.external_layout_standard">
            <xpath expr="//ul[@name='company_address_list']/li[last()]" position="after">
                <li t-if="company.country_id.code == 'MX'">
                    <span>RFC: <t t-esc="company.vat"/></span>
                </li>
                <li t-if="company.country_id.code == 'MX' and company.partner_id and company.partner_id.l10n_mx_edi_fiscal_regime">
                    Régimen fiscal: <span t-field="company.partner_id.l10n_mx_edi_fiscal_regime"/>
                </li>
            </xpath>
            <xpath expr="//ul[@name='company_address_list']" position="attributes">
                <attribute name="style">font-size:12px;</attribute>
            </xpath>
        </template>

        <!-- report_invoice_document -->
        <template id="report_invoice_document_quarry" inherit_id="account.report_invoice_document">
            <!-- hide span -->
            <xpath expr="//div[hasclass('page')]/h2/span[3]" position="attributes" t-if="o.company_id.country_id.code == 'MX'">
                <attribute name="style">display:none;</attribute>
            </xpath>
            <xpath expr="//div[hasclass('page')]/h2/span[4]" position="attributes" t-if="o.company_id.country_id.code == 'MX'">
                <attribute name="style">display:none;</attribute>
            </xpath>
            <xpath expr="//div[hasclass('page')]/h2/span[5]" position="attributes" t-if="o.company_id.country_id.code == 'MX'">
                <attribute name="style">display:none;</attribute>
            </xpath>

            <!-- dates -->
            <xpath expr="//div[@name='invoice_date']/span" position="attributes">
                <attribute name="t-if">o.company_id.country_id.code != 'MX'</attribute>
            </xpath>
            <xpath expr="//div[@name='invoice_date']/span" position="after">
                <span t-esc="o.invoice_date.strftime('%d/%m/%Y')" t-if="o.company_id.country_id.code == 'MX'"/>
            </xpath>
            <xpath expr="//div[@name='due_date']/span" position="attributes">
                <attribute name="t-if">o.company_id.country_id.code != 'MX'</attribute>
            </xpath>
            <xpath expr="//div[@name='due_date']/span" position="after">
                <br t-if="o.company_id.country_id.code == 'MX'"/>
                <span t-esc="o.invoice_date_due.strftime('%d/%m/%Y')" t-if="o.company_id.country_id.code == 'MX'"/>
            </xpath>
            <xpath expr="//div[@name='delivery_date']/span" position="attributes">
                <attribute name="t-if">o.company_id.country_id.code != 'MX'</attribute>
            </xpath>
            <xpath expr="//div[@name='delivery_date']/span" position="after">
                <span t-esc="o.delivery_date.strftime('%d/%m/%Y')" t-if="o.company_id.country_id.code == 'MX'"/>
            </xpath>

            <!-- Tipo de cambio -->
            <xpath expr="//div[@id='right-elements']/div[2]" position="after">
                <p class="text-end">
                  <strong>Tipo de cambio:</strong>
                  <span t-field="o.currency_id.inverse_rate" style="font-weight: bolder;">Tipo de cambio</span>
                </p>
            </xpath>

            <!-- Table -->
            <xpath expr="//td[@name='account_invoice_line_name']" position="replace">
                <td name="account_invoice_line_name">
                    <t t-set="description_sale" t-value="line.product_id.with_context(lang=o.user_id.lang).description_sale" t-if="line.product_id and o.company_id.country_id.code == 'MX'"/>
                    <t t-set="description_sale" t-value="line.product_id.description_sale" t-if="line.product_id and o.company_id.country_id.code != 'MX'"/>
                    <span t-if="line.product_id" t-esc="description_sale" t-options="{'widget': 'text'}">Bacon Burger</span>
                </td>
            </xpath>

            <xpath expr="//table[@name='invoice_line_table']" position="attributes">
                <attribute name="class">table table-sm o_main_table table-borderless o_small-fs</attribute>
                <attribute name="style">font-size:0.65em;</attribute>
            </xpath>

            <!-- Shipping address -->
            <xpath expr="//div[@id='informations']" position="attributes">
                <attribute name="class">row mt-3 mb-1 o_small-fs</attribute>
            </xpath>

        </template>

        <template id="report_invoice_document_quarry_l10n_mx_edi" inherit_id="l10n_mx_edi.report_invoice_document">
            <!-- RFC cliente -->
<!--            <xpath expr='//t[@t-call="l10n_mx_edi.l10n_mx_fiscal_regime_receptor"]' position="before">-->
<!--                <span t-if="o.partner_id and o.state == 'draft'">-->
<!--                    <span>RFC: </span>-->
<!--                    <span t-out="o.partner_id.vat">EKU9003173C9</span>-->
<!--                </span>-->
<!--            </xpath>-->
            <!-- Product Code -->
            <xpath expr="//table[@name='invoice_line_table']//th[2]" position="attributes">
                <attribute name="class">text-center</attribute>
            </xpath>
            <xpath expr="//table[@name='invoice_line_table']//td[2]" position="replace">
                <td t-attf-class="text-center {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                    <span t-field="line.product_id.unspsc_code_id.code">01010101</span>
                </td>
            </xpath>
            <!-- Unit code -->
            <xpath expr="//table[@name='invoice_line_table']//th[6]" position="attributes">
                <attribute name="class">text-center</attribute>
            </xpath>
            <xpath expr="//table[@name='invoice_line_table']//td[6]" position="replace">
                <td t-attf-class="text-center {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                    <span t-field="line.product_uom_id.unspsc_code_id.code">01010101</span>
                </td>
            </xpath>
        </template>

        <template id="document_tax_totals_template_quarry" inherit_id="account.document_tax_totals_template">
            <xpath expr="//td" position="attributes" t-if="o.company_id.country_id.code == 'MX'">
                <attribute name="style">color:black;</attribute>
            </xpath>

            <xpath expr="//tr[hasclass('o_total')]" position="attributes" t-if="o.company_id.country_id.code == 'MX'">
                <attribute name="style">background-color: black;</attribute>
                <attribute name="style">color:white;</attribute>
            </xpath>
        </template>
    </data>
</odoo>
