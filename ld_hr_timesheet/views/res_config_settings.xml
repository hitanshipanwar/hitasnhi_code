<?xml version="1.0" encoding="utf-8" ?>

<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hr_timesheet</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="50"/>
        <field name="inherit_id" ref="hr_timesheet.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='section_leaves']" position="after">
                <div name="timesheet_reminder">
                    <h2>Timesheet Reminder Email template</h2>
                    <div class="row mt16 o_settings_container" name="config_leave">
                        <div class="col-xs-12 col-md-12 o_setting_box" name="config_leave_alias">
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="timesheet_reminder_subject" string="Subject" class="col-md-2"/>
                                        <field name="timesheet_reminder_subject"/>
                                    </div>
                                    <div class="row mt16">
                                        <label for="timesheet_reminder_body" string="Body" class="col-md-2"/>
                                        <field name="timesheet_reminder_body" widget="html"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>