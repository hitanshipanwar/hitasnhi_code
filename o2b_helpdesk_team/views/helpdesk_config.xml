<?xml version="1.0"?>
<odoo>

   <record id="view_helpdesk_form_inherit_add_field_razon" model="ir.ui.view">
    <field name="name">view.helpdesk.form.inherit.razon</field>
    <field name="model">helpdesk.ticket</field>
    <field name="inherit_id" ref="o2b_missing_fields.view_helpdesk_form_inherit_add_field"/>
    <field name="priority">4</field>
    <field name="arch" type="xml">   
        <xpath expr="//field[@name='razon_desafiliacion']" position="replace">
                <field name="razon_desafiliacions" options="{'no_create': True}" />
            </xpath>
        </field>
    </record>

    <record id="tree_view_add_list_razon" model="ir.ui.view">
            <field name="name">tree.view.add.list.razon</field>
            <field name="model">razon.desafiliacion.option</field>
            <field name="arch" type="xml">
                <tree editable="bottom" string="All Project" sample="1" >
                    <field name="name"/>
                </tree>
            </field>
    </record>
    
    <record id="add_value_view_action_razon" model="ir.actions.act_window">
            <field name="name">Razón Desafiliación</field>
            <field name="res_model">razon.desafiliacion.option</field>
            <field name="view_mode">tree</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Add Value in list 
                </p>
            </field>
    </record>

    <record id="add_list_value_action_view_razon" model="ir.actions.act_window.view">
            <field name="view_mode">tree</field>
            <field name="sequence" eval="4"/>
            <field name="view_id" ref="tree_view_add_list_razon"/>
            <field name="act_window_id" ref="add_value_view_action_razon"/>
    </record>

     <menuitem id="add_list_item_menu_razon" 
            name="Razón Desafiliación"
            parent="helpdesk.helpdesk_menu_config"
            action="add_value_view_action_razon"
            sequence="120"
            groups="helpdesk.group_helpdesk_manager"/> 


</odoo>