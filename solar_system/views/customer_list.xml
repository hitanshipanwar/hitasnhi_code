<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>
		<record id="contact_detail_kanban_view" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,form</field>
        <field name="search_view_id" ref="base.view_res_partner_filter"/>
        <field name="context">{'default_is_company': True}</field>
        <field name="domain">[('is_supplier','=','customer')]</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Create a contact in your address book
          </p><p>
            Odoo helps you to easily track all activities related to a customer.
          </p>
        </field>
    </record>		
		<menuitem id='customer_list_menu' name='Customer' parent='solar_system.customer_menu' action='contact_detail_kanban_view' sequence="0"/>

	</data>
</odoo>