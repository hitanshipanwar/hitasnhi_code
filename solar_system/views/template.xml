<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>
		<template id="required_templates" name="Required templates" inherit_id="website.assets_backend">
			<xpath expr="." position="inside">
    			<link rel="stylesheet" type="text/css" href="/solar_system/static/src/css/style.css"/>
			</xpath>
		</template>

		<record id="product_template_inherit_view" model="ir.ui.view">
			<field name="name">product.company.configuration.view</field>
			<field name="model">product.template</field>
			<field name="inherit_id" ref="product.product_template_only_form_view"/>
			<field name="arch" type="xml">
				<xpath expr="//field[@name='company_id']" position="after">
					<field name="bid_product" invisible="1"/>
				</xpath>
			</field>
		</record>  

		<record id="action_product_template_bid_data" model="ir.actions.act_window">
	        <field name="name">Products</field>
	        <field name="type">ir.actions.act_window</field>
	        <field name="res_model">product.template</field>
	        <field name="view_mode">kanban,tree,form</field>
	        <field name="context">{}</field>
	        <field name="domain">[('bid_product', '=', True)]</field>
	        <field name="help" type="html">
	            <p class="o_view_nocontent_smiling_face">
	                Create a new product
	            </p>
	        </field>
    	</record> 

    	<record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="30"/>
            <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@id='invite_users']" position="before">
                	<div id="invite_users">
                    	<h2>Airbid Project</h2>
                	</div>
                		
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="closing_hours" class="col-md-5 o_light_label"/>
                                        <field name="closing_hours"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>

	</data>
</odoo>