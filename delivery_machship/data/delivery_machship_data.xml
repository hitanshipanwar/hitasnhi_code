<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">
    <record id="product_product_delivery_machship" model="product.product">
      <field name="name">MachShip</field>
      <field name="default_code">Delivery_MS</field>
      <field name="type">service</field>
      <field name="categ_id" ref="delivery.product_category_deliveries"/>
      <field name="sale_ok" eval="False"/>
      <field name="purchase_ok" eval="False"/>
      <field name="list_price">0.0</field>
      <field name="invoice_policy">order</field>
    </record>
    
    <record id="delivery_carrier_machship" model="delivery.carrier">
        <field name="name">MachShip</field>
        <field name="product_id" ref="delivery_machship.product_product_delivery_machship"/>
        <field name="delivery_type">machship</field>
    </record>
    
    <record id="ir_cron_check_machship_status" model="ir.cron">
        <field name="name">MachShip : Check Consignment Status</field>
        <field eval="True" name="active"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="state">code</field>
        <field name="doall">False</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="code">model.get_machship_status()</field>
    </record>
    
    <record id="ir_cron_machship_process_do" model="ir.cron">
        <field name="name">MachShip : Process Complete DO</field>
        <field eval="True" name="active"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="state">code</field>
        <field name="doall">False</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="code">model.process_complete_do()</field>
    </record>
    
    <record id="ir_cron_machship_pending_cons_status" model="ir.cron">
        <field name="name">MachShip : Check Pending Consignment Status</field>
        <field eval="True" name="active"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="state">code</field>
        <field name="doall">False</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="code">model.check_pending_con_order_status()</field>
    </record>
</data>
</odoo>
