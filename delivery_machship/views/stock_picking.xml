<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_order_form_inherit" model="ir.ui.view">
        <field name="name">delivery.order.form.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_put_in_pack']" position='after'>
                <button name="create_cons_machship" type="object" string="Create Consignment"
                    confirm="This will create consignment in MachShip." class="oe_highlight"
                    attrs="{'invisible': ['|', '|', '|',('delivery_type', '!=', 'machship'), ('state', '!=', 'assigned'), ('picking_type_code', '!=', 'outgoing'), ('machship_cons_number', '!=', False)]}"/>
            </xpath>
            <xpath expr="//field[@name='origin']" position="after">
                <field name="machship_cons_number" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_delivery_order_form_inherit2" model="ir.ui.view">
        <field name="name">delivery.order.form.inherit2</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="delivery.view_picking_withcarrier_out_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='delivery_type']" position="after">
                <field name='machship_cons_id' invisible="1"/>
                <field name="machship_cons_number" readonly="1"/>
            </xpath>
            <xpath expr="//label[@for='weight']" position="before">
                <field name="machship_status" readonly="1" attrs="{'invisible': [('delivery_type', '!=', 'machship')]}"/>
                <field name="tracking_url" widget="url" readonly="False" attrs="{'invisible': [('delivery_type', '!=', 'machship')]}"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_move_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- <xpath expr="//sheet/notebook/page[@id='other_tab']"
            position="inside"> -->
            <xpath expr="//group[@id='other_tab_group']" position="inside">
                <group string='Shipping Information' attrs="{'invisible':([('move_type', '=', 'in_invoice')])}">
                    <field name="carrier_id" attrs="{'invisible':([('move_type', '=', 'in_invoice')])}" string='Carrier'/>
                    <field name="machship_cons_number" attrs="{'invisible':([('move_type', '=', 'in_invoice')])}"/>
                    <field name="carrier_tracking_ref" attrs="{'invisible':([('move_type', '=', 'in_invoice')])}"/>
                    <field name="tracking_url" attrs="{'invisible':([('move_type', '=', 'in_invoice')])}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
