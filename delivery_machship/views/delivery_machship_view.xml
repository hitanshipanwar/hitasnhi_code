<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_carrier_form_with_provider_machship" model="ir.ui.view">
        <field name="name">delivery.carrier.form.provider.machship</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='destination']" position='before'>
                <page string="MachShip Configuration" name="ups_configuration"
                    attrs="{'invisible': [('delivery_type', '!=', 'machship')]}">
                    <group>
                        <label for="machship_token"/>
                        <div>
                            <field name="machship_token" attrs="{'required': [('delivery_type', '=', 'machship')]}"/>
                            <button string="Check Connection" name="machship_check_conn" type="object" class="oe_link"/>
                        </div>
                        <field name="chep_fast"/>
                        <field name="mach_carrier_id" attrs="{'required': [('delivery_type', '=', 'machship')], 'invisible': [('chep_fast', '!=', False)]}"/>
                        <field name="mach_acc_carrier_id" attrs="{'required': [('delivery_type', '=', 'machship')], 'invisible': [('chep_fast', '!=', False)]}"/>
                        <field name="comp_carrier_account_id" attrs="{'required': [('delivery_type', '=', 'machship')], 'invisible': [('chep_fast', '!=', False)]}"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
