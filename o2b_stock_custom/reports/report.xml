<?xml version="1.0" encoding="UTF-8"?>
<odoo>

	<template id="report_label_template">
	    <t t-call="web.basic_layout">
	        <div class="col-4" style="padding:0;">
	            <t t-set="aisle" t-value="len(docs)"/>
	            <t t-set="table_width" t-value="'9in' if aisle > 1 else '6in'"/>
	            <table class="table table-condensed" t-attf-style="border-bottom: 0px solid white !important; width: #{table_width};">
	                <tbody>
	                    <t t-set="barcode_count" t-value="0"/>
	                    <tr>
	                        <t t-foreach="docs" t-as="doc">
	                            <t t-if="doc.barcode">
	                                <td style="text-align: center; vertical-align: middle; width:3in;">
	                                	<div style="border: 1px solid black; padding: 10px;">
		                                    <span t-field="doc.name" t-attf-style="font-size: 26px; font-weight: bold;"/>
		                                    <div t-field="doc.barcode" t-options="{'widget': 'barcode', 'symbology': 'auto', 'width': 600, 'height': 150, 'img_style': 'width:100%;height:20%;'}"/>
		                                    <span t-field="doc.barcode"/>
		                                </div>
	                                </td>
	                                <t t-set="barcode_count" t-value="barcode_count + 1"/>
	                                <t t-if="barcode_count % 3 == 0">
	                                    <tr></tr>
	                                </t>
	                            </t>
	                        </t>
	                        <t t-if="barcode_count % 3 != 0">
	                            <td style="width: 3in;"></td>
	                        </t>
	                    </tr>
	                </tbody>
	            </table>
	        </div>
	    </t>
	</template>


    <record id="action_report_label" model="ir.actions.report">
        <field name="name">Label</field>
        <field name="model">stock.aisle</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">o2b_stock_custom.report_label_template</field>
        <field name="report_file">o2b_stock_custom.report_label_template</field>
        <field name="binding_model_id" ref="model_stock_aisle"/>
    </record>

    <record id="model_stock_aisle" model="ir.model">
        <field name="name">stock.aisle</field>
        <field name="model">stock.aisle</field>
    </record>

</odoo>