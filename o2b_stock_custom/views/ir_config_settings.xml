<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.stock</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="30"/>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='stock']" position="inside">
                <h2>Shipping Cost</h2>
                <div class="row mt16 o_settings_container" name="shipping_setting_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <div class="content-group">
                                <div class="mt16">
                                    <span><field name="shipping_max_value"/></span>
                            </div>
                        </div>
                            <label for="shipping_max_value"/>
                            <div class="text-muted">
                                Set the maximum value for shipping costs.
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>