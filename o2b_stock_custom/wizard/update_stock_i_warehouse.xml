<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="update_i_view_form" model="ir.ui.view">
            <field name="name">update.stock.aisle.form</field>
            <field name="model">update.stock.aisle</field>
            <field name="arch" type="xml">
                <form>
                    <!-- <header>
                        <button name="open_barcode_scanner" string="Scan Barcode" type="object" class="oe_highlight"/>
                    </header> -->
                    <group>
                        <!-- <group>
                            <field name="product_id"/>
                        </group>
                        <group>
                            <field name="aisle_id"/>
                        </group> -->
                    </group>
                    <notebook>
                        <page string="Update Product Asile">
                            <field name="update_asile_line_ids">
                                <tree create="0" edit="0">
                                    <field name="product_id"/>
                                    <field name="aisle_id"/>
                                </tree>
                            </field>                                
                        </page>
                    </notebook>
                   <!--  <footer>
                        <button string="Confirm" type="object" name="action_confirm" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer> -->
                </form>
            </field>
        </record>


        <record id="update_stock_i_warehouse_action" model="ir.actions.act_window">
            <field name="name">Update Aisle</field>
            <field name="res_model">update.stock.aisle</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="update_i_view_form"/>
            <field name="target">new</field>
        </record>

        <menuitem
                id="update_stock_i_warehouse_menu"
                name="Update Aisle"
                parent="stock.menu_stock_config_settings"
                action="update_stock_i_warehouse_action"
                sequence="400"/>


        <record id="view_edit_stock_aisle_tree" model="ir.ui.view">
            <field name="name">edit.stock.aisle.tree</field>
            <field name="model">edit.stock.aisle</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="product_id"/>
                    <field name="source_aisle_id"/>
                    <field name="destination_aisle_id"/>
                </tree>
            </field>
        </record>

        <record id="view_edit_stock_aisle_form" model="ir.ui.view">
            <field name="name">edit.stock.aisle.from</field>
            <field name="model">edit.stock.aisle</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <!-- <group>
                            <field name="product_id"/>
                        </group>
                        <group>
                            <field name="source_aisle_id"/>
                            <field name="destination_aisle_id"/>
                        </group> -->
                    </group>
                    <notebook>
                        <page name="edit_product_aisle" string="Edit Product Aisle">
                            <field name="edit_aisle_ids">
                                <tree create="0" edit="0">
                                    <field name="product_id"/>
                                    <field name="source_aisle_id"/>
                                    <field name="destination_aisle_id"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <!-- <footer>
                        <button string="Confirm" type="object" name="action_edit_confirm" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer> -->
                </form>
            </field>
        </record>

        <record id="action_view_edit_stock_aisle" model="ir.actions.act_window">
            <field name="name">Edit Product Aisle</field>
            <field name="res_model">edit.stock.aisle</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_edit_stock_aisle_form"/>
            <field name="target">new</field>
        </record>

    </data>
</odoo>