<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>

		<record id="stock_aisle_comp_rule" model="ir.rule">
            <field name="name">Stock Aisle multi company rule</field>
            <field name="model_id" ref="model_stock_aisle"/>
            <field eval="True" name="global"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="stock_aisle_location_comp_rule" model="ir.rule">
            <field name="name">Stock Aisle Location multi company rule</field>
            <field name="model_id" ref="model_aisle_location"/>
            <field eval="True" name="global"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

	</data>
</odoo>