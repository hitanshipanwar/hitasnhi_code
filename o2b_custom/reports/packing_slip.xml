<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_packingslip_document">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
                <t t-set="partner" t-value="o.partner_id or (o.move_lines and o.move_lines[0].partner_id) or False"/>

                <!-- Custom Header -->
                <div class="header mb2 border-bottom" style="margin-top:-1px">
                    <div class="row">
                        <div class="col-6">
                            <t t-if="o.company_id.logo">
                                <img t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 60px;" alt="Logo"/>
                            </t>
                        </div>
                        <div class="col-6 text-right">
                            <ul class="list-unstyled" t-if="o.company_id.company_details">
                                <!-- <li><t t-esc="o.company_id.company_details"/></li> -->
                                <li><t t-esc="o.company_id.name"/></li>
                                <li><t t-esc="o.company_id.street"/></li>
                                <li><t t-esc="o.company_id.city"/> <t t-esc="o.company_id.state_id.code"/> <t t-esc="o.company_id.zip"/> <t t-esc="o.company_id.country_id.name"/></li>
                                <li>Tel: <t t-esc="o.company_id.phone"/> Fax: <t t-esc="o.company_id.fax"/></li>
                                <!-- <li>Fax: <t t-esc="o.company_id.mobile"/></li> -->
                                <li>PI/CF: <t t-esc="o.company_id.vat"/></li>
                                <li><t t-esc="o.company_id.website"/></li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Report Content -->
                <div class="page mt32">
                    <!-- Destinations -->
                    <div class="row">
                        <div class="col-6" name="destinazione">
                            <span><strong>Destinazione:</strong></span>
                            <div t-field="o.move_lines[0].partner_id"
                                t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
                        </div>
                        <div class="col-6 text-right" name="destinazione_merce">
                            <span><strong>Destinazione Merce:</strong></span>
                            <div t-field="o.picking_type_id.warehouse_id.partner_id"
                                t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
                        </div>
                    </div>

                    <h2>
                        <span t-field="o.name"/>
                    </h2>

                    <div class="row mt32 mb32">
                        <div t-if="o.origin" class="col-auto" name="div_ddtn">
                            <strong>DDT n.:</strong>
                            <!-- <p t-field="o.origin"/> -->
                        </div>
                        <div t-if="o.state" class="col-auto" name="div_oggetto">
                            <strong>Oggetto:</strong>
                            <p t-field="o.origin"/>
                        </div>
                        <div t-if="o.state" class="col-auto" name="div_date">
                            <strong>Date:</strong>
                            <t t-if="o.state == 'done'">
                                <p t-field="o.date_done"/>
                            </t>
                            <t t-if="o.state != 'done'">
                                <p t-field="o.scheduled_date"/>
                           </t>
                        </div>
                    </div>

                    <table class="table table-sm" t-if="o.state != 'done'" name="stock_move_table">
                        <thead>
                            <tr>
                                <th name="th_sm_id"><strong>ID</strong></th>
                                <th name="th_sm_pn"><strong>P/N</strong></th>
                                <th name="th_sm_description"><strong>Description</strong></th>
                                <th name="th_sm_uom"><strong>UOM</strong></th>
                                <th name="th_sm_quantity"><strong>Qty</strong></th>
                                <th name="th_sm_blank"><strong></strong></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="serial_no" t-value="0"/>
                            <t t-foreach="o.move_line_ids_without_package" t-as="ml">
                            <t t-set="serial_no" t-value="serial_no + 1"/>
                            <tr>
                                <td>
                                    <span t-esc="serial_no"/>
                                </td>
                                <td>
                                    <span t-field="ml.product_id.part_number"/>
                                </td>
                                <td>
                                    <span t-field="ml.product_id.name"/>
                                </td>
                                <td>
                                    <span t-field="ml.product_uom_id.name"/>
                                </td>
                                <td>
                                    <span t-field="ml.product_uom_qty"/>
                                </td>
                                <td>
                                    <!-- Extra column if needed -->
                                </td>
                            </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- <div class="mt16 mw-100" style="display: flex;">
                        <div class="custom_note" style="float:left;"><strong>Note:</strong></div>
                        <div><span t-raw="o.note" style="float:left; margin-left: 5px;"/></div>
                    </div>

                    <div class="row">
                        <div class="col-auto" style="display: flex;">
                            <div class="custom_cura" style="float:left;"><strong>Trasporto a cura:</strong></div>
                            <div><span t-raw="o.note" style="float:left; margin-left: 5px;"/></div>
                        </div>
                        <div class="col-auto" style="display: flex;"></div>
                        <div class="col-auto" style="display: flex;"></div>
                    </div>
                    <div class="row">
                        <div class="col-auto" style="display: flex;">
                            <div class="custom_colli" style="float:left;"><strong>Colli:</strong></div>
                            <div><span t-raw="o.note" style="float:left; margin-left: 5px;"/></div>
                        </div>
                        <div class="col-auto" style="display: flex;"></div>
                        <div class="col-auto" style="display: flex;"></div>
                    </div>
                    <div class="row">
                        <div class="col-6" style="display: flex;">
                            <div class="custom_data_ritiro" style="float:left;"><strong>Data ritiro:</strong></div>
                            <div><span t-raw="o.note" style="float:left; margin-left: 5px;"/></div>
                        </div>
                        <div class="col-6" style="display: flex;">
                            <div class="custom_aspetto" style="float:left;"><strong>Aspetto:</strong></div>
                            <div><span t-raw="o.note" style="float:left; margin-left: 5px;"/></div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-6" style="display: flex;">
                            <div class="custom_orario_ritiro" style="float:left;"><strong>Orario Ritiro:</strong></div>
                            <div><span t-raw="o.note" style="float:left; margin-left: 5px;"/></div>
                        </div>
                        <div class="col-3" style="display: flex;">
                            <div class="custom_weight" style="float:left;"><strong>Weight:</strong></div>
                            <div><span t-raw="o.note" style="float:left; margin-left: 5px;"/></div>
                        </div>
                        <div class="col-3" style="display: flex;">
                            <div class="custom_note" style="float:left;"><strong>Note:</strong></div>
                            <div><span t-raw="o.note" style="float:left; margin-left: 5px;"/></div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-6" style="display: flex;">
                            <div class="custom_luogo" style="float:left;"><strong>Luogo di Origine:</strong></div>
                            <div><span t-raw="o.note" style="float:left; margin-left: 5px;"/></div>
                        </div>
                        <div class="col-6" style="display: flex;">
                            <div class="custom_firma_spedizioniere" style="float:left;"><strong>Firma Spedizioniere:</strong></div>
                            <div><span t-raw="o.note" style="float:left; margin-left: 5px;"/></div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-6" style="display: flex;">
                            <div class="custom_signature" style="float:left;"><strong>Signature:</strong></div>
                            <div><span t-raw="o.note" style="float:left; margin-left: 5px;"/></div>
                        </div>
                        <div class="col-6" style="display: flex;">
                            <div class="custom_firma_destinatario" style="float:left;"><strong>Firma Destinatario:</strong></div>
                            <div><span t-raw="o.note" style="float:left; margin-left: 5px;"/></div>
                        </div>
                    </div> -->
                    <table class="table table-bordered">
                        <tr>
                            <td style="width: 30%;"><strong>Trasporto a cura:</strong></td>
                            <td style="width: 70%;" colspan="2">
                            </td>
                        </tr>
                        <tr>
                            <t t-set="package_ids" t-value="o.move_line_ids_without_package.mapped('result_package_id.id')" />
                            <t t-set="unique_package_ids" t-value="package_ids and list(set(package_ids)) or []" />
                            <td><strong>Colli:</strong>
                                <span t-esc="len(unique_package_ids)"/>
                            </td>
                            <td colspan="2">
                            </td>
                        </tr>
                        <tr>
                            <td><strong>Data ritiro:</strong></td>
                            <td>
                            </td>
                            <td><strong>Aspetto:</strong>
                            </td>
                        </tr>
                        <tr>
                            <td><strong>Orario Ritiro:</strong></td>
                            <td><strong>Weight:</strong> 
                                <span t-esc="sum(line.product_id.weight * line.qty_done for line in o.move_line_ids_without_package)"/>
                            </td>
                           <!--  <td><strong>Note:</strong>
                                <span t-raw="o.note"/>
                             </td> -->
                        </tr>
                        <tr>
                            <td><strong>Luogo di Origine:</strong>
                                <span t-raw="o.location_id.location_id.name"/>/<span t-raw="o.location_id.name"/>
                            </td>
                            <td colspan="2"><strong>Firma Spedizioniere:</strong>
                            </td>
                        </tr>
                        <tr>
                            <td><strong>Signature:</strong></td>
                            <td colspan="2"><strong>Firma Destinatario:</strong> 
                            </td>
                        </tr>
                    </table>
                </div>

                <!-- Custom Footer -->
                <div class="footer text-left mt20 pt-2 border-top">
                    <p>
                        <span>
                            <t t-esc="o.company_id.name"/> - 
                            <t t-esc="o.company_id.street"/>
                            <t t-if="o.company_id.street2">, <t t-esc="o.company_id.street2"/></t>,
                            <t t-esc="o.company_id.city"/> <t t-esc="o.company_id.country_id.name"/>
                        </span><br/>
                        <span>
                            Tel: <t t-esc="o.company_id.phone"/>
                            <t t-if="o.company_id.mobile"> fax: <t t-esc="o.company_id.fax"/></t> - 
                            PI/CF: <t t-esc="o.company_id.vat"/>
                        </span><br/>
                        <span>
                            E-Mail: <t t-esc="o.company_id.email"/> - 
                            <t t-esc="o.company_id.website"/>
                        </span>
                    </p>
                </div>
            </t>
        </t>
    </template>

    <template id="report_packingslip">
        <t t-foreach="docs" t-as="o">
            <t t-call="o2b_custom.report_packingslip_document" t-lang="o.partner_id.lang"/>
        </t>
    </template>

    <record id="action_report_packing_slip" model="ir.actions.report">
        <field name="name">Packing Slip</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">o2b_custom.report_packingslip</field>
        <field name="report_file">o2b_custom.report_packingslip</field>
        <field name="print_report_name">'Packing Slip - %s - %s' % (object.partner_id.name or '', object.name)</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
