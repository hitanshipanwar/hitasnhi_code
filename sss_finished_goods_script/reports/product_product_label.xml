<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>
        <template id="report_shelf_talker_move_data">
            <t t-call="web.basic_layout">
                <div class="page">
                    <t t-call="sss_finished_goods_script.report_productlabel_shelf_stock_move">
                        <t t-set="products" t-value="products"/>
                    </t>
                </div>
            </t>
        </template>

        <template id="report_productlabel_shelf_stock_move">
            <t t-call="web.html_container">
                <t t-call="web.html_container">
                    <t t-set="barcode_size"
                    t-value="'width:25mm;height:6.5mm'"/>
                    <t t-set="table_style" t-value="'width:100%;height:70mm;background-color: coral'"/>
                    <t t-set="padding_page" t-value="'padding: 1mm'"/>
                    <t t-foreach="quantity.items()" t-as="barcode_and_qty_by_product">
                        <t t-set="product" t-value="barcode_and_qty_by_product[0]"/>
                        <t t-foreach="barcode_and_qty_by_product[1]" t-as="barcode_and_qty">
                            <t t-set="barcode"
                            t-value="barcode_and_qty[0]"/>
                            <t t-foreach="range(barcode_and_qty[1])" t-as="qty">
                                <t t-call="sss_finished_goods_script.report_simple_label_shelfA4_stock_move"/>
                            </t>
                        </t>
                    </t>
                </t>
            </t>
        </template>


        <template id="report_simple_label_shelfA4_stock_move">
            <div class="o_label_sheet"
                style="font-size: 90%;width: 70mm;height: 50mm;">
                <div class="o_label_full mr-3 ml-3">
                    <div style="width: 100%; line-height: 100%; " class="o_label_name">
                        <div style="height: 100%;position: relative;top: 0px; width: 50%; float: left; font-size:9px;">
                            <span t-field="product.categ_id.name"/>
                        </div>

                        <div style="margin-left:50%;height:100%;position: relative;top:0px;font-size:15px;">
                            <img style="width:20mm;" t-att-src="image_data_uri(company_id.logo)"/>
                        </div>
                    </div>
                    <div style="font-size:9px;background-color:transparent;">
                        <t t-if="is_thai">
                            [<span t-field="product.default_code"/>]<br/>
                            <span t-field="product.thai_product_name"/><br/>
                            <span t-field="product.thai_sale_description"/>
                        </t>
                        <t t-else="">
                            [<span t-field="product.default_code"/>]<br/>
                            <span t-field="product.name"/><br/>
                            <span t-field="product.description_sale"/>
                        </t>
                    </div>
                    <div style="width: 100%; line-height: 100%; background-color:transparent;">
                        <div style="height: 100%;position: relative;top: 0px; width: 50%; float: left;">
                            <t t-if="barcode">
                               <div class="text-right" t-out="barcode" style="padding:0;" t-options="{'widget': 'barcode', 'quiet': 0, 'symbology': 'auto', 'img_style': barcode_size}"/>
                                <div class="o_label_name text-right" style="font-size:8px;background-color: transparent;margin-right:-4px;padding:0;">
                                    <span t-out="barcode"/>
                                </div>

                            </t>
                        </div>
                        <div style="margin-left:50%;position: relative;font-size:9px">
                            <span t-esc="product.uom_id.name"/>
                            <br/>
                            <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%b/%Y %H:%M')"/>
                        </div>
                        <div style="position: relative;top: -12px; width: 100%; float: left;font-size:9px">
                            <span><strong>Customer Name:</strong></span>
                            <span t-esc="stock_move_id.picking_id.partner_id.name"/><br/>
                            <span><strong>Order No.:</strong></span>
                            <span t-esc="stock_move_id.picking_id.origin"/><br/>
                            <span><strong>Components:</strong></span>
                            <span t-esc="stock_move_id.componants"/>
                            <span style="position: relative;left: 50px;"><strong>Weight (kg):</strong>
                            <t t-esc="stock_move_id.weight"/></span> 
                        </div>
                    </div>
                </div>
            </div>
        </template>
    </data>
</odoo>




