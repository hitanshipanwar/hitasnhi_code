<odoo>
    <template id="purchase_order_signuture_inherit" inherit_id="stock.report_delivery_document">

    	<xpath expr="//table[@name='stock_move_table']/thead/tr/th[@name='th_sm_product']" position="after">
    		<th name="th_sm_serial_number"><strong>Serial Number</strong></th>
    	</xpath>

        <xpath expr="//table[@name='stock_move_table']/tbody/tr/td[1]" position="after">
            <td>
                <span t-field="move.product_packaging_id.name"/>
            </td>
        </xpath>

        <xpath expr="//table[@name='stock_move_table']" position="before">
        <!-- <xpath expr="//div[@t-if='o.state']" position="after"> -->
            <div class="row mt32 mb32">
                <div  class="col-auto" name="div_total_packing_qty">
                    <strong>Packing Quantity:</strong>
                    <p t-field="o.total_packing_qty"/>
                </div>
                <div  class="col-auto" name="div_total_packing_weight">
                    <strong>Packing Weight (kg):</strong>
                    <p t-field="o.total_packing_weight"/>
                </div>
                <div  class="col-auto" name="div_total_componants_qty">
                    <strong>Components Quantity:</strong>
                    <p t-field="o.total_componants_qty"/>
                </div>
            </div>
        </xpath>

    </template>
</odoo>