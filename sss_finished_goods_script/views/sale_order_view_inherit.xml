<?xml version="1.0"?>
<odoo>
    <data>
        <record id="view_order_picking_form_inherit_sale_stock" model="ir.ui.view">
            <field name="name">sale.order.inherit.form.sale.stock</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
            	<xpath expr="//button[@name='action_view_invoice']" position="before">
                    <button type="object"
                        name="action_view_internal"
                        class="oe_stat_button"
                        icon="fa-truck"
                        attrs="{'invisible': [('internal_count', '=', 0)]}" groups="stock.group_stock_user">
                        <field name="internal_count" widget="statinfo" string="Internal"/>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>