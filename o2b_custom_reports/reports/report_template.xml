    <!-- task HSO-1739 -->
    <template id="report_purchaseeorder_document_inherit" inherit_id="purchase.report_purchaseorder_document" name="Purchase Order Report Inherit">
        <xpath expr="//p[@t-field='o.notes']" position="replace"/>

        <xpath expr="//div[@id='informations']" position="after">
            <p t-field="o.notes"/>
            <!-- <div t-if="o.get_pdf_attachment_links_from_note()">
                <strong>Attachments:</strong>
                <p t-raw="o.get_pdf_attachment_links_from_note()"/>
            </div> -->
        </xpath>
        <xpath expr="//div[@id='total']" position="after">
            <div t-if="o.get_pdf_images_from_note()">
                <strong>Embedded Attachments:</strong>
                <t t-foreach="o.get_pdf_images_from_note()" t-as="img_data">
                    <img t-att-src="'data:image/png;base64,' + img_data" style="width:100%; margin-top: 10px;"/>
                </t>
            </div>
        </xpath>
    </template>

    <template id="report_purchasequotation_document_inherit" inherit_id="purchase.report_purchasequotation_document" name="Purchase Quotation Report Inherit">
        <xpath expr="//p[@t-field='o.notes']" position="replace"/>

        <xpath expr="//div[@class='page']/h2" position="after">
            <p t-field="o.notes"/>
            <!-- <div t-if="o.get_pdf_attachment_links_from_note()">
                <strong>Attachments:</strong>
                <p t-raw="o.get_pdf_attachment_links_from_note()"/>
            </div> -->
        </xpath>
        <xpath expr="//div/table" position="after">
            <div t-if="o.get_pdf_images_from_note()">
                <strong>Embedded Attachments:</strong>
                <t t-foreach="o.get_pdf_images_from_note()" t-as="img_data">
                    <img t-att-src="'data:image/png;base64,' + img_data" style="width:100%; margin-top: 10px;"/>
                </t>
            </div>
        </xpath>
    </template>
