	<!-- Record Rule For Group that can be able to see all the data -->
	<record model="ir.rule" id="rule_manager_view_all">
	    <field name="name">Purchase Request Manager View Rule</field>
	    <field name="model_id" ref="kitchen_purchase_request.model_purchase_request"/>
	    <field name="domain_force">[(1, '=', 1)]</field> 
	    <field name="groups" eval="[(4, ref('kitchen_purchase_request.group_purchase_request_manager'))]"/>
	</record>
	
	<!-- Default Group assign -->
	<record id="base.user_admin" model="res.users">
