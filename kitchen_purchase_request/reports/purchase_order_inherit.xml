<odoo>
    <template id="purchase_order_signuture_inherit" inherit_id="purchase.report_purchaseorder_document">

    	<xpath expr="//t[@t-set='address']" position="replace">
    		<t t-set="address">
            	<!-- <div t-field="o.partner_id"
                 t-options='{"widget": "contact", "fields": ["address", "name", "phone", "email", "vat"], "no_marker": True, "phone_icons": True}'/> -->
                <div>
                    <t t-if="o.partner_id">
                        <span t-field="o.partner_id.name"/><br/>
                    </t>
                    <t t-if="o.partner_id.street">
                        <span t-field="o.partner_id.street"/><br/>
                    </t>
                    <t t-if="o.partner_id.street2">
                        <span t-field="o.partner_id.street2"/><br/>
                    </t>
                    <t t-if="o.partner_id.city">
                        <span t-field="o.partner_id.city"/>
                    </t>
                    <t t-if="o.partner_id.state_id">
                        <span t-field="o.partner_id.state_id.name"/>
                    </t>
                    <t t-if="o.partner_id.zip">
                        <span t-field="o.partner_id.zip"/><br/>
                    </t>
                    <t t-if="o.partner_id.country_id">
                        <span t-field="o.partner_id.country_id"/><br/>
                    </t>
                    <t t-if="o.partner_id.phone">
                        <span t-field="o.partner_id.phone"/><br/>
                    </t>
                    <t t-if="o.partner_id.email">
                        <span t-field="o.partner_id.email"/><br/>
                    </t>
                    <t t-if="o.partner_id.vat">
                        <span t-field="o.partner_id.vat"/>
                    </t>
                </div>
       	 	</t>
    	</xpath>

        <!-- Hide Purcahse Quotation And Display Name -->
        <xpath expr="//div/div[2]" position="replace">
        </xpath>

    	<xpath expr="//t[@t-set='information_block']" position="replace">
    		 <t t-set="information_block">
                <strong>Shipping address:</strong>
                <div t-if="o.dest_address_id">
                    <div t-field="o.dest_address_id"
                        t-options='{"widget": "contact", "fields": ["address", "name", "phone", "email",], "no_marker": True, "phone_icons": True}' name="purchase_shipping_address"/>
                </div>

            </t>
    	</xpath>

        <xpath expr="//t/div/div[@id='informations']" position="inside">
                <div t-if="o.date_planned" class="col-3 bm-2">
                    <strong>Date Req.</strong>
                    <p t-field="o.date_planned"/>
                </div>
        </xpath>

        <xpath expr="//t/div/div[@id='informations']" position="inside">
                <div t-if="o.create_date" class="col-3 bm-2">
                    <strong>Create On</strong>
                    <p t-field="o.create_date"/>
                </div>
        </xpath>

        <xpath expr="//t/div/div[@id='informations']" position="after">
            <br/>
                <div t-if="o.remarks">
                    <strong>Remarks: </strong>
                    <span t-field="o.remarks"/> 
                </div>
        </xpath>
        
       <!--  <xpath expr="//t/div/div[hasclass('row mt-4 mb32')]" position="inside">
            <div t-if="o.partner_ref" class="col-3 bm-2">
                    <strong>Date Req.</strong>
                    <p t-field="line.date_planned" class="m-0"/>
                </div>
        </xpath>
 -->
    	<xpath expr="//t/div/table" position="replace">
			<table class="table table-sm o_main_table mt-4" style="width:100%;border-top:2px solid;">
                <thead>
                    <t t-foreach="o.order_line" t-as="line" />
                    <tr>
                        <th name="th_description" style="width:35%;text-align:left;"><strong>Description</strong></th>
                        <th name="th_taxes"><strong>Taxes</strong></th>
                        <!-- <th name="th_date_req" class="text-center" style="text-align:center;"><strong>Date Req.</strong></th> -->
                        <th name="th_quantity" class="text-end"><strong>Qty</strong></th>
                        <th name="th_price_unit" class="text-end"><strong>Unit Price</strong></th>
                        <th name="th_amount" class="text-end"><strong>Amount</strong></th>
                    </tr>
                </thead>
                <tbody style="border-bottom:2px solid;">
                    <t t-set="current_subtotal" t-value="0"/>
                    <t t-foreach="o.order_line" t-as="line">
                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>
                        <tr t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                            <t t-if="not line.display_type">
                                <td id="product">
                                    <span t-field="line.name"/>
                                </td>
                                <td name="td_taxes">
                                    <span t-esc="', '.join(map(lambda x: x.name, line.taxes_id))"/>
                                </td>
                                   <!--  <td class="text-center">
                                        <span t-field="line.date_planned"/>
                                    </td> -->
                                <td class="text-end">
                                    <span t-field="line.product_qty"/>
                                    <t t-if="line.is_thai and line.product_uom.thai_uom_name">
                                        <span t-field="line.product_uom.thai_uom_name" groups="uom.group_uom"/>
                                    </t>
                                    <t t-else="">
                                        <span t-field="line.product_uom" groups="uom.group_uom"/>
                                    </t>
                                </td>
                                <td class="text-end">
                                    <span t-field="line.price_unit"/>
                                </td>
                                <!-- </t> -->
                                <td class="text-end">
                                    <span t-field="line.price_subtotal"
                                        t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </t>
                            <t t-if="line.display_type == 'line_section'">
                                <td colspan="99" id="section">
                                    <span t-field="line.name"/>
                                </td>
                                <t t-set="current_section" t-value="line"/>
                                <t t-set="current_subtotal" t-value="0"/>
                            </t>
                            <t t-if="line.display_type == 'line_note'">
                                <td colspan="99" id="note">
                                    <span t-field="line.name"/>
                                </td>
                            </t>
                        </tr>
                        <t t-if="current_section and (line_last or o.order_line[line_index+1].display_type == 'line_section')">
                            <tr class="is-subtotal text-end">
                                <td colspan="99" id="subtotal">
                                    <strong class="mr16">Subtotal</strong>
                                    <span
                                        t-esc="current_subtotal"
                                        t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                    />
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>
		</xpath>
		<xpath expr="//div[@id='total']" position="replace">
			<div id="total" class="row justify-content-end">
                <div class="col-4">
                    <table class="table table-sm" style="border-top:2px solid;border-bottom:2px solid;">
                        <t t-set="tax_totals" t-value="o.tax_totals"/>
                        <t t-call="account.document_tax_totals"/>
                    </table>
                </div>
            </div>
			<div t-if="o.manager_signature" class="mt32 ml64 mr4" name="manager_signature">
	            <div class="offset-8">
	                <strong>Signature</strong>
	            </div>
	            <div class="offset-8">
	                <img t-att-src="image_data_uri(o.manager_signature)" style="max-height: 4cm; max-width: 8cm;"/>
	            </div>
	            <div class="offset-8 text-center">
	                <p t-field="o.manager_name"/>
	            </div>
                <div class="offset-8 text-center">
                    <p t-field="o.manager_signed_on"/>
                </div>
	        </div>
	        
		</xpath>

		<!-- <xpath expr="//div[@id='total']" position="after">
			
			<div t-if="o.manager_signature" class="mt32 ml64 mr4" name="manager_signature">
	            <div class="offset-8">
	                <strong>Signature</strong>
	            </div>
	            <div class="offset-8">
	                <img t-att-src="image_data_uri(o.manager_signature)" style="max-height: 4cm; max-width: 8cm;"/>
	            </div>
	            <div class="offset-8 text-center">
	                <p t-field="o.manager_name"/>
	            </div>
	        </div>
	        
		</xpath> -->
	</template>

	<!-- <template id="report_purchaseorder_document_inherit_company_name" inherit_id="purchase_stock.report_purchaseorder_document">
		<xpath expr="//div[@t-if='o.picking_type_id and o.picking_type_id.warehouse_id']/span[1]" position="replace">
			<span t-field="o.company_id.name"/>
		</xpath>
	</template> -->

	<template id="purchase_order_purchasequotation_inherit" inherit_id="purchase.report_purchasequotation_document"> 
    	<xpath expr="//t[@t-set='address']" position="replace">
    		<t t-set="address">
            	<div t-field="o.partner_id"
                 t-options='{"widget": "contact", "fields": ["address", "name", "phone", "email", "vat"], "no_marker": True, "phone_icons": True}'/>
       	 	</t>
    	</xpath>
    	<xpath expr="//t[@t-set='information_block']" position="replace">
    		 <t t-set="information_block">
                <strong>Shipping address:</strong>
                <div t-if="o.dest_address_id">
                    <div t-field="o.dest_address_id"
                        t-options='{"widget": "contact", "fields": ["address", "name", "phone", "email",], "no_marker": True, "phone_icons": True}' name="purchase_shipping_address"/>
                </div>

            </t>
    	</xpath>

    	
    	
    </template>

</odoo>
