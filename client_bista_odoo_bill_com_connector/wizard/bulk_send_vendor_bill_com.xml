<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_bulk_vendor_send_bill_com" model="ir.ui.view">
            <field name="name">view.bulk.vendor.send.bill.com</field>
            <field name="model">bulk.vendor.send.bill.com</field>
            <field name="arch" type="xml">
            <form string="Bulk Vendor Send">
              <p invisible="show_company_ids == True">Do you want to send Selected Vendors to the Bill.com?</p>
              <field name="show_company_ids" invisible="1"/>
              <group  invisible="show_company_ids == False">
                  <p>Select Companies</p>
                  <field name="company_ids" invisible="show_company_ids == False" required="show_company_ids == True" widget="many2many_tags" style="width: 50%" nolabel="1"/>
             </group>
                <footer>
                    <button name="bulk_vendor_send_bill_com_btn" string="Yes" type="object" default_focus="1" class="oe_highlight"/>
                    or
                    <button string="Cancel" class="oe_link" special="cancel"/>
                </footer>
            </form>
            </field>
        </record>

<!--        <act_window-->
<!--                name="Send to Bill.com"-->
<!--                res_model="bulk.send.bill.com"-->
<!--                binding_model="account.move"-->
<!--                binding_views="list"-->
<!--                view_mode="form"-->
<!--                target="new"-->
<!--                view_id="view_bulk_send_to_bill_com"-->
<!--                id="view_bulk_send_to_bill_com_action" groups="bista_odoo_bill_com_connector.group_bill_com_access"/>-->

        <record id="model_bulk_vendor_send_to_bill_com" model="ir.actions.server">
                    <field name="name">Send to Bill.com</field>
                    <field name="model_id" ref="base.model_res_partner"/>
                    <field name="binding_model_id" ref="base.model_res_partner"/>
                    <field name="binding_view_types">list</field>
                    <field name="groups_id" eval="[(4, ref('client_bista_odoo_bill_com_connector.group_bill_com_access'))]"/>
                    <field name="state">code</field>
                    <field name="code">
                        if records:
                            for rec in records:
                                if rec.supplier_rank:
                                    if rec.bill_com_vendor_data:
                                        raise UserError("Please select only those vendors which are not synced with Bill.com")    
                                    action = rec.action_bulk_vendor_send_bill_com_btn()
                                else:
                                    raise UserError("This action is only possible for Vendors.")
                    </field>
            </record>
    </data>




</odoo>
