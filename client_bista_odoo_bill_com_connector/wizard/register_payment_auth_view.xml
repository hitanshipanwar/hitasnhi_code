<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_register_payment_auth" model="ir.ui.view">
            <field name="name">view.register.payment.auth</field>
            <field name="model">register.payment.auth</field>
            <field name="arch" type="xml">
            <form string="User Authentication">
                <h1>Please Enter Your Bill.com Credentials To Proceed</h1>
              <group>
                  <group>
                    <field name="auth_username" required="1"/>
                  </group>
                  <group>
                    <field name="auth_password" password="True" required="1"/>
                  </group>
              </group>
                <footer>
                    <button name="action_default_wizard" type="object" string="Confirm"  default_focus="1" class="oe_highlight"/>
                    or
                    <button string="Cancel" class="oe_link" special="cancel"/>
                </footer>
            </form>
            </field>
        </record>
    </data>
</odoo>
