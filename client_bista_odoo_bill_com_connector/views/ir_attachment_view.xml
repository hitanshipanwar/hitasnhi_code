<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="inherit_view_attachment_form" model="ir.ui.view">
        <field name="name">inherit.ir.attachment.form</field>
        <field name="model">ir.attachment</field>
        <field name="inherit_id" ref="base.view_attachment_form"/>
        <field name="arch" type="xml">
          <xpath expr="//field[@name='public']" position="after">
              <field name="is_sent_on_bill_com" force_save="1" readonly="1" invisible="is_sent_on_bill_com == False"/>
              <field name="bill_com_document_upload_id" readonly="1" force_save="1" invisible="bill_com_document_upload_id == False"/>
          </xpath>
        </field>
    </record>
</odoo>