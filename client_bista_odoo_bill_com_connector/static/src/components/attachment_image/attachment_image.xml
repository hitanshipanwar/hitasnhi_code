<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.AttachmentImage" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_AttachmentImage')]" position="inside">
            <div class="o_AttachmentImage_imageOverlay o_AttachmentImage_SyncToBillDotCom d-flex flex-row justify-content-end position-absolute">
                <div class="o_AttachmentImage_actions d-flex flex-column">
                    <t t-if="!attachmentImage.attachment.is_sent_on_bill_com and attachmentImage.attachment.account_move_bill_id">
                        <div class="o_AttachmentImage_action o_AttachmentImage_actionSyncToBillDotCom text-center"
                             t-on-click="attachmentImage.attachment.onClickSyncToBillDotCom" title="Send to Bill.com">
                            <i class="fa fa-refresh"/>
                        </div>
                    </t>
                </div>
            </div>
        </xpath>
    </t>
</templates>