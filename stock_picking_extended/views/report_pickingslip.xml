<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <template id="report_pickingslip_document">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
                <t t-set="partner" t-value="o.partner_id or (o.move_lines and o.move_lines[0].partner_id) or False"/>
                <t t-if="partner" name="partner_header">
                    <t t-set="address">
                    </t>
                </t>

                <div class="page">

                    <div class="row justify-content-end" t-if="o.sudo().sale_id.client_order_ref">
                        <div class="col-4">
                            <strong>Customer Reference:</strong>
                            <p t-field="o.sudo().sale_id.client_order_ref"/>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <span t-field="o.sale_id"/>
                        </div>
                    </div>
                    <!--<div class="row">-->
                    <!--<div class="col">-->
                    <!--<span t-field="o.create_date"/>-->
                    <!--</div>-->
                    <!--</div>-->
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>
                                    <span>Name</span>
                                </th>
                                <th>
                                    <span>State</span>
                                </th>
                                <th>
                                    <span>City</span>
                                </th>
                                <th>
                                    <span>Creation Date</span>
                                </th>
                                <th t-if="o.picking_type_id.code == 'outgoing' and o.carrier_id">
                                    <strong>Carrier</strong>
                                </th>
                                <th t-if="o.shipping_weight">
                                    <strong>Shipping Weight</strong>
                                </th>
                                <th t-if="o.carrier_tracking_ref">
                                    <strong>Tracking Number</strong>
                                </th>

                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <span t-field="o.partner_id.name"/>
                                </td>
                                <td>
                                    <span t-field="o.partner_id.state_id"/>
                                </td>
                                <td>
                                    <span t-field="o.partner_id.city"/>
                                </td>
                                <td>
                                    <span t-field="o.date" t-options='{"format": "MM/dd/yyyy"}'/>
                                </td>
                                <td t-if="o.picking_type_id.code == 'outgoing' and o.carrier_id" class="h6">
                                    <span t-field="o.carrier_id"/>
                                </td>
                                <td t-if="o.shipping_weight">
                                    <span t-field="o.shipping_weight"/>
                                    <span t-field="o.weight_uom_id"/>
                                </td>
                                <td t-if="o.carrier_tracking_ref">
                                    <span t-field="o.carrier_tracking_ref"/>
                                </td>

                            </tr>
                        </tbody>
                    </table>
                    <div class="row">
                        <div class="col">
                            <span t-field="o.x_studio_field_F7ZDy"/>
                        </div>
                    </div>
                    <table class="table table-sm mt48" t-if="o.state!='done'">
                        <thead>
                            <tr>
                                <th>
                                    <strong>AISLE</strong>
                                </th>
                                <th>
                                    <strong>NAME</strong>
                                </th>
                                <th>
                                    <strong>SIZE</strong>
                                </th>
                                <th>
                                    <strong>QTY</strong>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="lines_to_sort" t-value="o.move_lines.filtered(lambda x: x.product_uom_qty)"/>
                            <t t-set="lines"
                               t-value="lines_to_sort.sorted(key=lambda x: x.product_id.aisle and x.product_id.aisle.name or x.product_id.name)"/>
                            <tr t-foreach="lines" t-as="move">
                                <td>
                                    <span t-field="move.product_id.aisle"/>
                                </td>
                                <td>
                                    <b>
                                        <span t-field="move.product_id.product_tmpl_id.x_studio_oms_internal_name"/>
                                    </b>
                                </td>
                                <td class="o_bold">
                                    <span t-field="move.sale_line_id.product_id.product_template_attribute_value_ids"
                                          class="h6"/>
                                </td>
                                <td>
                                    <span t-esc="'%.0f'%move.x_studio_sold_qty_from_so" class="o_bold h6"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <table class="table table-sm mt48" t-if="o.move_line_ids and o.state=='done'">
                        <thead>
                            <tr>
                                <th>
                                    <span>AISLE</span>
                                </th>
                                <th>
                                    <span>NAME</span>
                                </th>
                                <th>
                                    <span>SIZE</span>
                                </th>
                                <th>
                                    <span>QTY</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="o.move_line_ids.sorted(key=lambda x: x.product_id.aisle and x.product_id.aisle.name or x.product_id.name)"
                                t-as="move_line">
                                <td>
                                    <span t-field="move_line.product_id.aisle"/>
                                </td>
                                <td>
                                    <b>
                                        <span t-field="move_line.move_id.product_id.product_tmpl_id.x_studio_oms_internal_name"
                                              class="h6 o_bold"/>
                                    </b>
                                </td>
                                <td class="o_bold">
                                    <span t-field="move_line.move_id.product_id.product_template_attribute_value_ids"
                                          class="h6"/>
                                </td>
                                <td>
                                    <span t-esc="'%.0f'%move_line.move_id.x_studio_sold_qty_from_so" class="o_bold h6"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <p>
                        <t t-if="o.backorder_ids and o.backorder_ids.filtered(lambda x: x.state not in ('done', 'cancel'))">
                            All items couldn't be shipped, the remaining ones will be shipped as soon as they become
                            available.
                        </t>
                    </p>
                    <div class="row">
                        <div class="row">
                            <div class="col-3">
                                <span>
                                    <strong>Shopify Notes:</strong>
                                    <br/>
                                </span>
                                <span t-field="o.x_studio_field_3RQhL"/>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-3">
                            <span>
                                <strong>Customer Service Notes:</strong>
                                <br/>
                            </span>
                            <span t-field="o.x_studio_field_F7ZDy"/>
                        </div>
                    </div>
                    <div class="row">
                    </div>
                </div>
            </t>
        </t>
    </template>

    <template id="report_pickingslip">
        <t t-foreach="docs" t-as="o">
            <t t-call="stock_picking_extended.report_pickingslip_document" t-lang="o.partner_id.lang"/>
        </t>
    </template>

</odoo>
