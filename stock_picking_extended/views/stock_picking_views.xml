<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_server_update_aisle" model="ir.actions.server">
        <field name="name">Update Aisle</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="state">code</field>
        <field name="code">records.action_update_stock_aisle()</field>
    </record>

    <record id="tree_inherit_stock_picking_show_picker" model="ir.ui.view">
        <field name="name">stock.picking.tree</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="picker_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_picking_inherited" model="ir.ui.view">
        <field name="name">stock.picking.form.inherited</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids_without_package']//tree//field[@name='name']" position="before">
                <field name="stock_aisle"/>
            </xpath>
        </field>
    </record>

