<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.mail</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- <xpath expr="//block[@id='emails']" position="inside"> -->
            <xpath expr="//div[@id='companies']" position="after">
                <block title="Host DB Configuration" id="db_settings">
                    <h2>Host DB URL Configuration</h2>
                    <div class="row mt16 o_settings_container" name="db_url_configuration">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <div class="mt16">
                                        <label for="host_db_url"/>
                                        <span><field name="host_db_url"/></span>
                                    </div>
                                    
                                </div>
                                <div class="text-muted">
                                    Configure Host DB URL.
                                </div>
                            </div>
                        </div>
                    </div>
                    <h2>Company Logo</h2>
                    <div class="row mt16 o_settings_container" name="company_logo">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <div class="mt16">
                                        <label for="db_logo"/>
                                        <span><field name="db_logo"/></span>
                                    </div>
                                    
                                </div>
                                <div class="text-muted">
                                    Configure Company Logo.
                                </div>
                            </div>
                        </div>
                    </div>
                </block>
            </xpath>
        </field>
    </record>
</odoo>