<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="ir_cron_timesheet_daily" model="ir.cron">
            <field name="name">Timesheet Reminder: For Daily Update</field>
            <field name="model_id" ref="model_account_analytic_line"/>
            <field name="type">ir.action.server</field>
            <field name="state">code</field>
            <field name="code">model.send_timesheets()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
        </record>

        <record id="ir_cron_timesheet_daily" model="ir.cron">
            <field name="name">Timesheet Reminder: For Daily Update</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="type">ir.action.server</field>
            <field name="state">code</field>
            <field name="code">model.check_employee_timesheet()</field>
            <field name="active" eval="True"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="nextcall" eval="(DateTime.now().replace(hour=19, minute=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')" />
        </record>
    </data>
</odoo>



