<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_import_invoice_line_wizard" model="ir.ui.view">
            <field name="name">account.move.form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='preview_invoice']" position="after">
                    <button name="%(action_import_invoice_line_wizard)d" class="oe_highlight"
                            string="Import Invoice Line" type="action"
                            attrs="{'invisible': [('state', '!=', 'draft')]}"
                            groups="import_bridge_adv_axis.security_group_invoice"/>
                </xpath>
            </field>
        </record>

        <record id="view_import_sale_order_line_button" model="ir.ui.view">
            <field name="name">sale.order.form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_cancel']" position="after">
                    <button name="%(action_import_sale_order_line_wizard)d" class="oe_highlight"
                            string="Import Sale Order Line" type="action"
                            attrs="{'invisible': [('state', '!=', 'draft')]}"
                            groups="import_bridge_adv_axis.security_group_sale_order"/>
                </xpath>

            </field>
        </record>
        <record id="import_purchase_order_line_form_inherit" model="ir.ui.view">
            <field name="name">purchase.order.form.inherit</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header/button[@name='button_done']" position="after">
                    <button name="%(action_import_purchase_order_line_wizard)d" class="oe_highlight"
                            string="Import Purchase Order Line" type="action"
                            attrs="{'invisible': [('state', '!=', 'draft'),('state', '!=', 'sent'),('state', '!=', 'purchase')]}"
                            groups="import_bridge_adv_axis.security_group_purchase_order"/>
                </xpath>
                <xpath expr="//group[@name='invoice_info']" position="after">
                    <group></group>
                    <group name="additional_details">
                        <div>
                            <h3>Additional Details</h3>
                            <field name="purchase_add_details_id">
                                <tree editable="bottom">
                                    <field name="product_id" invisible="1"/>
                                    <field name="partner_name"/>
                                    <field name="attributes_name"/>
                                    <field name="imp_note"/>
                                    <field name="other_details"/>
                                    <field name="yes_no"/>
                                </tree>
                            </field>
                        </div>
                    </group>
                </xpath>
            </field>
        </record>
        <record id="attendance_tree_view_inherit" model="ir.ui.view">
            <field name="name">hr.attendance.tree</field>
            <field name="model">hr.attendance</field>
            <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='worked_hours']" position="after">
                    <field name="partner_name" />
                    <field name="extra_color" />
                </xpath>
            </field>
        </record>

        <record id="task_tree_view_inherit" model="ir.ui.view">
            <field name="name">project.task.form</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='extra_info']/group[1]" position="inside">
                    <group string="Custom Fields">
                        <field name="partner_name" />
                        <field name="extra_color" />
                        <field name="extra_bool" />
                        <field name="extra_amount" />
                        <field name="extra_notes" />
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
