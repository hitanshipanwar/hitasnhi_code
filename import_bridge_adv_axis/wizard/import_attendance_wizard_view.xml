<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_import_hr_attendance_wizard" model="ir.ui.view">
        <field name="name">import.hr.attendance.form</field>
        <field name="model">import.hr.attendance</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="import_file"/>
                        <field name="file_option"/>
                    </group>
                </group>
                <footer>
                    <button name="import_hr_attendance" string="Import" type="object" default_focus="1"
                            class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_import_hr_attendance">
        <field name="name">Import HR Attendance</field>
        <field name="res_model">import.hr.attendance</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_import_hr_attendance_wizard"/>
        <field name="context">{}</field>
        <field name="target">new</field>
    </record>


                <!--    IMPORT hr attendance    -->
    <record id="view_hr_attendance_export_wizard" model="ir.ui.view">
        <field name="name">import.hr.attendance.form</field>
        <field name="model">import.hr.attendance</field>
        <field name="arch" type="xml">
            <form>
                <group string="Files for HR Attendance ">
                    <group>
                        <div>
                            <p>import_hr_attendance.csv <a href="import_bridge_adv_axis/static/description/hr attendance/import_hr_attendance.csv" ><i class="fa fa-download"></i></a></p>
                            <p>import_hr_attendance.xls <a href="import_bridge_adv_axis/static/description/hr attendance/import_hr_attendance.xls" ><i class="fa fa-download"></i></a></p>
                        </div>
                    </group>
                </group>
                <footer>
                    <button string="Ok" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record model="ir.actions.act_window" id="action_export_hr_attendance">
        <field name="name">Import HR Attendance</field>
        <field name="res_model">import.hr.attendance</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_hr_attendance_export_wizard"/>
        <field name="context">{}</field>
        <field name="target">new</field>
    </record>
</odoo>

