<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_import_task_wizard" model="ir.ui.view">
        <field name="name">import.project.task.form</field>
        <field name="model">import.project.task</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="import_file"/>
                        <field name="file_option"/>
                    </group>
                </group>
                <footer>
                    <button name="import_project_task" string="Import" type="object" default_focus="1"
                            class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_import_task">
        <field name="name">Import Task</field>
        <field name="res_model">import.project.task</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_import_task_wizard"/>
        <field name="context">{}</field>
        <field name="target">new</field>
    </record>


    <!--    Export project task    -->
    <record id="view_task_export_wizard" model="ir.ui.view">
        <field name="name">import.project.task.form</field>
        <field name="model">import.project.task</field>
        <field name="arch" type="xml">
            <form>
                <group string="Files for Task ">
                    <group>
                        <div>
                            <p>import_project_task.csv <a href="import_bridge_adv_axis/static/description/task/import_project_task.csv" ><i class="fa fa-download"></i></a></p>
                            <p>import_project_task.xls <a href="import_bridge_adv_axis/static/description/task/import_project_task.xls" ><i class="fa fa-download"></i></a></p>
                        </div>
                    </group>
                </group>
                <footer>
                    <button string="Ok" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record model="ir.actions.act_window" id="action_export_task">
        <field name="name">Import Task</field>
        <field name="res_model">import.project.task</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_task_export_wizard"/>
        <field name="context">{}</field>
        <field name="target">new</field>
    </record>
</odoo>

