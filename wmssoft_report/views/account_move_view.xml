<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    
		<record id="view_move_form_inherit_picking" model="ir.ui.view">
	           <field name="name">account.move.invoice.form.inherit.picking</field>
	           <field name="model">account.move</field>
	           <field name="inherit_id" ref="account.view_move_form"/>
	           <field name="arch" type="xml">
	           		<xpath expr="//field[@name='payment_reference']" position="after">
		           		<field name="picking_id" force_save="1"
		           		attrs="{'readonly':[('state','!=','draft')],'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund'))]}"/>    
						<field name="po_number" attrs="{'readonly':[('state','!=','draft')],'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund'))]}"/>       		
	           		</xpath>
                    <xpath expr="//div[@name='journal_div']" position="after">
                        <field name="rep_template_id" attrs="{'invisible': [('move_type', 'not in', ['out_invoice', 'out_refund'])]}"/>
                    </xpath>
	           </field>
	     </record>
		 <record id="view_sale_order_inherit_employee" model="ir.ui.view">
	           <field name="name">sale.order.form.inherit.employee</field>
	           <field name="model">sale.order</field>
	           <field name="inherit_id" ref="sale.view_order_form"/>
	           <field name="arch" type="xml">
		 			<xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='order_lines']/field[@name='order_line']/tree[1]/field[@name='name']" position="after">
					 	<field name="employee_name" />
					</xpath>
					<xpath expr="//field[@name='order_line']/tree//field[@name='name']" position="after">
                		<field name="x_studio_additional_information" attrs="{'readonly': [('state', 'in', ('sale','done', 'cancel'))]}"/>
            		</xpath>
            	
				</field>
		</record>

	</data>
</odoo>