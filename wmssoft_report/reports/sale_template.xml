<?xml version="1.0" encoding="utf-8" ?>
    <odoo>
        <template id="wmssoft_report_sale_document">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="wmssoft_report.header_template_sale">
                        <div class="page" style="padding-left:30px;padding-right:30px;padding-top:40px;position: relative;top: -40px;z-index: 999;font-size:14px !important;">
                            <div class="row" style="padding-left:0px; padding-right:0px;">
                                <div t-if="doc.rep_template_id" class="col-12" style="text-align:left">
                                    <span t-field="doc.rep_template_id.address_sale" style=""/>
                                </div>
                            </div>
                            <table style="border-collapse: collapse; width: 100%; padding-left:0px; padding-right:0px;" border="1">
                                <tbody>
                                <!-- <tr>
                                <td style="width: 33.33%; text-align:center; border-right:1px solid #fff !important; background-color:#000000;color:#FFFFFF;"><strong>Bill To</strong></td>
                                <td style="width: 33.33%; text-align:center; border-right:1px solid #fff !important; border-left:1px solid #fff !important; background-color:#000000;color:#FFFFFF;"><strong>Ship To</strong></td>
                                <td style="width: 33.33%; text-align:center; border-left:1px solid #fff !important; background-color:#000000;color:#FFFFFF;"><strong>Order Details</strong></td>
                                </tr> -->
                                <tr>
                                    <td style="width: 33.33%; background-color: #000000; color: #ffffff; margin: 0px 10px; border-right: 12px solid #ffffff !important; text-align: center;"><strong>Bill To</strong></td>
                                    <td style="width: 33.33%; text-align: center; border-right: 12px solid #fff !important; border-left: 1px solid #fff !important; background-color: #000000; color: #ffffff; margin: 0 10px 0 10px;"><strong>Ship To</strong></td>
                                    <td style="width: 33.33%; text-align: center; border-left: 1px solid #fff !important; background-color: #000000; color: #ffffff; margin: 0 10px 0 10px;"><strong>Order Details</strong></td>
                                </tr>
                                <tr style="">
                                <td style="width: 33.3333%; text-align:left; border-right:12px solid #fff !important;">
                                    <p><b><span t-field="doc.partner_invoice_id.display_name"></span>
                                    <!-- <span t-field="doc.partner_invoice_id.name"></span> -->
                                    </b></p>
                                    <!-- <p><b><span t-field="doc.partner_invoice_id.parent_id.name"></span></b></p> -->
                                    <p>
                                  <!-- <span t-field="doc.company_id.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}' /> -->
                                    <span t-field="doc.partner_invoice_id" t-options='{"widget": "contact", "fields": ["address", "email"], "no_marker": True}' /></p><!-- <p><b><span class="text-o-color-1" style="box-sizing:border-box;color:#35979c;" t-field="doc.partner_invoice_id.email"></span></b></p> --></td>
                                <td style="width: 33.3333%; text-align:left;border-right:12px solid #fff !important; border-left:1px solid #fff !important;"><p><b><span t-field="doc.partner_shipping_id.display_name" ></span>
                                <!-- <span t-field="doc.partner_shipping_id.name"></span> -->
                                </b></p><p><span t-field="doc.partner_shipping_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}' /></p></td>
                                <td style="width: 33.3333%; text-align:left;border-left:1px solid #fff !important;">
                                    <p><strong>Customer Reference: </strong><span t-field="doc.client_order_ref"/></p>
                                    <p><strong>Payment Terms: </strong><span t-field="doc.payment_term_id"/></p>
                                    <p><strong>Sale Order Complete?: </strong><span t-field="doc.order_sent"/></p></td>
                                </tr>
                                </tbody>
                            </table>
                           <!--  <div class="row" style="border:1px solid grey">
                                <div class="col-4" style="text-align:left">
                                    <p><strong>Bill to</strong></p>
                                    <p><span t-field="doc.company_id.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}' />
                                        <span t-field="doc.partner_invoice_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}' /></p>
                                    <p><span class="text-o-color-1" style="box-sizing:border-box;color:#35979c;" t-field="doc.partner_invoice_id.email"></span></p>
                                </div>
                                <div class="col-4" style="text-align:left">
                                    <p><strong>Ship to</strong></p>
                                    <p><span t-field="doc.partner_shipping_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}' /></p>
                                </div>
                                <div class="col-4" style="text-align:left">
                                    <p><strong>Order Details</strong></p>
                                    <p><strong>Purchase Reference: </strong><span t-field="doc.client_order_ref"/></p>
                                    <p><strong>Payment Terms: </strong><span t-field="doc.payment_term_id"/></p>
                                    <p><strong>Sale Order Complete?: </strong><span t-field="doc.order_sent"/></p>
                                </div>
                            </div> -->
                            <br/>
                            <div class="row o_table_row" style="padding-left:13px; padding-right:13px;">
                                <table class="o_table_row" style="width: 100%;">
                                    <thead style="background-color:#000000;">
                                        <tr style="background-color:#000000;color:#FFFFFF;">
                                            <th class="text-left" style="width:16%;padding-left:3px;"><span>Item Code</span></th>
                                            <th class="text-left" style="padding-left:3px;"><span>Item Description</span></th>
                                            <t t-if="any(additional_info for additional_info in doc.order_line.mapped('x_studio_additional_information'))">
                                            <th class="text-left" style="width:12%;padding-left:3px;"><span>Additional Info</span></th>
                                            </t>
                                            <th class="text-left" style="width:10%;padding-left:3px;"><span>Qty Ordered</span></th>
                                            <th class="text-left" style="width:10%;padding-left:3px;"><span>Unit Price</span></th>
                                            <th class="text-right" style="width:10%;padding-left:3px;"><span>Sub Total</span></th>
                                        </tr>
                                    </thead>
                                    <tbody class="sale_tbody" style="border-bottom: 1px solid black; ">
                                        <t t-foreach="doc.order_line" t-as="line">
                                            <tr>
                                                <td name="product_code" style="padding-left:3px;">
                                                    <span t-field="line.product_id.default_code" t-options="{'widget': 'text'}"/>
                                                </td>
                                                <td name="sale_line_name" style="padding-left:3px;">
                                                    <span t-field="line.product_id.name" t-options="{'widget': 'text'}"/>
                                                    <t t-if="line.employee_name">
                                                        <br/><i>Associated to <span t-field="line.employee_name" t-options="{'widget': 'text'}"/></i>
                                                    </t>
                                                </td>

                                                <t t-if="any(additional_info for additional_info in doc.order_line.mapped('x_studio_additional_information'))">
                                                    <td name="td_additional_info" style="padding-left:3px;"><span t-field="line.x_studio_additional_information" t-options="{'widget': 'text'}"/></td>
                                                </t>
                                                <td name="qty_ordered" class="text-left" style="padding-left:3px;"><span t-field="line.product_uom_qty"/></td>
                                                <!-- <td name="unit_price" class="text-left">
                                                    <span t-esc="'{:.2f}'.format(round(line.price_unit, 2))"/>
                                                </td> -->
                                                <td name="unit_price" class="text-left" style="padding-left:3px;"><span t-esc="'{:.2f}'.format(round(line.price_unit))"/></td>
                                                <td name="sub_total" class="text-right" style="padding-left:3px;">
                                                    <!-- <span t-esc="line.price_subtotal" /> -->
                                                    <t t-if="doc.currency_id.position == 'before'">
                                                        <span t-esc="doc.currency_id.symbol[-1]" />
                                                    </t>
                                                    <span t-esc="'%.2f'% line.price_subtotal"/>
                                                    <t t-if="doc.currency_id.position == 'after'">
                                                        <span t-esc="doc.currency_id.symbol[-1]" />
                                                    </t>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                            <div class="row">
                                <div class="col-7 o_table_row">
                                    <br/>
                                    <table class="o_table_row" style="width: 100%; padding-left:13px;">
                                        <thead style="background:#000000;color:#FFFFFF;">
                                            <tr>
                                                <th class="text-left" style="width:62%;"><span>Shipping Information</span></th>
                                                <th class="text-left" style="width:38%;"><span>Order Notes</span></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <td class="text-left">
                                                <p t-if="doc.partner_id.property_delivery_carrier_id">Courier: <span t-field="doc.partner_id.property_delivery_carrier_id"/></p>
                                                <p t-if="not doc.partner_id.property_delivery_carrier_id">Courier: Best Method</p>
                                            </td>
                                            <td class="text-left">
                                                
                                            </td>
                                        </tbody>
                                    </table>
                                </div>
                                <div class="col-5" style="text-align:right">
                                    <table class="table table-sm" style="page-break-inside: avoid; padding-right:14px;">
                                        <t t-set='total_qty' t-value='0'/>
                                        <t t-foreach="doc.order_line" t-as="line">
                                        <t t-set='total_qty' t-value='total_qty+line.product_uom_qty'/>
                                        </t>
                                        <tr>
                                            <td class="text-right">Total Ordered Qty</td>
                                            <td class="text-right"><span t-esc="total_qty"/></td>
                                        </tr>
                                        <tr>
                                            <td class="text-right">Subtotal</td>
                                            <td class="text-right">
                                                <t t-if="doc.currency_id.position == 'before'">    
                                                    <span t-esc="doc.currency_id.symbol[-1]" />
                                                </t>
                                                <span t-esc="'%.2f'% doc.amount_untaxed"/>
                                                <t t-if="doc.currency_id.position == 'after'">
                                                    <span t-esc="doc.currency_id.symbol[-1]" />
                                                </t>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-right">GST</td>
                                            <td class="text-right">
                                                <t t-if="doc.currency_id.position == 'before'">    
                                                    <span t-esc="doc.currency_id.symbol[-1]" />
                                                </t>
                                                <span t-esc="'%.2f'% doc.amount_tax"/>
                                                <t t-if="doc.currency_id.position == 'after'">
                                                    <span t-esc="doc.currency_id.symbol[-1]" />
                                                </t>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-right" style="border-top: 1px solid grey!important;">Total</td>
                                            <td class="text-right" style="border-top: 1px solid grey!important;">
                                                <t t-if="doc.currency_id.position == 'before'">    
                                                    <span t-esc="doc.currency_id.symbol[-1]" />
                                                </t>
                                                <span t-esc="'%.2f'% doc.amount_total"/>
                                                <t t-if="doc.currency_id.position == 'after'">
                                                    <span t-esc="doc.currency_id.symbol[-1]" />
                                                </t>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>
        
        
        <template id="report_sale_order">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-set="lang" t-value="doc.partner_id.lang"/>
                    <t t-call="wmssoft_report.wmssoft_report_sale_document" t-lang="lang"/>
                </t>
            </t>
        </template>

        <record id="sale_order_report" model="ir.actions.report">
            <field name="name">Badger Sale Order (PDF)</field>
            <field name="model">sale.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">wmssoft_report.report_sale_order</field>
            <field name="report_file">wmssoft_report.report_sale_order</field>
            <field name="print_report_name">'Sale Order - %s' % (object.name)</field>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="wmssoft_report.invoice_format"/>
        </record>
    </odoo>