<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data noupdate="1">
		
        <record id="mail_activity_complaint_upload" model="mail.activity.type">
            <field name="name">Service Request Upload</field>
            <field name="icon">fa-line-chart</field>
            <field name="res_model">hr.employee.complaint</field>
        </record>

        

        <!-- Service Request Resolution Cron Runs at 5pm -->

        <record id="service_req_cron_alert" model="ir.cron">
            <field name="name">Service Request Resolution</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=11, minute=30, second=0) + timedelta(days=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="numbercall">-1</field>
            <field name="model_id" ref="ionicx_hr_extend.model_hr_employee_complaint"/>
            <field name="state">code</field>
            <field name="code">model.check_service_requests()</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Passport Visa Cron Alert Runs At 11Am -->
        
        <record id="passport_visa_expire_cron_alert" model="ir.cron">
            <field name="name">Passport Visa Expire Alert</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=5, minute=30, second=0) + timedelta(days=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="numbercall">-1</field>
            <field name="model_id" ref="ionicx_hr_extend.model_hr_employee"/>
            <field name="state">code</field>
            <field name="code">model.check_id_expiration()</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Timesheet Approval Activity  -->
        <record id="mail_activity_timesheet_upload" model="mail.activity.type">
            <field name="name">Timesheet Apporval</field>
            <field name="icon">fa-line-chart</field>
            <field name="res_model">account.analytic.line</field>
        </record>

        <!-- Timesheet Approval corn send mail to project manager ar 8pm -->
        <record id="ir_cron_timesheet_activity_message_daily" model="ir.cron">
            <field name="name">Timesheet Approval</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=14, minute=30, second=0) + timedelta(days=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="numbercall">-1</field>
            <field name="model_id" ref="hr_timesheet.model_account_analytic_line"/>
            <field name="state">code</field>
            <field name="code">model.approve_timesheet()</field>
            <field name="active" eval="True"/>
        </record>

	</data>
</odoo>