								<!-- <field name="has_effect_on_work_efficiency" attrs="{'readonly': [('state', '!=', 'draft')]}"/> -->
							</group>
							<group>
								<field name="req_approver_id" groups="base.group_erp_manager" />
								<field name="date" readonly="1"/>
