											<span class="text-muted">Resolve Date: </span>
						                    <span style="color: red; font-weight: bold;">
						                        <field name="resolved_date" />
						                    </span>
						                </div>
						                <div t-if="is_request_deadline == True">
											<span class="text-muted">Resolve Date: </span>
						                    <span style="color: green; font-weight: bold;">
						                        <field name="resolved_date" />
						                    </span>
						                </div>
