		<record id="hr_employee_complaint_action_view" model="ir.actions.act_window">
			<field name="name">My Service Request</field>
			<field name="res_model">hr.employee.complaint</field>
			<field name="domain">[('employee_id.user_id', '=', uid)]</field>
			<field name="view_mode">kanban,tree,form</field>
		</record>

		<record id="action_view_tree_user" model="ir.actions.act_window.view">
	        <field name="sequence" eval="1"/>
	        <field name="view_mode">tree</field>
	        <field name="view_id" ref="view_hr_employee_complaint_tree"/>
	        <field name="act_window_id" ref="hr_employee_complaint_action_view"/>
	    </record>

	    <record id="action_view_form_user" model="ir.actions.act_window.view">
	        <field name="sequence" eval="1"/>
	        <field name="view_mode">form</field>
	        <field name="view_id" ref="view_hr_employee_complaint_form"/>
	        <field name="act_window_id" ref="hr_employee_complaint_action_view"/>
	    </record>

		<record id="action_view_kanban_user" model="ir.actions.act_window.view">
	        <field name="sequence" eval="1"/>
	        <field name="view_mode">kanban</field>
	        <field name="view_id" ref="view_my_hr_employee_complaint_kanban"/>
	        <field name="act_window_id" ref="hr_employee_complaint_action_view"/>
	    </record>

	    <record id="hr_employee_complaint_action_view_approval" model="ir.actions.act_window">
		    <field name="name">All Service Requests</field>
		    <field name="res_model">hr.employee.complaint</field>
		    <field name="view_mode">kanban,tree,form</field>
		</record>

		<record id="action_view_tree_manager_approval" model="ir.actions.act_window.view">
	        <field name="sequence" eval="1"/>
	        <field name="view_mode">tree</field>
	        <field name="view_id" ref="view_hr_employee_complaint_tree_approval"/>
	        <field name="act_window_id" ref="hr_employee_complaint_action_view_approval"/>
	    </record>

	    <record id="action_view_form_manager_approval" model="ir.actions.act_window.view">
	        <field name="sequence" eval="1"/>
	        <field name="view_mode">form</field>
	        <field name="view_id" ref="view_hr_employee_complaint_form_approval"/>
	        <field name="act_window_id" ref="hr_employee_complaint_action_view_approval"/>
	    </record>

	    <record id="action_view_kanban_manager_approval" model="ir.actions.act_window.view">
	        <field name="sequence" eval="1"/>
	        <field name="view_mode">kanban</field>
	        <field name="view_id" ref="view_my_hr_employee_complaint_kanban"/>
	        <field name="act_window_id" ref="hr_employee_complaint_action_view_approval"/>
	    </record>
			
		<record model="ir.actions.act_window" id="employee_complaint_action_kanban">
		    <field name="name">Service Request (Kanban)</field>
		    <field name="res_model">hr.employee.complaint</field>
		    <field name="view_mode">kanban</field>
		    <field name="view_id" ref="view_hr_employee_complaint_kanban"/>
		    <field name="help" type="html">
		        <p class="o_view_nocontent_empty_folder">
		            No activity yet
		        </p>
		    </field>
		</record>

		<!-- Service Request Search View -->

		<record model="ir.ui.view" id="employee_complaint_extension_search_view">
		    <field name="name">Service Request (Serach View)</field>
		    <field name="model">hr.employee.complaint</field>
		    <field name="arch" type="xml">
		        <search string="Archive">
		        	<field name="active"/>
		        	<separator/>
		        	<filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
		        </search>
		    </field>
		</record>


		<!-- HR Complaint Type Tree, Form, Action view -->

		<record id="view_hr_complaint_tree" model="ir.ui.view">
			<field name="name">Service Request Type Tree</field>
			<field name="model">hr.complaint.type</field>
			<field name="arch" type="xml">
				<tree>
					<field name="name"/>
					<field name="approver_department"/>
				</tree>
			</field>
		</record>

		<record id="view_hr_complaint_form" model="ir.ui.view">
			<field name="name">Service Request Type Form</field>
			<field name="model">hr.complaint.type</field>
			<field name="arch" type="xml">
				<form>
					<sheet>
						<div class="oe_title">
							<label for="name" string="Request Type"/>
							<h1>
								<div class="d-flex">
									<field class="text-break" name="name" placeholder="e.g. Service Request"/>
								</div>
							</h1>
						</div>
						<group>
							<group>
								<field name="approver_department"/>
							</group>
						</group>
					</sheet>
				</form>
			</field>
		</record>

		<record id="hr_complaint_action_view" model="ir.actions.act_window">
			<field name="name">Request Type</field>
			<field name="res_model">hr.complaint.type</field>
			<field name="view_mode">tree,form</field>
		</record>


		<!-- Report wizard -->

		<record id="service_request_report_wizardview" model="ir.ui.view">
            <field name="name">service.request.wizard</field>
            <field name="model">service.request.wizard</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Service Request">
                	<h3>Service Request</h3>
                	<br/>
                	<group>
                		<group>
                    		<field name="employee_ids" widget="many2many_tags"/>
                    	</group>
                    </group>
                    <group>
                    	<group>
                    		<field name="from_date" />
                    	</group>
                    	<group>
                    		<field name="to_date" />
                    	</group>
                    </group>
                    <br/>
                    <footer>
                        <button name="print_pdf_report" type="object" string="Print PDF" class = "oe_highlight" />
                        <button string="Cancel" class="btn-primary" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>

        <!-- Action For Wizard -->
        <record id="service_request_report_wizard_action" model="ir.actions.act_window">
            <field name="name">Service Request</field>
            <field name="res_model">service.request.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="service_request_report_wizardview"/>
            <field name="target">new</field>
        </record>

		<menuitem
			id="menu_employee_complaint"
			name="Service Request"
			parent="hr.menu_hr_root"
			/>

			<menuitem
		        id="menu_service_request_approvals"
		        name="All Service Request"
		        parent="menu_employee_complaint"
		        sequence="2"
		        action="hr_employee_complaint_action_view_approval"/>

			<menuitem
				id="menu_hr_employee_complaint"
				name="My Service Request"
				action="hr_employee_complaint_action_view"
				parent="menu_employee_complaint"
				sequence="1"/>

			<menuitem
				id="menu_hr_employee_complaint_type"
				name="Request Type"
				action="hr_complaint_action_view"
				parent="menu_employee_complaint"
				sequence="3"
				groups="ionicx_hr_extend.complaint_master_manager"/>

			<menuitem
				id="menu_service_request_report"
				name="Service Requeset Report"
				action="service_request_report_wizard_action"
				parent="menu_employee_complaint"
				sequence="4"
				groups="ionicx_hr_extend.complaint_master_manager"/>
	</data>
</odoo>