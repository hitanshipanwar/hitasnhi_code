<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>
		<record id="view_hr_attendance_tree_view" model="ir.ui.view">
            <field name="name">hr.attendance.tree</field>
            <field name="model">hr.attendance</field>
            <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
            <field name="arch" type="xml">
            	<xpath expr="//field[@name='employee_id']" position="after">
            		<field name="is_user" invisible="1"/>
            	</xpath>
                <field name="check_in" position="attributes">
                	<attribute name="attrs">{'readonly': [('is_user', '=', True)]}</attribute>
                </field>
                <field name="check_out" position="attributes">
                	<attribute name="attrs">{'readonly': [('is_user', '=', True)]}</attribute>
                </field>
            </field>
        </record>
	</data>
</odoo>