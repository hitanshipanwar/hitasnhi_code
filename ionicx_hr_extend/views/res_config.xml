<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<record id="res_config_settings_view_form_inherited" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div
                    class="app_settings_block"
                    data-string="update_timesheet"
                    string="Update Timesheet"
                    data-key="update_timesheet"
                >
                    <h2>Can Not Update Past Timesheet</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="past_timesheet" />
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="past_timesheet" />
                                <div class="text-muted">Update Past Timesheet</div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>