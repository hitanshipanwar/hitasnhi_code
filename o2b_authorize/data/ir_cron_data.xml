<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data noupdate="0">

		<record id="get_authorize_net_transactions_list_cron" model="ir.cron">
	        <field name="name">Get Authorize.Net Transactions</field>
	        <field name="interval_number">1</field>
	        <field name="interval_type">days</field>
	        <field name="nextcall" eval="(DateTime.now().replace(hour=4, minute=0) + timedelta(days=0)).strftime('%Y-%m-%d %H:%M:%S')" />
	        <!-- <field name="numbercall">-1</field> -->
	        <field name="model_id" ref="account.model_account_move"/>
	        <field name="state">code</field>
	        <field name="code">model.get_transaction_list()</field>
	        <field name="active" eval="True"/>
	    </record>

	</data>
</odoo>