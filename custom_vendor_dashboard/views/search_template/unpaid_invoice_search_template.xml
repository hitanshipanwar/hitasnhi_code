              <h1 class="font_lato">Unpaid Invoices [$<![CDATA[&nbsp;]]><t t-esc="total_invoice_amount" t-options='{"widget": "float", "precision": 2}'/>]</h1>
              <div class="search-bar">
                <span id="search_field" >
                <form class="search-form d-flex align-items-center" method="POST" t-attf-action="/vendor/unpaidinvoice/search?email=#{user_email}&amp;password=#{user_password}&amp;partner_id=#{partner_id}&amp;client_url=#{client_url}">
                  <input type="text" name="query" placeholder="Search by Vendor Invoice or Bill or PO" title="Enter search keyword" required="true"/>
