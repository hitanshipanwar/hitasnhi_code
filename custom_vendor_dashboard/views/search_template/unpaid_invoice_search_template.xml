            <div class="section dashboard">
              <div class="row">
                
                <div class="col-12">
                  <div class="ven-table">
                    <div class="">
                      <table class="table vendor-table font_lato">
                        <thead style=" color: rgba(0, 0, 0, 0.5);">
                          <tr>
                            <th scope="col">Invoice Date</th>
                            <th scope="col">Invoice #</th>
                            <th scope="col">Bill #</th>
                            <th scope="col">Due Date</th>
                            <th scope="col">Total</th>
                            <th scope="col">PO #</th>
                            <th scope="col" class="vensth">STATUS</th>
                          </tr>
                        </thead>
                        <tbody>
                              <t t-foreach="billed_invoice" t-as="record">
                              <tr>
                                <td class="font_lato ligt_font_weight">
                                  <t t-if="record['invoice_date']">
                                    <span ><t t-esc="record['invoice_date']"/></span>
                                  </t>
                                  <t t-else="">
                                    <t t-esc="record['invoice_date']"/>
                                  </t>
                                </td>
                                <td class="font_lato ligt_font_weight">
                                  <t t-esc="record['payment_reference']"/>
                                </td>
                                <th scope="row" class="font_lato ligt_font_weight">
                                <!-- <a t-attf-href="/vendor/open/invoice?invoice_id=#{record.id}&amp;bill_name=#{record.name}&amp;invoice_status=#{record.payment_state}" style="color:black"> -->
                                  <!-- <t t-if="record.name == '/'">
                                   Draft Bill <t t-esc="record.id"/>
                                  </t>
                                  <t t-else=""> -->
                                    <t t-esc="record['name']"/>
                                  <!-- </t> -->
                                <!-- </a> -->
                                </th>
                                <td class="font_lato ligt_font_weight">
                                  <t t-if="record['invoice_date_due']">
                                    <t t-esc="record['invoice_date_due']"/>
                                  </t>
                                  <t t-else="">
                                    <t t-esc="record['invoice_date_due']"/>
                                  </t>
                                </td>
                                <td class="font_lato" style="font-weight:800">$<![CDATA[&nbsp;]]><t t-esc="record['amount_total_signed']"/></td>
                                <td class="font_lato ligt_font_weight" style="color:rgba(0, 0, 0, 0.5);"><t t-esc="record['invoice_purchase_order']"/></td>
                                <t t-if="record['payment_state']=='not_paid'">
                                <td class="vensth"> <span class="venspan_status"> 
                                    NOT PAID
                                </span>
                                </td>
                                </t>
                                <t t-elif="record['payment_state']=='in_payment'">
                                <td class="vensth"> <span class="venspan2"> 
                                    IN PAYMENT
                                    </span>
                                </td>
                                </t>
                                <t t-elif="record['payment_state']=='paid'">
                                <td class="vensth"> <span class="venspan2"> 
                                  PAID
                                  </span>
                                </td>
                                </t>
                                <t t-elif="record.payment_state=='partial'">
                                <td class="vensth"> <span class="venspan2"> 
                                  PARTIAL PAID
                                  </span>
                                </td>
                                </t>
                                <t t-elif="record['payment_state']=='reversed'">
                                <td class="vensth"> <span class="venspan"> 
                                  REVERSED
                                  </span>
                                </td>
                                </t>
                                <t t-elif="record['payment_state']=='invoicing_legacy'">
                                    <td class="vensth"> <span class="venspan"> 
                                  INVOICE APP LAGACY
                                  </span>
                                </td>
                                </t>
                                <t t-elif="record['payment_state']=='scheduled'">
                                <td class="vensth"> <span class="venspan"> 
                                  SCHEDULED
                                  </span>
                                </td>
                                </t>
                                <t t-else="">
                                  <td class="vensth"> <span class="venspan"> 
                                  <t t-esc="record['payment_state']"/>
                                </span>
                              </td>
                                </t>
                              </tr>
                            </t>
                        </tbody>
                      </table>
