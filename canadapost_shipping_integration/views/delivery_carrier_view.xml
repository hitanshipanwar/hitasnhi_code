<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_carrier_ncs_form_view_ept" model="ir.ui.view">
        <field name="name">delivery.carrier.NCS.form.view.ept</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='destination']" position='before'>
                <page string="Canada Post Configuration" name="NCS_configuration"
                      attrs="{'invisible': [('delivery_type', '!=', 'canada_post')]}">
                    <group>
                    <group>
                        <field name="company_id" />
                         <field name="ncs_service_type"
                               attrs="{'required': [('delivery_type', '=', 'canada_post')]}"/>
                         <field name="ncs_option_code"></field>
                        <field name="ncs_reason_for_export" />
                        <field name="ncs_product_packaging_id" />
                        <field name="ncs_manifest" />
                        <field name="print_ncs_manifest" />
                    </group></group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>