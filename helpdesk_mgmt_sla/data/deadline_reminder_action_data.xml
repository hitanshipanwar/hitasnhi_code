<?xml version="1.0" ?>
<odoo>
<!--  SLA Deadline Email Template  -->
    <data noupdate="0">
        <record id="email_template_edi_deadline_reminder" model="mail.template">
            <field name="name">Deadline Reminder...!!</field>
            <field name="model_id" ref="helpdesk_mgmt_sla.model_helpdesk_ticket"/>
            <field name="email_to">${object.user_id.login}</field>
            <field name="subject">Ticket due today -{{object.sla_deadline or 'n/a' }}</field>
            <field name="body_html"><![CDATA[
               <div class="page">
                    <div style="font-family: 'Lucica Grande', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px; color: rgb(34, 34, 34); background-color: #FFF; ">
                        <p>Hello, <t t-out="object.user_id.name"/></p>
                        <p> This email is to remind you that the Ticket listed below is due on <t t-out="object.sla_deadline"/>. </p>
                    </div>
                    <div>
                        <table class="table table-condensed">
                            <thead>
                                <tr>
                                    <th style="background-color:#9b9da0 !important;">Ticket</th>
                                    <th style="background-color:#9b9da0 !important;">Project</th>
                                    <th style="background-color:#9b9da0 !important;">Deadline</th>
                                    <th style="background-color:#9b9da0 !important;">Assigned To</th>
                                    <th style="background-color:#9b9da0 !important;">Link</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><span><t t-out="object.number"/></span></td>
                                    <td><span><t t-out="object.project_id.name"/></span></td>
                                    <td><span><t t-out="object.sla_deadline"/></span></td>
                                    <td><span><t t-out="object.user_id.name"/></span>
                                    </td>
                                    <td style="padding: 7px;">
                                        <a href="/web/login/" style="background-color: #743f74; height:18px;
                                        width:80px; color: white; padding-top:1px;
                                        border: none; border-radius: 5px;
                                        text-align: center; text-decoration: none;
                                        display: inline-block; font-size: 12px;">View Ticket</a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                ]]>
            </field>
        </record>
    </data>
</odoo>
