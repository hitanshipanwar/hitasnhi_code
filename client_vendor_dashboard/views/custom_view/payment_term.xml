<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_payment_term_form_inherit" model="ir.ui.view">
            <field name="name">account.payment.term.form.inherit</field>
            <field name="model">account.payment.term</field>
            <field name="inherit_id" ref="account.view_payment_term_form"/>
            <field name="arch" type="xml">
                <!-- <xpath expr="//field[@name='early_discount']" position="after"> -->
                <xpath expr="//sheet/group[1]" position="after">
                    <group>
                        <field name="default_payment_term"/>
                        <field name="cust_vend_type" widget="radio"/>
                        <field name="due_date" required="1"/>
                    </group>
                </xpath>
            </field>
        </record>
        <record id="view_move_form_inherit2" model="ir.ui.view">
            <field name="name">account.move.form.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='purchase_vendor_bill_id']" position="after">
                    <field name="invoice_purchase_order"  readonly="1" string="PO Reference" invisible=" not invoice_purchase_order"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>