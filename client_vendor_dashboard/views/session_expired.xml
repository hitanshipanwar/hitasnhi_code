    <script type="text/javascript">
        <!-- for USA contry code -->
        function formatPhoneNumber(input) {
            console.log("we are in number format log:")
            let phoneNumber = input.value.replace(/\D/g, '');
            if (phoneNumber.substring(0, 1) !== '1') {
            phoneNumber = '1' + phoneNumber;
            }
            let formattedPhoneNumber = '+1(' + phoneNumber.substring(1, 4) + ')' +
            phoneNumber.substring(4, 7) + '-' +
            phoneNumber.substring(7, 12);
            // Update the input value
            input.value = formattedPhoneNumber;
        }
        
        
        document.addEventListener('DOMContentLoaded', function () {
            var emailLoginForm = document.getElementById('emailLoginForm');
            var mobileLoginForm = document.getElementById('mobileLoginForm');
            var toggleToMobileLogin = document.getElementById('toggleToMobileLogin');
            var toggleToEmailLogin = document.getElementById('toggleToEmailLogin');
            var wrongPhoneNumber = document.getElementById('wrongPhoneMessage');

            if (wrongPhoneNumber )
              {
                emailLoginForm.style.display = 'none';
                mobileLoginForm.style.display = 'block';
                toggleToMobileLogin.parentElement.style.display = 'none';
                toggleToEmailLogin.parentElement.style.display = 'block';


              }
            
            toggleToMobileLogin.addEventListener('click', function () {
                emailLoginForm.style.display = 'none';
                mobileLoginForm.style.display = 'block';
                toggleToMobileLogin.parentElement.style.display = 'none';
                toggleToEmailLogin.parentElement.style.display = 'block';
            });

            toggleToEmailLogin.addEventListener('click', function () {
                emailLoginForm.style.display = 'block';
                mobileLoginForm.style.display = 'none';
                toggleToMobileLogin.parentElement.style.display = 'block';
                toggleToEmailLogin.parentElement.style.display = 'none';
            });
        });
    </script>
    
