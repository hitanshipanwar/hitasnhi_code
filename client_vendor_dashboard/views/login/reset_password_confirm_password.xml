  <script>
        function togglePasswordVisibility() {
          var passwordInput = document.getElementById("new");
          var eyeIcon = document.getElementById("eyeIcon");
          var show_eye_icon = document.getElementById("show_eye_icon");
          if (passwordInput.type === "password") {
            passwordInput.type = "text";
            show_eye_icon.style.display='block';
            eyeIcon.style.display='none';
          } else {
            passwordInput.type = "password";
            show_eye_icon.style.display='none';
            eyeIcon.style.display='block';
          }
        }
        function togglePasswordVisibilityConfirm() {
          var passwordInput = document.getElementById("confirm");
          var eyeIcon = document.getElementById("eyeIconconfirm");
          var show_eye_icon = document.getElementById("show_eye_icon_confirm");
          if (passwordInput.type === "password") {
            passwordInput.type = "text";
            show_eye_icon.style.display='block';
            eyeIcon.style.display='none';
          } else {
            passwordInput.type = "password";
            show_eye_icon.style.display='none';
            eyeIcon.style.display='block';
          }
        }
    </script>

   
