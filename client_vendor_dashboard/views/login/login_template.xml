    <title>Vendor Login</title>
    <link async="true" rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.0/css/all.min.css" crossorigin="" />

    <style>
    @import url('https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&amp;display=swap');
    @font-face {
        font-family: 'Eurostile';
        font-style: normal;
        font-weight: normal;
        src: local('Eurostile'), url('eurostile.woff') format('woff');
    }
    
    @font-face {
    font-family: 'EuroStyle Normal';
    font-style: normal;
    font-weight: normal;
    src: local('EuroStyle Normal'), url('EuroStyle Normal.woff') format('woff');
    }

    .fv_banner {
        display: flex;
        flex-direction: row;
    }

    .fv_right {
        position: relative;
        display: flex;
        flex-direction: column;
        flex: 1;
        height: 100vh;
    }

    .fv_right {
        flex: 1;
    }

    @media (min-width:1200px) {
        .fv_left {
            flex: 2;
        }

        .fv_right {
            flex: 7;
        }

    }

    .fv_left #showcase {
        display: flex;
        justify-content: center;
        align-items: center;
        background: url(/client_vendor_dashboard/static/src/images/Image_Frame_1.svg) no-repeat center center / cover;
        height: 100vh;
        text-align: center;
    }

    .fv_nav {
        padding: 40px;
        height: 90px;
    }

    .fv_card {
        margin-top: 2rem;
    }

    .fv_mid {
        position: absolute;
        margin: 0 auto;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
    }

    .fv_form {
        width: 365px;
        background-color: #fff;
        padding: 20px;
    }

    @media screen and (max-width:992px) {
        .fv_mid {
            position: relative;
            top: auto;
            left: auto;
            transform: translate(0%, 0%);
        }

    }

    h1, h2 {
        font-family: 'Eurostile';
    }

    .fv_title {
        font-size: 22px;
        font-weight: 800;
        text-shadow: 0px 0px 0px #00000094;
    }

    .fv_subtitle {
        color: #585858;
        font-size: 14px;
    }

    .fv_card form {
        display: flex;
        flex-direction: column;
    }

    .import_f {
        color: #ff0000;
        font-size: 13px;
        font-weight: 700;
    }

    .fv_card input {
        padding: 6px;
        margin-bottom: 20px;
        border: 1px solid #ddd;
        border-radius: 6px;
        font-size: 14px;
        padding: 8px;
        padding-left: 35px;
        width: 100%;
        font-family: "Lato", sans-serif;
    }
    .fv_card input:focus {
        outline: 1px solid #6a6a6a40;
    }
    .fv_card label {
        color: #585858;
        font-size: 13px;
        font-weight: 600;
    }

    .fv_phone, .fv_text, .fv_pass {
        position: relative;
    }

    .fv_cicon {
        position: absolute;
        color: #5858589e;
        left: 12px;
        top: 11px;
    }

    .fv_cicon img {
        height: 17px;
    }

    .fv_card button[type="submit"] {
        width: 100%;
        padding: 10px 0;
        background: #3462ae;
        color: #fff;
        border: none;
        border-radius: 5px;
        outline: none;
        cursor: pointer;
        transition: 0.3s;
        font-family: "Lato", sans-serif;
    }
    .fv_card button.bg-color[type="submit"] {
        background: #bfbfbf91;
    }
    .fv_card button[type="submit"]:hover {
        background: #444;
    }

    .fv_card button[type="submit"] {
    }

    .fv_arrow {
        display: inline-block;
        height: 10px;
        position: relative;
        width: 10px;
        margin-left: 10px;
    }

    .fv_arrow::after {
        border-bottom-style: solid;
        border-bottom-width: 2px;
        border-right-style: solid;
        border-right-width: 2px;
        content: "";
        display: inline-block;
        height: 10px;
        left: 0;
        position: absolute;
        top: 0;
        width: 10px;
    }

    .fv_arrow.fv_arrow-bar::before {
        bottom: 1px;
        content: "";
        height: 16px;
        position: absolute;
        right: 0;
        transform-origin: bottom;
        width: 2px;
        -moz-transform: rotate(-45deg);
        -ms-transform: rotate(-45deg);
        -webkit-transform: rotate(-45deg);
        transform: rotate(-45deg);
    }

    .fv_arrow.is-right {
        -moz-transform: rotate(315deg);
        -ms-transform: rotate(315deg);
        -webkit-transform: rotate(315deg);
        transform: rotate(315deg);
    }

    .fv_arrow::after, .fv_arrow .fv_arrow::after {
        border-color: white;
    }

    .fv_arrow::before, .fv_arrow .fv_arrow::before {
        background-color: white;
    }

    .fv_or {
        display: flex;
        flex-direction: row;
        margin-bottom: 1.2rem;
        align-items: center;
        margin: 20px 0;
    }

    .fv_or .bar {
        flex: auto;
        border: none;
        height: 1px;
        background: #aaaaaa52;
    }

    .fv_or span {
        color: #b7b5b5;
        padding: 0 0.8rem;
        font-size: 12px;
    }

    .fv_form_bottom.btom_center {
        text-align: center
    }

    .fv_form_bottom a {
        color: #1f3ab5;
        font-weight: 500;
        font-size: 14px;
    }
    .fv_form_bottom.color_gray a{
        color: #b9babb;
    }
    .fv_form_bottom a:hover {
        color: #0080f1;
        text-decoration: none;
    }

    .ven_chat {
        position: absolute;
        bottom: 5%;
        right: 5%;
    }

    @media screen and (max-width:768px) {
        .ven_chat {
            display: none;
        }

    }
    .fv_text{
        position: relative;
    }
    .fv_check {
        position: absolute;
        top: 9px;
        right: 10px;
        font-size: 14px;
        color: #5858589e;
    }
   /* .fv_check.check_green i{
        color: green;

    }*/
    </style>



