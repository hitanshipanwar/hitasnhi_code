    padding: 6px;
    margin-bottom: 10px;
    border: 1px solid #ddd;
    border-radius: 5px;
    font-size: 12px;
    font-weight: 600;
    }
    .logincard button[type="submit"]:hover {
    background: #444;
    }
    .logincard button[type="submit"] {
    width: 100%;
    padding: 10px 0;
    background: #323232;
    color: #fff;
    border: none;
    border-radius: 5px;
    outline: none;
    cursor: pointer;
    /* font-size: 16px; */
    transition: 0.3s;
    }
    .logincard .submit-btn {
    font-size: 12px;
    background: #293337;
    }
    .logincard button {
    padding: 10px;
    background-color: #007BFF;
    color: #fff;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    }
    .logincard .switch {
    /*margin-top: 15px;*/
    font-size: 12px;
    }
    .logincard .switch a {
    color: #007BFF;
    text-decoration: none;
    }
    .logincard .login-btn .submit-btn{
    display: block;
    }
    .logincard .login-btn:hover .submit-btn {
    background: #353e42;
    text-decoration: none;
    }
