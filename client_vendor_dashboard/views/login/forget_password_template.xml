    }
    .logincard h2 {
    color: #293337;
    margin-bottom: 10px;
    font-size: 20px;
    font-weight: 700;
    }
    .logincard p {
    font-size: 12px;
    }
    .logincard {
    width: 345px;
    background-color: #fff;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    text-align: center;
    }
    @media screen and (max-width: 380px) {
      .logincard {
        width: 300px;
    }
