                 				<field name="feedback" optional="hide"/>
                 				<field name="user_id" string="User" optional="show"/>
                 				<field name="res_model" invisible="1" optional="show"/>
                 				<field name="activity_id" invisible="1" optional="hide"/>
                 				<field name="is_import"/>
                 			</tree>
							<form>
