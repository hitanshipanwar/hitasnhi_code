<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_activity_report_view_pivot" model="ir.ui.view">
        <field name="name">sale.activity.report.pivot</field>
        <field name="model">sale.activity.report</field>
        <field name="arch" type="xml">
            <pivot string="Activities Analysis" sample="1">
                <field name="mail_activity_type_id" type="col" />
                <field name="date" interval="month" type="row" />
            </pivot>
        </field>
    </record>

    <record id="sale_activity_report_view_tree" model="ir.ui.view">
        <field name="name">sale.activity.report.tree</field>
        <field name="model">sale.activity.report</field>
        <field name="arch" type="xml">
            <tree string="Activities Analysis" editable="bottom">
                <field name="subject" readonly="1"/>
                <field name="body" readonly="1"/>
            </tree>
        </field>
    </record>

    <record id="sale_activity_report_view_search" model="ir.ui.view">
        <field name="name">sale.activity.report.search</field>
        <field name="model">sale.activity.report</field>
        <field name="arch" type="xml">
            <search string="Activities Analysis">
                <field name="mail_activity_type_id" string="Activity Type" />
                <!-- <field name="user_id" string="Salesperson" /> -->
                <!-- <field name="team_id" context="{'invisible_team': False}" /> -->
                <field name="author_id" string="Assigned To" />
                <separator />
                <filter name="filter_date" date="date" />
                <separator />
                <group expand="1" string="Group By">
                    <filter string="Activity" name="group_by_activity_type" context="{'group_by': 'mail_activity_type_id'}" />
                    <filter string="Type" name="group_by_subtype" context="{'group_by': 'subtype_id'}" />
                    <filter string="Assigned To" name="group_by_author_id" context="{'group_by': 'author_id'}" />
                    <separator />
                    <!-- <filter string="Salesperson" name="group_by_user_id" context="{'group_by': 'user_id'}" /> -->
                    <!-- <filter string="Sales Team" name="saleschannel" context="{'group_by': 'team_id'}" /> -->
                    <!-- <filter string="State" name="state" context="{'group_by': 'state'}" /> -->
                    <!-- <filter string="Company" name="company" context="{'group_by': 'company_id'}" groups="base.group_multi_company" /> -->
                    <!-- <filter string="Creation Date" name="group_by_lead_date_creation" context="{'group_by': 'order_create_date'}" /> -->
                </group>
            </search>
        </field>
    </record>

    <record id="sale_activity_report_action" model="ir.actions.act_window">
        <field name="name">Sale Activities</field>
        <field name="res_model">sale.activity.report</field>
        <field name="view_mode">pivot</field>
        <field name="context">{
                'pivot_column_groupby': ['mail_activity_type_id'],
                'pivot_row_groupby': ['date:month'],
            }</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                    No data yet!
                </p>
            <p>
                    Start scheduling sale activities on your opportunities
                </p>
        </field>
    </record>

    <menuitem
        id="sale_report_menu_lead"
        name="Outbound Sales"
        parent="crm.crm_menu_report"
        action="sale_activity_report_action"
        sequence="0" />

</odoo>