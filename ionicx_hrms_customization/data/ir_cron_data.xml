<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">

        <!-- CRON - Timesheet Reminder -->
        <record id="ir_cron_timesheet_daily" model="ir.cron">
            <field name="name">Timesheet Reminder: For Daily Timesheet Update</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=15, minute=30, second=0) + timedelta(days=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="numbercall">-1</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="state">code</field>
            <field name="code">model.check_employee_timesheet()</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
