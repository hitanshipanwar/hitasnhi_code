<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_script_execute_log_tree" model="ir.ui.view">
        <field name="name">script.execute.log.tree</field>
        <field name="model">script.execute.log</field>
        <field name="arch" type="xml">
            <tree string="Script Execute">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record model="ir.ui.view" id="view_script_execute_log_form">
        <field name="name">script.execute.log.form</field>
        <field name="model">script.execute.log</field>
        <field name="arch" type="xml">
            <form string="Correct Valuation">
                <header>
                    <button name="script_execute" string="Process" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Script Name"/>
                        <h1>
                            <field name="name" placeholder="Valuation corrected form date ... to date..."/>
                        </h1>
                    </div>
                    <group string="Python Code">
                        <field name="python_code" widget="ace" options="{'mode': 'python'}" nolabel="1"/>
                    </group>
                    <group string="Output">
                        <field name="output" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="script_execute_log_action" model="ir.actions.act_window">
            <field name="name">Code Execute</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">script.execute.log</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_script_execute_log_tree"/>
        </record>

        <menuitem
            parent="base.menu_automation"
            id="menu_script_execute_log"
            action="script_execute_log_action"/>
</odoo>