<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="fleet_highway_toll_tag_tree" model="ir.ui.view">
        <field name="name">highway.toll.tag.tree</field>
        <field name="model">highway.toll.tag</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="fleet_highway_toll_tag_form" model="ir.ui.view">
        <field name="name">highway.toll.tag.form</field>
        <field name="model">highway.toll.tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="fleet_highway_toll_tag_action" model="ir.actions.act_window">
            <field name="name">Highway Toll Tags</field>
            <field name="res_model">highway.toll.tag</field>
            <field name="view_mode">tree,form</field>
    </record>

     <menuitem id="fleet_highway_toll_tag_menu" name="Highway Toll Tags"
        sequence="100" parent="fleet.fleet_configuration"
        action="fleet_highway_toll_tag_action"/>
</odoo>