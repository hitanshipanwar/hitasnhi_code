<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Fleet: Insurance Expiry Reminder Cron Job -->
    <record id="cron_insurance_expiry_reminder" model="ir.cron">
        <field name="name">Fleet: Insurance Expiry Reminder</field>
        <field name="model_id" ref="fleet.model_fleet_vehicle"/>
        <field name="state">code</field>
        <field name="code">model._send_insurance_expiry_alerts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>

    <!-- Maintenance Reminder Cron Job -->
    <record id="ir_cron_maintenance_reminder" model="ir.cron">
        <field name="name">Maintenance Reminder</field>
        <field name="model_id" ref="model_maintenance_request"/>
        <field name="state">code</field>
        <field name="code">model._send_maintenance_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>

</odoo>
