<odoo>
  <data>

        <record id="door_handle_view_tree" model="ir.ui.view">
            <field name="name">door.handle.view.tree</field>
            <field name="model">door.handle</field>
            <field name="arch" type="xml">
                <tree editable="bottom" string="Handles">
                    <field name="name"/>
                    <field name="type"/>
                    <field name="price" widget="monetary"/>
                </tree>
            </field>
        </record>

        <record id="action_door_handle" model="ir.actions.act_window">
            <field name="name">Handles</field>
            <field name="res_model">door.handle</field>
            <field name="view_mode">tree</field>
        </record>

  </data>
</odoo>