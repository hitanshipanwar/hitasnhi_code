<odoo>
    <data>
      <!-- Inherit Form View to Modify it -->
      <record id="quarry_door_product_template_form_view_inhrit" model="ir.ui.view">
          <field name="name">quarry.door.product.template.form.inhrit</field>
          <field name="model">product.template</field>
          <field name="inherit_id" ref="product.product_template_form_view"/>
          <field name="arch" type="xml">

              <xpath expr="//field[@name='detailed_type']" position="after">
                  <field name="classification_type" invisible="detailed_type == 'service' or product_spec_ok == False" required="product_spec_ok == True"/>
              </xpath>

              <xpath expr="//div[@name='options']" position="inside">
                  <span class="d-inline-block">
                      <field name="product_spec_ok"/>
                      <label for="product_spec_ok"/>
                 </span>
              </xpath>

          </field>
      </record>

        <record id="quarry_door_product_template_search_view_inhrit" model="ir.ui.view">
          <field name="name">quarry.door.product.template.search.inhrit</field>
          <field name="model">product.template</field>
          <field name="inherit_id" ref="product.product_template_search_view"/>
          <field name="arch" type="xml">

              <xpath expr="//filter[@name='filter_to_purchase']" position="after">
                  <filter string="Can be use in Specs" name="filter_to_purchase" domain="[('product_spec_ok', '=', True)]"/>
              </xpath>

          </field>
      </record>
    </data>
</odoo>
