<odoo>
  <data>

        <record id="door_hardware_list_view_tree" model="ir.ui.view">
            <field name="name">door.hardware.list.view.tree</field>
            <field name="model">door.hardware.list</field>
            <field name="arch" type="xml">
                <tree editable="bottom" string="Hardware list">
                    <field name="name"/>
                    <field name="product_id" options="{'no_create': True}"/>
                    <field name="pricelist_ids" widget="many2many_tags" options="{'no_create': True}"/>
                </tree>
            </field>
        </record>

        <record id="action_door_hardware_list" model="ir.actions.act_window">
            <field name="name">Hardware list</field>
            <field name="res_model">door.hardware.list</field>
            <field name="view_mode">tree</field>
        </record>

  </data>
</odoo>