<odoo>
  <data>

        <record id="door_type_arc_view_tree" model="ir.ui.view">
            <field name="name">door.type.arc.view.tree</field>
            <field name="model">door.type.arc</field>
            <field name="arch" type="xml">
                <tree editable="bottom" string="Type of Door Arc">
                    <field name="name"/>
                    <field name="type_arc"/>
                    <field name="price" widget="monetary"/>
                </tree>
            </field>
        </record>

        <record id="action_door_type_arc" model="ir.actions.act_window">
            <field name="name">Type of Door Arc</field>
            <field name="res_model">door.type.arc</field>
            <field name="view_mode">tree</field>
        </record>

  </data>
</odoo>