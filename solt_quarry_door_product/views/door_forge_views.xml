<odoo>
  <data>

        <record id="door_forge_view_tree" model="ir.ui.view">
            <field name="name">door.forge.view.tree</field>
            <field name="model">door.forge</field>
            <field name="arch" type="xml">
                <tree editable="bottom" string="Forging">
                    <field name="name"/>
                    <field name="price" widget="monetary"/> 
                </tree>
            </field>
        </record>

        <record id="action_door_forge" model="ir.actions.act_window">
            <field name="name">Forging</field>
            <field name="res_model">door.forge</field>
            <field name="view_mode">tree</field>
        </record>

  </data>
</odoo>