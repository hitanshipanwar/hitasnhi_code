				<!-- Paper Format -->
		<record id="paperformat_payslip_report" model="report.paperformat">
			<field name="name">Payslip Report Format</field>
			<field name="default" eval="False"/>
			<field name="format">custom</field>
			<field name="page_height">300</field>
			<field name="page_width">200</field>
			<field name="orientation">Portrait</field>
			<field name="margin_top">65</field>
			<field name="margin_bottom">60</field>
			<field name="margin_left">0</field>
			<field name="margin_right">0</field>
			<field name="header_line" eval="False"/>
			<field name="header_spacing">65</field>
			<field name="dpi">90</field>
		</record>

		<record id="action_payslip_report" model="ir.actions.report">
			<field name="name">Payslip Report (PDF)</field>
			<field name="model">payslip.payslip</field>
			<field name="report_type">qweb-pdf</field>
			<field name="report_name">ionicx_paylip.payslip_report</field>
			<field name="report_file">ionicx_paylip.payslip_report</field>
			<!-- <field name="print_report_name">'payslip'</field> -->
			<field name="print_report_name">('%s payslip of month %s' % (object.employee_id.name, object.months))</field>
			<field name="binding_model_id" ref="ionicx_paylip.model_payslip_payslip"/>
			<field name="binding_type">report</field>
			<field name="paperformat_id" ref="ionicx_paylip.paperformat_payslip_report"/>
		</record>
	</data>
</odoo>
