<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<record id="fleet_vehicle_view_form_inherit" model="ir.ui.view">
        <field name="name">fleet.vehicle.form</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='driver_id']" position="after">
                <field name="fleet_location_id"/>
            </xpath>
        </field>
    </record>

    <record id="fleet_vehicle_view_search_inherit" model="ir.ui.view">
        <field name="name">fleet.vehicle.search</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search/group/filter[@name='groupby_fueltype']" position="after">
                <filter string="Locations" name="groupby_locations" context="{'group_by': 'fleet_location_id'}"/>
            </xpath>
        </field>
    </record>

</odoo>