<?xml version="1.0" encoding="UTF-8"?>
<odoo>

	<record id="view_stock_quant_tree_editable_inherit" model="ir.ui.view">
        <field name="name">stock.quant.form.custom</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="groups_id" eval="[(4, ref('o2b_access_management.group_warehoues_user_assigned_van'))]"/>
        <field name="arch" type="xml">
            <field name="location_id" position="after">
                <field name="new_location_id" domain="[('id', 'child_of', fleet_location_ids)]" groups="o2b_access_management.group_warehoues_user_assigned_van"/>
                <field name="user_id" invisible="1"/>
                <field name="fleet_location_ids" invisible="1"/>
            </field>
            <field name="location_id" position="attributes" groups="o2b_access_management.group_warehoues_user_assigned_van">
                <attribute name="domain">[('id', 'child_of', fleet_location_ids)]</attribute>
                <attribute name="invisible">[('hide_location', '=', True)]</attribute>
            </field>
        </field>
    </record>

    <record id="view_stock_quant_tree_editable_inherit_admin" model="ir.ui.view">
        <field name="name">stock.quant.form.custom</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">
            <field name="location_id" position="after">
                <field name="new_location_id" invisible="1"/>
            </field>
        </field>
    </record>

    <record id="view_stock_quant_tree_editable_inherit_manufacturing" model="ir.ui.view">
        <field name="name">stock.quant.form.custom</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="groups_id" eval="[(4, ref('o2b_access_management.group_manufacturing_access_inventory'))]"/>
        <field name="arch" type="xml">
            <field name="location_id" position="after">
                <field name="new_location_id" domain="[('location_users', 'in', [user.id])]"/>
            </field>
            <field name="location_id" position="attributes" groups="o2b_access_management.group_manufacturing_access_inventory">
                <attribute name="domain">="[('location_users', 'in', [user.id])]</attribute>
                <attribute name="invisible">[('hide_location', '=', True)]</attribute>
            </field>
        </field>
    </record>

    <record id="view_picking_form_inherit" model="ir.ui.view">
        <field name="name">stock.picking.form.custom</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="groups_id" eval="[(4, ref('o2b_access_management.group_manufacturing_access_inventory'))]"/>
        <field name="arch" type="xml">
            <field name="location_id" position="attributes" groups="o2b_access_management.group_manufacturing_access_inventory">
                <attribute name="domain">[('user_ids', 'in', [uid])]</attribute>
            </field>
        </field>
    </record>

    <record id="action_update_new_location" model="ir.actions.server">
        <field name="name">Update New Location</field>
        <field name="state">code</field>
        <field name="model_id" ref="stock.model_stock_quant"/>
        <field name="binding_model_id" ref="stock.model_stock_quant" />
        <field name="code">records.action_update_new_location_id()</field>
    </record>
    
</odoo>