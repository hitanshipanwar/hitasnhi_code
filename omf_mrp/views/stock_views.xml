<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form.inherited.omf.mrp</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_validate'][1]" position="attributes">
                <attribute name="attrs">{'invisible':[('state', '=', 'done')]}</attribute>
            </xpath>
            <xpath expr="//button[@name='button_validate'][2]" position="replace" />
            <xpath expr="//header" position="inside">
                <button name="action_open_quants" type="object" string="Reconcile Inventory" />
            </xpath>
        </field>
    </record>

</odoo>
