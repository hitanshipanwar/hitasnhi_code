<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<record id="view_sale_order_line_inheritance" model="ir.ui.view">
		<field name="name">sale.order.extend</field>
		<field name="model">sale.order</field>
		<field name="inherit_id" ref="sale.view_order_form"/>
		<field name="arch" type="xml">
			<xpath expr="//field[@name='client_order_ref']" position="after">
				<field name="order_notes_for_transfer"/>
			</xpath>
		</field>
	</record>

	<record id="view_stock_picking_view_inheritance_form" model="ir.ui.view">
		<field name="name">stock.picking.form.view.inherit.custom</field>
		<field name="model">stock.picking</field>
		<field name="inherit_id" ref="stock.view_picking_form"/>
		<field name="arch" type="xml">
			<xpath expr="//form/sheet/div[@name='button_box']" position="before">
				<div class="oe_button_box note_hide" id="note_hide" name="button_box_notes">
				  <div class="container">
				  	<div class="row">
				    	<div class="order_note_col note_hide_remove" style="float: left;width: 80%;background: #fceecc;text-align: left;padding: 12px 0px 0 10px;">
				          <field name="note" id="note_hide_remove"/>
				      	</div>
				      	<div class="order_note_col" style="width:20%;float:left;text-align:right;">
				      		<div class="alert alert-warning mb-0"><button title="Close" aria-label="Close" class="close_notes">×</button></div>
				      	</div>
				    </div>
				  </div>
				</div>

				<script>
					$( ".close_notes" ).click(function() {
					    $('.note_hide').hide();
					});

					$(document).ready(function(){
						var notes = $(".note_hide_remove").text()
						if (notes){
							$('.note_hide').show();
						}else{
							$('.note_hide').hide();
						}
					})
				</script>
			</xpath>
		</field>
	</record>

</odoo>
