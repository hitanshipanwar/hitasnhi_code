<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_expense_type_tree" model="ir.ui.view">
        <field name="name">expense.type.tree</field>
        <field name="model">periodic.travel.expense.type</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="view_expense_type_form" model="ir.ui.view">
        <field name="name">expense.type.form</field>
        <field name="model">periodic.travel.expense.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_expense_type" model="ir.actions.act_window">
	    <field name="name">Expense Types</field>
	    <field name="res_model">periodic.travel.expense.type</field>
	    <field name="view_mode">tree,form</field>
	</record>

    <menuitem id="menu_expense_type" name="Expense Types"
          parent="hr_expense.menu_hr_expense_configuration" action="action_expense_type" 
          groups="hr_expense.group_hr_expense_manager" sequence="20"/>

</odoo>
