<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_candidate_profile_stage_search" model="ir.ui.view">
        <field name="name">candidate.profile.stage.search</field>
        <field name="model">candidate.profile.stage</field>
        <field name="arch" type="xml">
            <search string="Profile Stage Search">
                <separator />
                <field name="name" filter_domain="[('name', 'ilike', self)]" />
            </search>
        </field>
    </record>

    <record id="view_candidate_profile_stage_form" model="ir.ui.view">
        <field name="name">candidate.profile.stage.form</field>
        <field name="model">candidate.profile.stage</field>
        <field name="arch" type="xml">
            <form string="Stages">
                <header>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" />
                        <h1>
                            <field name="name" required="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="is_running"/>
                        </group>
                        <group>
                            <field name="is_closed"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_candidate_profile_stage_tree" model="ir.ui.view">
        <field name="name">candidate.profile.stage.tree</field>
        <field name="model">candidate.profile.stage</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="is_running" />
                <field name="is_closed" />
            </tree>
        </field>
    </record>

    <record id="candidate_profile_stage_action_view" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">candidate.profile.stage</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="candidate_profile_satges_menu"
        name="Stages"
        parent="menu_candidate_profile"
        sequence="2"
        action="candidate_profile_stage_action_view"/>
</odoo>
