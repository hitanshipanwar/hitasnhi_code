<odoo>
    <data>
        <record id="helpdesk_catgeory_form_view" model="ir.ui.view" >
            <field name="name">helpdesk.category.form.view</field>
            <field name="model">helpdesk.category</field>
            <field name="arch" type="xml">
                <form>
                    <sheet string="PCP">
                        <div class="oe_title">
                                    <h1>
                                        <field name="name" required="1"/>
                                    </h1>
                                </div>
                        <group>
                            <group>
                                <field name="ticket_type_id"/>
                                <field name="is_contacted"/>
                            </group>
                            <group/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="helpdesk_category_tree_view" model="ir.ui.view" >
            <field name="name">helpdesk.category.tree.view</field>
            <field name="model">helpdesk.category</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="ticket_type_id"/>
                </tree>
            </field>
        </record>

        <record id="helpdesk_category_action" model="ir.actions.act_window">
            <field name="name">Category</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">helpdesk.category</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Create an helpdesk_category
              </p><p>
                Specify helpdesk_category.
              </p>
            </field>
        </record>

        <menuitem id="helpdesk_category_menu" name="Category"
        action="helpdesk_category_action" parent="helpdesk.helpdesk_menu_config"
        sequence="1"/>

    </data>
</odoo>