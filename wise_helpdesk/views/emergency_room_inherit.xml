<odoo>
    <data>
        <record id="emergency_room_form_view" model="ir.ui.view" >
            <field name="name">emergency.room.form.view</field>
            <field name="model">emergency.room</field>
            <field name="arch" type="xml">
                <form>
                    <sheet string="PMG">
                        <div class="oe_title">
                                    <h1>
                                        <field name="name" required="1"/>
                                    </h1>
                                </div>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="emergency_room_tree_view" model="ir.ui.view" >
            <field name="name">emergency.room.tree.view</field>
            <field name="model">emergency.room</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                </tree>
            </field>
        </record>

        <record id="emergency_room_action" model="ir.actions.act_window">
            <field name="name">emergency room</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">emergency.room</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Create an emergency room
              </p><p>
                Specify emergency.room
              </p>
            </field>
        </record>


    </data>
</odoo>
