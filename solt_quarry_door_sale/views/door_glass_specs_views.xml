<odoo>
  <data>

        <record id="door_glass_specs_view_tree" model="ir.ui.view">
            <field name="name">door.glass.specs.view.tree</field>
            <field name="model">door.glass.specs</field>
            <field name="arch" type="xml">
                <tree create="0" string="Glass Specs">
                    <field name="sequence" widget='handle'/>
                    <field name="glass_piece_id" options="{'no_create': True}"/>
                    <field name="handing_glass_id" options="{'no_create': True}"/>
                    <field name="glass_type_id" options="{'no_create': True}"/>
                    <field name="radius_id" options="{'no_create': True}"/>
                    <field name="glass_width"/> 
                    <field name="glass_height"/> 
                    <field name="glass_qty"/>
                </tree>
            </field>
        </record>

        <record id="action_door_glass_specs" model="ir.actions.act_window">
            <field name="name">Glass Specs</field>
            <field name="res_model">door.glass.specs</field>
            <field name="view_mode">tree</field>
        </record>

  </data>
</odoo>