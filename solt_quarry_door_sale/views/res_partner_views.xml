<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <!-- Inherit Form View to Modify it -->
        <record id="specs_hide_field_res_partner_form_inherit" model="ir.ui.view">
            <field name="name">specs.res.partner.form.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='mobile']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//notebook//field[@name='child_ids']//form//field[@name='mobile']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

            </field>
        </record>

        <record id="specs_hide_field_view_partner_simple_form_inherit" model="ir.ui.view">
            <field name="name">specs.res.partner.simple.form.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_simple_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='mobile']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

            </field>
        </record>
    </data> 
</odoo>