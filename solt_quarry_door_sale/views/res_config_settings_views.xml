<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sale.specs</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block name="quotation_order_setting_container" position="after">
                <block title="Specs" id="specs_setting_container">
                    <setting id="specs_card_request_project"
                             help="Create Card Request in the Project app">
                        <field name="module_solt_quarry_door_specs_project" class="o_light_label"/>
                    </setting>
                    <setting id="specs_card_request_project" help="Create Card Request in the Helpdesk app">
                        <field name="module_solt_quarry_door_specs_helpdesk" class="o_light_label"/>
                    </setting>
                    <setting id="specs_sale_company"
                             help="Company to use for the calculation of the price of the specs">
                        <field name="specs_sale_company_id" class="o_light_label"/>
                    </setting>
                    <setting id="specs_cost_company" help="Company to use for the calculation of the cost of the specs">
                        <field name="specs_cost_company_id" class="o_light_label"/>
                    </setting>
                    <setting id="specs_deadbolt_categ" help="Category to group the deadbolt products for the Specs">
                        <field name="specs_deadbolt_categ_id" class="o_light_label"/>
                    </setting>
                </block>
            </block>
        </field>
    </record>

</odoo>
