<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_specs" model="ir.actions.report">
        <field name="name">Spec</field>
        <field name="model">specs.sale</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">solt_quarry_door_sale.report_specs</field>
        <field name="report_file">solt_quarry_door_sale.report_specs</field>
        <field name="print_report_name">'Spec - %s' % (object.sequence_name)</field>
        <field name="binding_model_id" ref="model_specs_sale"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_sale_purchase_agreement" model="ir.actions.report">
        <field name="name">Purchase Agreement</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">solt_quarry_door_sale.report_sale_purchase_agreement</field>
        <field name="report_file">solt_quarry_door_sale.report_sale_purchase_agreement</field>
        <field name="print_report_name">'Purchase Agreement - %s' % (object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
