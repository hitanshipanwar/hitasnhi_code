<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_specs_document">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc.with_context(lang=doc.specs_sale_id.partner_id.lang)"/>
            <t t-set="address">
                <div t-if="doc.specs_sale_id.partner_id" t-field="doc.specs_sale_id.partner_id"
                     t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
            </t>
            <t t-set="information_block">
                <t t-if="doc.specs_sale_id.warehouse_id">
                    <strong>Warehouse Address:</strong>
                    <div t-if="doc.specs_sale_id.warehouse_id and not doc.specs_sale_id.warehouse_id.partner_id"
                         t-field="doc.specs_sale_id.warehouse_id"/>
                    <div t-if="doc.specs_sale_id.warehouse_id and doc.specs_sale_id.warehouse_id.partner_id"
                         t-field="doc.specs_sale_id.warehouse_id.partner_id"
                         t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
                </t>
            </t>
            <t t-set="field_ui_invisible" t-value="doc.field_ui_invisible"/>
            <div class="page">

                <h5 class="mt-0">General</h5>
                <div class="row mt-0 mb-0" id="general_informations">
                    <div class="col-auto col-6 mw-100 mb-0">
                        <span><strong>Product Type:</strong></span>
                        <span class="m-0" t-field="doc.specs_product_type_id">Single Door Product</span><br/>
                        <span><strong>Product Family:</strong></span>
                        <span class="m-0" t-field="doc.specs_product_id"/><br/>
                        <span><strong>Setup:</strong></span>
                        <span class="m-0" t-field="doc.specs_dc_id"/><br/>
                        <span><strong>Unit id:</strong></span>
                        <span class="m-0" t-field="doc.unit_id"/>
                    </div>
                    <div
                            class="col-auto col-6 mw-100 mb-0"
                            name="specs_product_family">
                        <span><strong>Order No.:</strong></span>
                        <span class="m-0" t-field="doc.specs_sale_id">SO0000</span><br/>
                        <span><strong>Opportunity:</strong></span>
                        <span class="m-0" t-field="doc.specs_opportunity_name"/><br/>
                        <span><strong>Creation Date:</strong></span>
                        <span class="m-0" t-field="doc.creation_date" t-options='{"widget": "date"}'>
                            2023-12-31</span><br/>
                        <span><strong>Salesperson:</strong></span>
                        <span class="m-0" t-field="doc.salesman_id">Mitchell Admin</span>
                    </div>
                </div>
                <h5 class="mt-0">Header</h5>
                <div class="row mt-0 mb-0" id="header_informations_1">
                    <div class="col-auto col-6 mw-100 mb-0" name="informations_order">
                        <span><strong>Design:</strong></span>
                        <span class="m-0" t-field="doc.specs_design_id"/><br/>
                        <span><strong>Color:</strong></span>
                        <span class="m-0" t-field="doc.specs_color_id"/><br/>
                        <span><strong>Suffix:</strong></span>
                        <span class="m-0" t-field="doc.specs_suffix_id"/><br/>
                        <span><strong>Square meters:</strong></span>
                        <span class="m-0" t-field="doc.specs_mtrs"/>
                        <span t-field="doc.uom_id">m²</span><br/>
                        <span><strong>Square feet:</strong></span>
                        <span class="m-0" t-field="doc.specs_mtrs_uom_convert"/>
                        <span t-field="doc.specs_mtrs_uom_name">ft²</span><br/>
                        <span><strong>Door Width:</strong></span>
                        <span class="m-0" t-field="doc.specs_antmarc"/><br/>
                        <span><strong>Door Height:</strong></span>
                        <span class="m-0" t-field="doc.specs_altmarc"/><br/>
                        <span><strong>Handing:</strong></span>
                        <span class="m-0" t-if="doc.specs_handing_id" t-field="doc.specs_handing_id"/><br/>
                        <span><strong>Arch Type:</strong></span>
                        <span class="m-0" t-if="doc.specs_type_arc_id" t-field="doc.specs_type_arc_id"/><br/>
                        <span><strong>Leaf Width:</strong></span>
                        <span class="m-0" t-field="doc.specs_antleaft"/><br/>
                        <span><strong>Leaf Height:</strong></span>
                        <span class="m-0" t-field="doc.specs_altleaft"/><br/>
                        <span><strong>Tolerance Central:</strong></span>
                        <span class="m-0" t-if="doc.specs_tolcen" t-field="doc.specs_tolcen"/><br/>
                        <span><strong>Tolerance Sides:</strong></span>
                        <span class="m-0" t-if="doc.specs_tollat" t-field="doc.specs_tollat"/><br/>
                        <span><strong>Crate:</strong></span>
                        <span class="m-0" t-if="doc.specs_huacal" t-field="doc.specs_huacal"/><br/>
                    </div>
                    <div class="col-auto col-6 mw-100 mb-0">
                        <span><strong>Total Width:</strong></span>
                        <span class="m-0" t-field="doc.specs_total_ant"/><br/>
                        <span><strong>Total Height:</strong></span>
                        <span class="m-0" t-field="doc.specs_total_alt"/><br/>
                        <span><strong>WroughtIron:</strong></span>
                        <span class="m-0" t-if="doc.specs_forging_id" t-field="doc.specs_forging_id"/><br/>
                        <span><strong>W/I operable:</strong></span>
                        <span class="m-0" t-if="doc.specs_operable" t-field="doc.specs_operable"/><br/>
                        <span><strong>Stile Width:</strong></span>
                        <span class="m-0" t-field="doc.specs_bast"/>
                        <span><strong>Stile Depth:</strong></span>
                        <span class="m-0" t-field="doc.specs_porfbast"/><br/>
                        <span><strong>Arch Raise:</strong></span>
                        <span class="m-0" t-if="doc.specs_altarc" t-field="doc.specs_altarc"/><br/>
                        <span><strong>Tolerance Top:</strong></span>
                        <span class="m-0" t-if="doc.specs_tolsup" t-field="doc.specs_tolsup"/><br/>
                        <span><strong>Bottom Panel:</strong></span>
                        <span class="m-0" t-if="doc.specs_board_id" t-field="doc.specs_board_id"/><br/>
                        <span><strong>Bottom Panel Height:</strong></span>
                        <span class="m-0" t-field="doc.specs_altboard"/><br/>
                        <span><strong>Fixed Glass:</strong></span>
                        <span class="m-0" t-if="doc.specs_fixed_glass" t-field="doc.specs_fixed_glass"/><br/>
                        <span><strong>Door Glass Type:</strong></span>
                        <span class="m-0" t-if="doc.specs_type_glass_id" t-field="doc.specs_type_glass_id"/><br/>
                        <span><strong>Rail Top Width:</strong></span>
                        <span class="m-0" t-if="doc.specs_mbas" t-field="doc.specs_mbas"/><br/>
                        <span><strong>Rail Bottom Width:</strong></span>
                        <span class="m-0" t-if="doc.specs_mbai" t-field="doc.specs_mbai"/><br/>
                    </div>
                </div>

                <div class="row mt-0 mb-0" id="fram_info">
                    <div class="col-auto col-6 mw-100 mb-0">
                        <h5 class="mt-0">Frame</h5>
                        <span><strong>Frame Width:</strong></span>
                        <span class="m-0" t-field="doc.specs_ancmarc"/><br/>
                        <span><strong>Frame Depth:</strong></span>
                        <span class="m-0" t-field="doc.specs_profmarc"/><br/>
                        <span><strong>Hinge Quantity:</strong></span>
                        <span class="m-0" t-field="doc.specs_amount_hinges"/><br/>
                        <span><strong>FrameBrickmoldInt:</strong></span>
                        <span class="m-0" t-if="doc.specs_molding_int_id" t-field="doc.specs_molding_int_id"/><br/>
                        <span><strong>FrameOverlapInt:</strong></span>
                        <span class="m-0" t-if="doc.specs_traslape_int_id" t-field="doc.specs_traslape_int_id"/><br/>
                        <span><strong>Anchors:</strong></span>
                        <span class="m-0" t-if="doc.specs_anchor_id" t-field="doc.specs_anchor_id"/><br/>
                        <span><strong>Hinges:</strong></span>
                        <span class="m-0" t-if="doc.specs_hinges_id" t-field="doc.specs_hinges_id"/><br/>
                        <span><strong>FrameBrickmoldExt:</strong></span>
                        <span class="m-0" t-if="doc.specs_molding_ext_id" t-field="doc.specs_molding_ext_id"/><br/>
                        <span><strong>FrameOverlapExt:</strong></span>
                        <span class="m-0" t-if="doc.specs_traslape_ext_id" t-field="doc.specs_traslape_ext_id"/><br/>
                    </div>
                    <div class="col-auto col-6 mw-100 mb-0">
                        <h5 class="mt-0">Pull Handles and Deadbolt</h5>
                        <span><strong>PH Act-Ext:</strong></span>
                        <span class="m-0" t-field="doc.specs_jac_id" t-if="doc.specs_jac_id"/><br/>
                        <span><strong>PH Act-Int:</strong></span>
                        <span class="m-0" t-field="doc.specs_jacin_id" t-if="doc.specs_jacin_id"/><br/>
                        <span><strong>PH Inac-Ext:</strong></span>
                        <span class="m-0" t-if="doc.specs_jin_id" t-field="doc.specs_jin_id"/><br/>
                        <span><strong>PH Inac-Int:</strong></span>
                        <span class="m-0" t-if="doc.specs_jinin_id" t-field="doc.specs_jinin_id"/><br/>
                        <span><strong>Preparation:</strong></span>
                        <span class="m-0" t-field="doc.specs_pch_id" t-if="doc.specs_pch_id"/><br/>
                        <span><strong>Deadbolt Type:</strong></span>
                        <span class="m-0" t-field="doc.specs_moce_id" t-if="doc.specs_moce_id"/><br/>
                        <span><strong>Deadbolt Height:</strong></span>
                        <span class="m-0" t-field="doc.specs_altce" t-if="doc.specs_altce"/><br/>
                        <span><strong>Roller Latches:</strong></span>
                        <span class="m-0" t-if="doc.specs_rlat" t-field="doc.specs_rlat"/><br/>
                        <span><strong>Ball Catches:</strong></span>
                        <span class="m-0" t-if="doc.specs_bac" t-field="doc.specs_bac"/><br/>
                    </div>
                </div>
                <div class="row mt-0 mb-0" id="transom_info">
                    <div class="col-auto col-6 mw-100 mb-0">
                        <h5 class="mt-0">Transom</h5>
                        <span><strong>Arch Type in Transom:</strong></span>
                        <span class="m-0" t-field="doc.specs_tyarct_id" t-if="doc.specs_tyarct_id"/><br/>
                        <span><strong>Transom Arch Raise:</strong></span>
                        <span class="m-0" t-field="doc.specs_taltarc" t-if="doc.specs_taltarc"/><br/>
                        <span><strong>Transom Width:</strong></span>
                        <span class="m-0" t-if="doc.specs_antra" t-field="doc.specs_antra"/><br/>
                        <span><strong>Transom Height:</strong></span>
                        <span class="m-0" t-if="doc.specs_altra" t-field="doc.specs_altra"/><br/>
                        <span><strong>Transom Double Frame:</strong></span>
                        <span class="m-0" t-field="doc.specs_ddm" t-if="doc.specs_ddm"/><br/>
                        <span><strong>Transom Glass Type:</strong></span>
                        <span class="m-0" t-field="doc.specs_typet_glass_id" t-if="doc.specs_typet_glass_id"/><br/>

                    </div>
                    <div class="col-auto col-6 mw-100 mb-0">
                        <h5 class="mt-0">Sidelight</h5>
                        <span><strong>Sidelight Width:</strong></span>
                        <span class="m-0" t-field="doc.specs_anfi" t-if="doc.specs_anfi"/><br/>
                        <span><strong>Sidelight Height:</strong></span>
                        <span class="m-0" t-field="doc.specs_alfi" t-if="doc.specs_alfi"/><br/>
                        <span><strong>Sidelight Bottom Panel Type:</strong></span>
                        <span class="m-0" t-if="doc.specs_board_type_id" t-field="doc.specs_board_type_id"/><br/>
                        <span><strong>Sidelight Bottom Panel Height:</strong></span>
                        <span class="m-0" t-if="doc.specs_saltboard_type" t-field="doc.specs_saltboard_type"/><br/>
                        <span><strong>Sidelight Glass Fixed:</strong></span>
                        <span class="m-0" t-field="doc.specs_sidelight_glassf" t-if="doc.specs_sidelight_glassf"/><br/>
                        <span><strong>Sidelight Glass Type:</strong></span>
                        <span class="m-0" t-field="doc.specs_typef_glass_id" t-if="doc.specs_typef_glass_id"/><br/>
                        <span><strong>Sidelight Double Frame:</strong></span>
                        <span class="m-0" t-if="doc.specs_ddmf" t-field="doc.specs_ddmf"/><br/>
                        <span><strong>Sidelight Position:</strong></span>
                        <span class="m-0" t-if="doc.specs_posfi_id" t-field="doc.specs_posfi_id"/><br/>
                    </div>
                </div>
                <div class="row mt-0 mb-0" id="latch_info">
                    <div class="col-auto col-6 mw-100 mb-0">
                        <h5 class="mt-0">Latch</h5>
                        <span><strong>Upper latch:</strong></span>
                        <span class="m-0" t-field="doc.specs_latchsup_id" t-if="doc.specs_latchsup_id"/><br/>
                        <span><strong>Qty Upper latch:</strong></span>
                        <span class="m-0" t-field="doc.specs_cls" t-if="doc.specs_cls"/><br/>
                        <span><strong>Lower latch:</strong></span>
                        <span class="m-0" t-if="doc.specs_latchin_id" t-field="doc.specs_latchin_id"/><br/>
                        <span><strong>Qty Lower latch:</strong></span>
                        <span class="m-0" t-if="doc.specs_cli" t-field="doc.specs_cli"/><br/>
                    </div>
                    <div class="col-auto col-6 mw-100 mb-0">
                        <h5 class="mt-0">Installation Items</h5>
                        <span><strong>Threshold tolerance:</strong></span>
                        <span class="m-0" t-field="doc.specs_tolerance" t-if="doc.specs_tolerance"/><br/>
                        <span><strong>Threshold Type:</strong></span>
                        <span class="m-0" t-field="doc.specs_typeguar_id" t-if="doc.specs_typeguar_id"/><br/>
                        <span><strong>Flashing/Sill Pan:</strong></span>
                        <span class="m-0" t-if="doc.specs_flashing_id" t-field="doc.specs_flashing_id"/><br/>
                        <span><strong>Assembly Preparation:</strong></span>
                        <span class="m-0" t-if="doc.specs_assembly_id" t-field="doc.specs_assembly_id"/><br/>
                    </div>
                </div>

                <!-- Glass Specifications -->
                <h5 class="mt-0">
                    <span>Glass Specifications</span>
                </h5>
                <t t-set="lines_to_report" t-value="doc.specs_glass_line_ids"/>
                <t t-set="specs_hardware_line_ids" t-value="doc.specs_hardware_line_ids"/>
                <table class="table table-sm o_main_table table-borderless mt-0" id="table_glass_line">
                    <!-- In case we want to repeat the header, remove "display: table-row-group" -->
                    <thead style="display: table-row-group">
                        <tr>
                            <th name="th_glass_piece_id" class="text-start">ID Glass Piece</th>
                            <th name="th_handing_glass_id" class="text-start">Handing Glass</th>
                            <th name="th_glass_type_id" class="text-start">Glass type</th>
                            <th name="th_radius_id" class="text-start">Radius</th>
                            <th name="th_glass_width" class="text-end">Width</th>
                            <th name="th_glass_height" class="text-end">Height</th>
                            <th name="th_glass_qty" class="text-end">
                                <span>Quantity</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="sale_tbody">

                        <t t-set="current_subtotal" t-value="0"/>

                        <t t-foreach="lines_to_report" t-as="line">
                            <tr>
                                <td name="td_glass_piece_id"><span t-field="line.glass_piece_id"/></td>
                                <td name="td_handing_glass_id"><span t-field="line.handing_glass_id"/></td>
                                <td name="td_glass_type_id"><span t-field="line.glass_type_id"/></td>
                                <td name="td_radius_id"><span t-field="line.radius_id"/></td>
                                <td name="td_glass_width" class="text-end">
                                    <span t-field="line.glass_width">3</span>
                                </td>
                                <td name="td_glass_height" class="text-end">
                                    <span t-field="line.glass_height">-</span>
                                </td>
                                <td name="td_glass_qty" class="text-end">
                                    <span t-field="line.glass_qty">3</span>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
                <h5 class="mt-0">
                    <span>Accessories, HW, Special preparations</span>
                </h5>
                <table class="table table-sm o_main_table table-borderless mt-0" id="table_hardware">
                    <!-- In case we want to repeat the header, remove "display: table-row-group" -->
                    <thead style="display: table-row-group">
                        <tr>
                            <th name="th_hardware_id" class="text-start">Products</th>
                            <th name="th_include_in_spec_price" class="text-start">Include in spec price</th>
                            <th name="th_amount" class="text-end">
                                <span>Quantity</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="sale_tbody">
                        <t t-set="current_subtotal" t-value="0"/>

                        <t t-foreach="specs_hardware_line_ids" t-as="line">
                            <tr>
                                <td name="td_hardware_id"><span t-field="line.hardware_id"/></td>
                                <t t-if="td_include_in_spec_price">
                                    <span>Si</span>
                                </t>
                                <t t-else="">
                                    <span>No</span>
                                </t>
                                <td name="td_amount" class="text-end">
                                    <span t-field="line.amount">3</span>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
                <div>
                    <span t-field="doc.description"
                          t-attf-style="#{'text-align:justify;text-justify:inter-word;' if doc.description else ''}"
                          name="spec_description"/>
                </div>
            </div>
        </t>
    </template>

    <template id="report_specs">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="solt_quarry_door_sale.report_specs_document" t-lang="doc.specs_sale_id.partner_id.lang"/>
            </t>
        </t>
    </template>

    <!--  Purchase Agreement  -->
    <template id="report_sale_purchase_agreement_document">
        <t t-set="o" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
        <t t-set="company" t-value="o.company_id.sudo()"/>
        <div class="page">
            <div class="header">
                <div class="o_background_header">
                    <div class="float-end">
                        <div class="mt0 text-end h3">
                            <h4>Purchase Agreement</h4>
                            <table class="table table-bordered" style="font-size: 0.90rem;">
                                <thead>
                                    <tr>
                                        <th class="text-center">Date</th>
                                        <th class="text-center">Estimate #</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td class="text-start"><span
                                                t-esc="context_timestamp(datetime.datetime.now()).strftime('%m/%d/%Y')"/></td>
                                        <td><t t-esc="o.name" t-if="o"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" class="float-start" alt="Logo"/>
                    <div class="float-start company_address">
                        <ul class="list-unstyled" name='company_address_list'>
                            <li t-if="company.is_company_details_empty"><span t-field="company.partner_id"
                                                                              t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'>
                                <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-4 w-100 opacity-75 text-muted text-center">
                                    <strong>Company address block</strong>
                                    <div>Contains the company address.</div>
                                </div>
                            </span></li>
                            <li t-else="">
                                <span t-field="company.company_details">
                                    <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-4 w-100 opacity-75 text-muted text-center">
                                        <strong>Company details block</strong>
                                        <div>Contains the company details.</div>
                                    </div>
                                </span>
                            </li>
                            <li t-if="not forced_vat"/>
                            <li t-else="">
                                <t t-esc="company.country_id.vat_label or 'Tax ID'">Tax ID</t>:
                                <span t-esc="forced_vat">US12345671</span>
                            </li>
                        </ul>
                    </div>
                    <div class="clearfix mb8"/>
                    <div class="row mt-0 mb8" style="font-size: 0.90rem;">
                        <div class="col-auto col-6 mw-100 mb-0">
                            <span><strong>Name/Address:</strong></span>
                            <span class="m-0" t-field="o.partner_id.contact_address_inline"
                                  t-if="o and o.partner_id"/><br/>
                        </div>
                        <div class="col-auto col-6 mw-100 mb-0">
                            <span><strong>Project:</strong></span>
                            <span class="m-0" t-field="o.opportunity_id" t-if="o and o.opportunity_id"/><br/>
                            <span><strong>Rep:</strong></span>
                            <span class="m-0" t-field="o.user_id" t-if="o and o.user_id"/><br/>
                        </div>
                    </div>
                </div>
            </div>
            <div id="body" class="article o_report_layout_striped o_report_layout_background"
                 t-attf-style="background-image: url({{ 'data:image/png;base64,%s' % company.layout_background_image.decode('utf-8') if company.layout_background_image and company.layout_background == 'Custom' else '/base/static/img/bg_background_template.jpg' if company.layout_background == 'Geometric' else ''}});"
                 t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id"
                 t-att-data-oe-lang="o and o.env.context.get('lang')">
                <div class="row mt-2">
                    <table class="table table-striped" style="font-size:0.90rem;">
                        <tr>
                            <td>Please read carefully before signing.</td>
                        </tr>
                        <tr>
                            <td>
                                <span class="text-center">All Doors are made out of Steel unless specified on Estimate</span><br/>
                                <span class="text-start">I. ORDER PLACEMENT:</span><br/>
                                <span class="text-start">Doors will not be ordered until a signed Purchase Agreement, a signed CAD Drawing, a signed Estimate with ALL order information and a 50%
Deposit (non refundable) are received by Cantera Doors. Upon signing, purchaser affirms that all information on the Estimate and CAD drawings are
correct and accurate. Any changes after signing the Purchase Agreement may incur additional costs and delays.</span>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <span class="text-start">II. BILLING/PAYMENT:</span><br/>
                                <span class="text-start">Payments will be scheduled as follows:</span><br/>
                                <span class="text-start">Shipped/Customer Pick-up Orders:</span><br/>
                                <ol class="s mb-0" style="line-height: 90%;">
                                  <li>Invoice I – 50% deposit (non refundable) to place all orders, in the form of a check or credit card payment.</li>
