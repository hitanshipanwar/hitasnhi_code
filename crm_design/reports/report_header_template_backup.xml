        <div t-attf-class="header o_company_#{company.id}_layout" t-att-style="report_header_style">
            <div class="row" style="border-bottom:1.5px solid #656264;padding-bottom:12px;">
                <div class="col-7">
                    <div class="img">
                        <img style="height:80px;width:60%;margin-top:0px;" src='/crm_design/static/img/header_logo.png'>
                        </img> 
                    </div>
                </div>
                <div class="col-5" style="padding-top:3px;margin-left:70px;">
                     <h5 style="line-height: 0.8;font-weight:500;"><div t-if='request.env.company.name' t-esc="request.env.company.name.upper()"/></h5>
                            <span style="color:#989798;font-size:14px;line-height: 1.4;font-weight:500;">
                                <t t-if='request.env.company.street' t-esc="request.env.company.street.upper()" style="color:#989798;font-size:15px;"/> 
                                <t t-if='request.env.company.street2' t-esc="request.env.company.street2.upper()" style="color:#989798;font-size:15px;"/>
                                <span style="color:#989798;font-size:15px;">, </span><t t-if='request.env.company.city' t-esc="request.env.company.city.upper()" style="color:#989798;font-size:15px;"/> <br/>
                                <t t-if='request.env.company.state_id.name' t-esc="request.env.company.state_id.name.upper()" style="color:#989798;font-size:15px;"/>
                                <t t-if='request.env.company.zip' t-esc="request.env.company.zip" style="color:#989798;font-size:15px;"/> 
                                <t t-if='request.env.company.country_id.name' t-esc="request.env.company.country_id.name.upper()" style="color:#989798;font-size:15px;"/><br/>
                                <span style="color:#989798;font-size:15px;">TEL.</span><t t-if='request.env.company.phone' t-esc="request.env.company.phone" style="color:#989798;font-size:15px;"/><span style="color:#989798;font-size:15px;">  FAX.</span><t t-if='request.env.company.mobile' t-esc="request.env.company.mobile" style="color:#989798;font-size:15px;"/><br/>
                            </span>         
                            <!-- <span style="font-weight:500;font-size:14px;">TAX ID. </span><t t-if='request.env.company.vat' t-esc="request.env.company.vat.upper()" style="font-weight:500;font-size:14px;"/><span style="font-weight:500;font-size:14px;"> (HEAD OFFICE)</span> -->
                            <span style="font-weight:500;font-size:14px;">TAX ID. <t t-if='request.env.company.vat' t-esc="request.env.company.vat.upper()"/> (HEAD OFFICE)</span>
                </div>
