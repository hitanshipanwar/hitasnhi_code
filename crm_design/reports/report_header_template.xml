                                <t t-if='request.env.company.zip' t-esc="request.env.company.zip" style="color:#989798;font-size:13px;"/> 
                                <t t-if='request.env.company.country_id.name' t-esc="request.env.company.country_id.name.upper()" style="color:#989798;font-size:13px;"/>&#160;  <br/>
                                <span style="color:#989798;font-size:13px;">TEL.&#160; </span><t t-if='request.env.company.phone' t-esc="request.env.company.phone" style="color:#989798;font-size:13px;"/><span style="color:#989798;font-size:13px;">&#160;</span><t t-if='request.env.company.mobile' t-esc="request.env.company.mobile" style="color:#989798;font-size:15px;"/><br/> 
                            </span>         
