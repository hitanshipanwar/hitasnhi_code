<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>
		<record id="paperformat_label_shekf_talker" model="report.paperformat">
            <field name="name">Product Label Sheet</field>
            <field name="default" eval="True" />
            <field name="format">custom</field>
            <field name="page_height">70</field>
            <field name="page_width">40</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">0</field>
            <field name="margin_bottom">0</field>
            <field name="margin_left">0</field>
            <field name="margin_right">0</field>
            <field name="disable_shrinking" eval="True"/>
            <field name="dpi">96</field>
        </record>

        <record id="report_product_template_shelf_talker" model="ir.actions.report">
            <field name="name">Product Label (PDF)</field>
            <field name="model">product.template</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">crm_design.report_shelf_talker</field>
            <field name="report_file">crm_design.report_shelf_talker</field>
            <field name="paperformat_id" ref="crm_design.paperformat_label_shekf_talker"/>
            <field name="print_report_name">'Products Labels - %s' % (object.name)</field>
            <field name="binding_type">report</field>
        </record>
	</data>
</odoo>
