<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>
		<template id="journal_item_pdf_view">
        <t t-call="web.external_layout">
                <t t-set="o" t-value="o.with_context(lang=lang)" />
                <t t-set="forced_vat" t-value="o.fiscal_position_id.foreign_vat"/> <!-- So that it appears in the footer of the report instead of the company VAT if it's set -->
                <div class="row">
                    <t t-if="o.partner_shipping_id and (o.partner_shipping_id != o.partner_id)">
                        <div class="col-6">
                            <t t-set="information_block">
                                <div groups="account.group_delivery_invoice_address" name="shipping_address_block">
                                    <strong>Shipping Address:</strong>
                                    <div t-field="o.partner_shipping_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                                </div>
                            </t>
                        </div>
                        <div class="col-6" name="address_not_same_as_shipping">
                            <t t-set="address">
                                <address class="mb-0" t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                                <div t-if="o.partner_id.vat">
                                    <t t-if="o.company_id.account_fiscal_country_id.vat_label" t-esc="o.company_id.account_fiscal_country_id.vat_label" id="inv_tax_id_label"/>
                                    <t t-else="">Tax ID</t>: <span t-field="o.partner_id.vat"/>
                                </div>
                            </t>
                        </div>
                    </t>
                    <t t-elif="o.partner_shipping_id and (o.partner_shipping_id == o.partner_id)">
                        <div class="offset-col-6 col-6" name="address_same_as_shipping">
                        <t t-set="address">
                            <address class="mb-0" t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                            <div t-if="o.partner_id.vat">
                                <t t-if="o.company_id.account_fiscal_country_id.vat_label" t-esc="o.company_id.account_fiscal_country_id.vat_label" id="inv_tax_id_label"/>
                                <t t-else="">Tax ID</t>: <span t-field="o.partner_id.vat"/>
                            </div>
                        </t>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="offset-col-6 col-6" name="no_shipping">
                        <t t-set="address">
                            <address class="mb-0" t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                            <div t-if="o.partner_id.vat">
                                <t t-if="o.company_id.account_fiscal_country_id.vat_label" t-esc="o.company_id.account_fiscal_country_id.vat_label" id="inv_tax_id_label"/>
                                <t t-else="">Tax ID</t>: <span t-field="o.partner_id.vat"/>
                            </div>
                        </t>
                        </div>
                    </t>
                </div>
                <div class="mt-5">
                    <div class="page">
                        <h2>
                            <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Invoice</span>
                            <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">Draft Invoice</span>
                            <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Cancelled Invoice</span>
                            <span t-if="o.move_type == 'out_refund'">Credit Note</span>
                            <span t-if="o.move_type == 'in_refund'">Vendor Credit Note</span>
                            <span t-if="o.move_type == 'in_invoice'">Vendor Bill</span>
                            <span t-if="o.name != '/'" t-field="o.name"/>
                        </h2>

                        <div id="informations" class="row mt-4 mb-4">
                            <div class="col-auto col-3 mw-100 mb-2" t-if="o.invoice_date" name="invoice_date">
                                <t t-if="o.move_type == 'out_invoice'"><strong>Invoice Date:</strong></t>
                                <t t-elif="o.move_type == 'in_invoice'"><strong>Bill  Date:</strong></t>
                                <t t-elif="o.move_type == 'out_refund'"><strong>Credit Note Date:</strong></t>
                                <t t-elif="o.move_type == 'out_receipt'"><strong>Receipt Date:</strong></t>
                                <t t-else=""><strong>Date:</strong></t>
                                <p class="m-0" t-field="o.invoice_date"/>
                            </div>
                            <div class="col-auto col-3 mw-100 mb-2" t-if="o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted'" name="due_date">
                                <strong>Due Date:</strong>
                                <p class="m-0" t-field="o.invoice_date_due"/>
                            </div>
                            <div class="col-auto col-3 mw-100 mb-2" t-if="o.date and o.move_type == 'in_invoice'" name="due_date">
                                <strong>Accounting Date:</strong>
                                <p class="m-0" t-field="o.date"/>
                            </div>
                            <div class="col-auto col-3 mw-100 mb-2" t-if="o.invoice_origin" name="origin" style="text-align:left;">
                                <strong>Source:</strong>
                                <p class="m-0" t-field="o.invoice_origin"/>
                            </div>
                            <div class="col-auto col-3 mw-100 mb-2" t-if="o.payment_reference and o.move_type == 'in_invoice'" name="reference">
                                <strong>Payment Reference:</strong>
                                <p class="m-0" t-field="o.payment_reference"/>
                            </div>
                            <div class="col-auto col-3 mw-100 mb-2" t-if="o.partner_bank_id and o.move_type == 'in_invoice'" name="bank">
                                <strong>Recipient Bank:</strong>
                                <p class="m-0" t-field="o.payment_reference"/>
                            </div>
                            <div class="col-auto col-3 mw-100 mb-2" t-if="o.invoice_payment_term_id and o.move_type == 'in_invoice'" name="payment_terms">
                                <strong>Payment Terms:</strong>
                                <p class="m-0" t-field="o.invoice_payment_term_id.name"/>
                            </div>
                            <div class="col-auto col-3 mw-100 mb-2" t-if="o.partner_id.ref" name="customer_code">
                                <strong>Customer Code:</strong>
                                <p class="m-0" t-field="o.partner_id.ref"/>
                            </div>
                            <div class="col-auto col-3 mw-100 mb-2" t-if="o.ref" name="reference">
                                <strong>Reference:</strong>
                                <p class="m-0" t-field="o.ref"/>
                            </div>
                        </div>
                    </div>
                </div>
                <table class="table table-sm o_main_table" name="invoice_line_table">
	                <thead style="display: table-row-group;border-top:2px solid;">
	                    <tr>
	                        <th name="th_description" class="text-start" style="width:35%;"><span>Account</span></th>
	                        <th name="th_quantity" class="text-start"><span>Label</span></th>
	                       	<th name="th_quantity" class="text-start"><span>Debit</span></th>
	                       	<th name="th_quantity" class="text-start"><span>Credit</span></th>
	                       	<!-- <th name="th_quantity" class="text-start"><span>Taxes</span></th> -->
	                    </tr>
	                </thead>
	                <tbody class="invoice_tbody" style="border-bottom:2px solid;">
	                    <t t-set="debit_total" t-value="0"/>
	                    <t t-set="credit_total" t-value="0"/>
	                    <t t-set="lines" t-value="o.line_ids"/>
	                    <t t-foreach="lines" t-as="line">
	                        <t t-set="debit_total" t-value="debit_total + line.debit"/>
	                        <t t-set="credit_total" t-value="credit_total + line.credit"/>
	                        <tr t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
	                            <td name="account_invoice_line_name"><span t-field="line.account_id"/></td>
	                            <td name="account_invoice_line_name"><span t-field="line.name"/></td>
	                            <td name="account_invoice_line_name"><span t-field="line.debit"/></td>
	                            <td name="account_invoice_line_name"><span t-field="line.credit"/></td>
	                            <!-- <td name="account_invoice_line_name"><span t-field="line.tax_ids"/></td> -->
	                        </tr>
	                    </t>
	                    <tr class="is-subtotal text-end">
	                    	<td class="text-start"><strong>Total</strong></td>
	                    	<td></td>
                            <td class="text-start">
                                <strong><span t-esc="debit_total"/></strong>
                            </td>
                        	<td class="text-start"><strong><span t-esc="credit_total"/></strong></td>
                        	<td>
                        	</td>
                        </tr>
	                </tbody>
	            </table>
                <t t-if="o.move_type == 'in_invoice'">
                    <div class="footer">
                        <div class="last-page" style="position:relative;font-size:12px;margin-top:0;">
                        <table style="border-collapse: collapse; width: 100%; border:none !important; width:100%;height:20px;" border="0">
                        <tbody style="border:none !important;">
                        <tr style="border:none !important;">
                        <td style="width: 16.6667%; border:none !important; font-size: 20px;">Prepared By:</td>
                          <td style="color:black; width: 16.6667%; text-align:right;border:none !important;"><b><hr style="width:80%;,text-align:right; color:black; position:relative;top:20px;"></hr></b></td>
                        <td style="width: 16.6667%; border:none !important; font-size: 20px;">Checked By:</td>
                        <td style="color:black; width: 16.6667%; border:none !important;"><b><hr style="width:80%;,text-align:right; color:black; position:relative;top:20px;"></hr></b></td>
                        <td style="width: 16.6667%; border:none !important; font-size: 20px;">Approved By:</td>
                        <td style="color:black; width: 16.6667%; border:none !important;"><b><hr style="width:80%;,text-align:right; color:black; position:relative;top:20px;"></hr></b></td>
                        </tr>
                        </tbody>
                        </table>
                        </div>
                        <div class="text-center">
                <div class="row">
                    <div style="width:29%;border-top:1px solid rgb(27, 27, 27); margin-top:25px;"></div>
                    <div style="width:42%;">
                        <h5 style="font-weight:600;font-size:25px;" >
                            <b>
                                <div t-if='request.env.company.thai_add' t-field="request.env.company.thai_add"/>
                                <div t-else=''>
                                    <span>บริษัท สยาม อาร์ต มาร์เบิล จำกัด</span>
                                </div>
                            </b>
                        </h5>
                    </div>
                    <div style="width:29%;border-top:1px solid rgb(27, 27, 27); margin-top:25px;"></div>
                </div>
                <div class="row">
                    <div class="col-2">
                        <div class="img">
                            <img style="height:60px;width:60px;margin-top:10px;margin-left:-60px;" src='/crm_design/static/img/lavaredo_logo_orange.png'>
                            </img> 
                        </div>
                    </div>
                    <div class="col-8" style="font-size:14px;color:black;width:60%;">
                        <t>        
                            <span>      
                            <t t-if='request.env.company.thai_street1' t-esc="request.env.company.thai_street1" />
                                <t t-else=''>13/6 หมู่19&#160;</t>
                                <t t-if='request.env.company.thai_street2' t-esc="request.env.company.thai_street2"/>
                                <t t-else=''>ต.บางพลีใหญ่&#160;</t>
                            <t t-if='request.env.company.thai_city' t-esc="request.env.company.thai_city"/>
                                <t t-else=''>อ.บางพลี&#160;</t> 
                        
                            <t t-if='request.env.company.thai_state' t-esc="request.env.company.thai_state"/>
                                <t t-else=''>จ.สมุทรปราการ&#160;</t>
                                
                            <t t-if='request.env.company.zip' t-esc="request.env.company.zip"/>
                                <t t-else=''>1054&#160;</t>
                            
                            <t t-if='request.env.company.thai_country' t-esc="request.env.company.thai_country"/>
                                <t t-else=''>ประเทศไทย&#160;</t>
                            <br/>
                            <span>โทร&#160;</span><t t-if='request.env.company.phone' t-esc="request.env.company.phone"/>&#160;<t t-if='request.env.company.mobile' t-esc="request.env.company.mobile"/>
                            <br/>
                            </span>
                            <b>หมายเลขประจำตัวผู้เสียภาษี&#160;<t t-if='request.env.company.vat' t-esc="request.env.company.vat"/>&#160;(สำนักงานใหญ่)</b>
                        </t>
                    </div>
                    <div class="col-2 pr-0">
                        <img style="height:60px;width:60px;margin-top:10px;margin-right:-200px;" src='/crm_design/static/img/lavaredo_qr.jpg'>
                            </img>
                    </div>
                </div>
            </div>
                    </div>
                </t>
            </t>
    </template>

    <template id="journal_item_template_pdf_view">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang"/>
                <t t-call="crm_design.journal_item_pdf_view" t-lang="lang"/>
            </t>
        </t>
    </template>

    <record id="journal_itme_pdf_report_menu" model="ir.actions.report">
        <field name="name">Journal Items</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">crm_design.journal_item_template_pdf_view</field>
        <field name="report_file">crm_design.journal_item_template_pdf_view</field>
        <field name="print_report_name">Journal Items</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
    </record>
    
	</data>
</odoo>