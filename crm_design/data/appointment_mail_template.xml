<?xml version="1.0" encoding="UTF-8"?>
<odoo>
     <data>
          <record id="appointment_email_template" model="mail.template">
               <field name="name">Appointment Email Template</field>
               <field name="model_id" ref="crm_design.model_appointment_visit"/>            
               <field name="auto_delete" eval="False"/>
               <field name="subject">Appointment For Visit</field>
               <field name="body_html"><![CDATA[
                    <p>Dear ${(object.visitor_id.name)},<br/><br/>
                    Good job, you've just created your first e-mail template!<br/></p>
                        Regards,<br/>
                        ${(object.company_id.name)} ]]>
               </field>
          </record>
     </data>
</odoo>