<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>
		<record id="view_payment_inv_inherit" model="ir.ui.view">
			<field name="name">view.payment.inv.inherit</field>
			<field name="model">account.payment.register</field>
			<field name="inherit_id" ref="account.view_account_payment_register_form"/>
        	<field name="arch" type="xml">
        		<xpath expr="//group[@name='group1']" position="inside">
        			<field name="invoice_payment_method" widget="radio" class="oe_inline"/>
        		</xpath>

        		<xpath expr="//label[@for='amount']" position="replace">
        			<label for="amount" attrs="{'invisible':[('invoice_payment_method','=','percentage')]}"/>
        		</xpath>
        		<xpath expr="//div[@name='amount_div']" position="replace">
        			<div name="amount_div" class="o_row" attrs="{'invisible': [('invoice_payment_method','=','percentage')]}">
	                    <field name="amount"/>
	                    <field name="currency_id"
	                           options="{'no_create': True, 'no_open': True}"
	                           groups="base.group_multi_currency"/>
                   	</div>
        		</xpath>

        		<xpath expr="//field[@name='payment_date']" position="before">
        			<label for="amount_in_percent" attrs="{'invisible':[('invoice_payment_method','=','fixed')]}"/>
        			<div name="amount_div" class="o_row" attrs="{'invisible': [('invoice_payment_method','=','fixed')]}">
	                    <field name="amount_in_percent"/>
	                    <span class="oe_inline">%</span>
                   	</div>
        		</xpath>
        	</field>
		</record>
	</data>
</odoo>