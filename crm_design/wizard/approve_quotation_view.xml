<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>
		<record id="approve_quotation_view_form" model="ir.ui.view">
	        <field name="name">approve.quotation.view.form</field>
	        <field name="model">approve.quotation.wizard</field>
	        <field name="arch" type="xml">
	        	<form string="Approve Quotation">
	        		<sheet>
	        			<group>
	        				<field name="digital_signature" widget="signature"/>
	        			</group>
	        		</sheet>
	        		<footer>
						<button name="approve_quotation_invoice" type="object" string="Approve" class="oe_highlight"/>
							or
						<button special="cancel" string="Cancel"/>
					</footer>
	        	</form>
	      	</field>
      	</record>
    </data>
</odoo>