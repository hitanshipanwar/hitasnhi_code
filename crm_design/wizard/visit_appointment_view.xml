<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>
		<record id="visit_appointment_view_form" model="ir.ui.view">
	        <field name="name">visit.appointment.view.form</field>
	        <field name="model">appointment.visit</field>
	        <field name="arch" type="xml">
	        	<form string="Appointment" create="false">
	        		<header>
		        		<field name="appointment_state" widget="statusbar" statusbar_visible="draft,confirm,validate,reject"/>
	        		</header>
	        		<sheet>

	        			<!-- <h2><field name="name" required="True" placeholder="Title"/></h2> -->
	        			<group>
	        				<group>
		        				<field name="is_visitor_login" invisible="1"/>
                                <field name="is_manager_login" invisible="1"/>
	        					<field name="customer_id" required="True" attrs="{'readonly': [('appointment_state', 'in', ('confirm','validate'))]}"/>

	        					<field name="visitor_id" required="True" attrs="{'readonly': [('appointment_state', 'in', ('confirm','validate')),('is_visitor_login','=',True)]}"/>
	        				</group>
	        				<group>
		        				<field name="appointment_date" required="True"/>
		        			</group>
		        			<group>
		        				<field name="visit_charge" attrs="{'readonly': [('appointment_state', 'in', ('confirm','validate'))]}"/>
		        				<field name="is_tax_included" attrs="{'readonly': [('appointment_state', 'in', ('confirm','validate'))]}"/>
		        			</group>
	        			</group>
	        			<notebook>
	        				<page string="Upload" attrs="{'invisible': [('appointment_state', 'in', ('draft','reject'))]}" >
		                        <field name="multi_attachments" widget="many2many_binary" string="Attach a file" nolabel="1" colspan="2" invisible="1"/>
		                        	<field name="multi_attachments_ids" >

		                            <tree delete="false">
		                                <field name="name" />
		                                <field name="create_uid" readonly="1" class="oe_inline" string="Uploaded By"/>
		                                <field name="create_date" readonly="1" class="oe_inline" string="Uploaded On" />
		                                <field name='datas' widget="binary" string='Download' filename="name"/>
		                                <!-- <button name="unlink"
		                                        type="object"
		                                        class="fa fa-trash-o"
		                                        attrs="{'invisible': [('approve_state', '!=', 'draft')]}"
		                                        aria-label="Delete row 1"
		                                        /> -->
		                            </tree>
                            <form string="Attachments">
                                
                               <sheet>
                                <label for="name"/>
                                <h1>
                                    <field name="name"/>
                                </h1>
                                <group>
                                    <group>
                                        

                                        <field name="type" invisible="1"/>
                                        <field name="datas" filename="name" options="{'accepted_file_extensions': '.pdf'}" />
                                        
                                        <field name="url" widget="url" attrs="{'invisible':[('type','=','binary')]}"/>
                                        <field name="mimetype" groups="base.group_no_one" invisible="1"/>

                                    </group>
                                    <group string="Attached To" groups="base.group_no_one" invisible="1">
                                        <field name="res_model"/>
                                        <field name="res_field"/>
                                        <field name="res_id"/>
                                        <field name="res_name"/>
                                        <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                                        <field name="public"/>
                                    </group>
                                    <group string="History" groups="base.group_no_one" attrs="{'invisible':[('create_date','=',False)]}" invisible="1">
                                        <label for="create_uid" string="Creation"/>
                                        <div name="creation_div">
                                            <field name="create_uid" readonly="1" class="oe_inline"/> on
                                            <field name="create_date" readonly="1" class="oe_inline"/>
                                        </div>
                                    </group>
                                    <group name="description_group" string="Description" groups="base.group_no_one"  colspan="4" invisible="1">
                                        <field name="description" nolabel="1"/>
                                    </group>
                                    <group groups="base.group_no_one" string="Indexed Content" colspan="4" invisible="1">
                                        <field name="index_content" nolabel="1"/>
                                    </group>
                                </group>
                              </sheet>
                            </form>
                        </field>
	        				</page>

	        				<page string="Notes" attrs="{'invisible': [('appointment_state', 'in', ('draft','reject'))]}">
	        					<field name="notes"/>
                    		</page>
                    		<page string="Design" attrs="{'invisible': [('appointment_state', 'in', ('draft','reject'))]}">
                    			<field name="attachment_ids" editable="bottom">
	                    			<tree delete="false">
			                            <field name="name" />
			                            <field name="create_uid" readonly="1" class="oe_inline" string="Uploaded By"/>
			                             <field name="share_design"/>
			                             <field name="is_approved" invisible="1"/>
			                             <field name="is_rejected" invisible="1"/>
			                             <field name="comment"/>
			                            <field name="is_final_design"/>
			                            <field name="customer_signature" widget="image" style="height:80px;width:80px;"/>
			                            <field name="approve_state" readonly="True"/>
			                            <field name='datas' widget="binary" string='Download' filename="name"/>
			                            <field name="appointment_order_ref_id" invisible="1"/>
			                        </tree>
			                        <form string="Attachments">
                                <header>
                                        <field name="approve_state" widget="statusbar" statusbar_visible="draft,approve,pre_approved,rejected"/>
                                </header>
                               <sheet>
                                <label for="name"/>
                                <h1>
                                    <field name="name" readonly="1"/>
                                </h1>
                                <group>
                                    <group>
                                        <!-- attrs="{'readonly':['|',('parent.state','=','approved'),('approve_state', '!=', 'draft')]}" -->
                                        <!-- Disable Domain for share in every stages -->
                                        <field name="share_design" readonly="1"/>
                                        <field name="is_final_design" readonly="1"/>

                                        <field name="type" invisible="1"/>
                                        <field name="datas" filename="name" readonly="1"/>
                                        
                                        <field name="url" widget="url" attrs="{'invisible':[('type','=','binary')]}"/>
                                        <field name="mimetype" groups="base.group_no_one" invisible="1"/>

                                        <field name="customer_signature" widget="image" readonly="1"/>

                                    </group>
                                    <group string="Attached To" groups="base.group_no_one" invisible="1">
                                        <field name="res_model"/>
                                        <field name="res_field"/>
                                        <field name="res_id"/>
                                        <field name="res_name"/>
                                        <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                                        <field name="public"/>
                                    </group>
                                    <group string="History" groups="base.group_no_one" attrs="{'invisible':[('create_date','=',False)]}" invisible="1">
                                        <label for="create_uid" string="Creation"/>
                                        <div name="creation_div">
                                            <field name="create_uid" readonly="1" class="oe_inline"/> on
                                            <field name="create_date" readonly="1" class="oe_inline"/>
                                        </div>
                                    </group>
                                    <group name="description_group" string="Description" groups="base.group_no_one"  colspan="4" invisible="1">
                                        <field name="description" nolabel="1" readonly="1"/>
                                    </group>
                                    <group groups="base.group_no_one" string="Indexed Content" colspan="4" invisible="1">
                                        <field name="index_content" nolabel="1"/>
                                    </group>
                                </group>
                              </sheet>
                            </form>
                    			</field>
                    		</page>
	        			</notebook>
	        				
	        			<div class="text-center">
	        				<!-- <button string="Approve" name="action_approve_appointment" type="object" class="oe_highlight" attrs="{'invisible': ['|',('appointment_state', 'in', ('draft','validate','reject')), '|', ('is_visitor_login','=',False), ('is_manager_login','=',False)]}" style="margin-right: 10px;"/> -->

                            <!-- attrs="{'invisible': ['|', ('appointment_state', 'in', ('draft','validate','reject')),  ('is_visitor_login','=',False), ('is_manager_login','=',True), ('is_visitor_login','=',True), ('is_manager_login','=',False)]}" -->

                            <button string="Approve" name="action_approve_appointment" type="object" class="oe_highlight" attrs="{'invisible': ['|',('appointment_state', 'in', ('draft','validate','reject')), '&amp;', ('is_visitor_login','=',False), ('is_manager_login','=',False)]}" style="margin-right: 10px;"/>


                			<button string="Reset Date" name="action_reject_appointment" type="object"
	                    	attrs="{'invisible': ['|',('appointment_state', 'in', ('draft','validate','reject')), '&amp;', ('is_visitor_login','=',False), ('is_manager_login','=',False)]}"/>
	                    </div>
	        		</sheet>
	        		<div class="oe_chatter">
	                    <field name="message_follower_ids"/>
	                    <field name="activity_ids" widget="mail_activity"/>
	                    <field name="message_ids"/>
                	</div>
	        		<footer class="text-center">
						<button name="create_appointment" type="object" string="Create Appointment" class="oe_highlight" attrs="{'invisible': [('appointment_state', 'not in', ('draft'))]}"/>
						<span style="padding-left:15px;"> </span>
						<button special="cancel" string="Cancel" attrs="{'invisible': [('appointment_state', 'not in', ('draft'))]}"/>
					</footer>
	        	</form>
	      	</field>
      	</record>

      	<record id="visit_appointment_view_calendar" model="ir.ui.view">
            <field name="name">appointment.calendar.view</field>
            <field name="model">appointment.visit</field>
            <field name="priority" eval="2"/>
            <field name="arch" type="xml">
                <calendar string="Appointment" create="1" mode="month" date_start="appointment_date" color="visitor_id" hide_time="true" event_limit="5">
                    <field name="visitor_id" avatar_field="avatar_128"/>
                    <field name="appointment_state"/>
                    <field name="customer_id"/>
                    <field name="visit_charge"/>
                    <field name="appointment_date"/>
                </calendar>
            </field>
        </record>

        <record id="visit_appointment_view_tree" model="ir.ui.view">
            <field name="name">appointment.tree.view</field>
            <field name="model">appointment.visit</field>
            <field name="priority" eval="2"/>
            <field name="arch" type="xml">
            	<tree create="false">
            		<field name="visitor_id" />
                    <field name="appointment_date"/>
                    <field name="customer_id"/>
                    <field name="visit_charge"/>
                    <field name="appointment_state"/>
            	</tree>
            </field>
        </record>

        <record id="visit_appointment_view_kanban" model="ir.ui.view">
            <field name="name">visit.appointment.view.kanban</field>
            <field name="model">appointment.visit</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" sample="1" js_class="account_bills_kanban">
                    <field name="customer_id"/>
                    <field name="visitor_id"/>
                    <field name="appointment_date"/>
                    <field name="appointment_state"/>
                    <field name="visit_charge"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click">
                                <div class="row mb4">
                                    <div class="col-6 o_kanban_record_headings">
                                        <strong>
                                            <span>
                                                <field name="visitor_id" />
                                            </span>
                                        </strong>
                                    </div>
                                    <div class="col-6 text-right">
                                        <strong><i class="fa fa-clock-o" aria-label="Date" role="img" title="Date"/> <t t-esc="record.appointment_date.value"/></strong>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-6">
                                        <span><field name="visit_charge" widget='monetary'/></span>
                                    </div>
                                    <div class="col-6">
                                        <span class="float-right">
                                            <field name="appointment_state" widget="label_selection" options="{'classes': {'draft': 'default', 'confirm': 'primary','validate': 'success'}}"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

      	<record model="ir.actions.act_window" id="action_visit_appointment">
			<field name="name">Appointment To Visit</field>
			<field name="res_model">appointment.visit</field>
			<field name="view_mode">calendar,form,kanban</field>
			<!-- <field name="target">inline</field> -->
			<field name="domain">[]</field>
		</record>

		<record model="ir.actions.act_window" id="action_visit_appointment_tree">
			<field name="name">Appointment To Visit</field>
			<field name="res_model">appointment.visit</field>
			<field name="view_mode">tree,form,calendar,kanban</field>
			<!-- <field name="target">inline</field> -->
			<field name="domain">['|',('visitor_id','=',uid),('create_uid','=',uid)]</field>
		</record>

		<menuitem id="visitor_appointment_menu_item"
            name="Appointments"
            web_icon="crm_design,static/img/appointment.png" />
            <!-- parent="sale.sale_menu_root"/> -->

	    <menuitem id="dashboard_appointment_menu_item"
	     	name="Dashboard"
	     	parent="visitor_appointment_menu_item"
	        action="action_visit_appointment">
	    </menuitem>

	    <menuitem id="my_appointment_menu_item"
	     	name="My Appointments"
	     	parent="visitor_appointment_menu_item"
	        action="action_visit_appointment_tree">
	    </menuitem>


	    <!-- Only Manager Can Change Visitor -->
	    <record id="visit_appointment_view_form_inherited" model="ir.ui.view">
			<field name="name">visit.appointment.view.form.inherited</field>
			<field name="model">appointment.visit</field>
			<field name="inherit_id" ref="crm_design.visit_appointment_view_form"/>
			<field name="groups_id" eval="[(4, ref('crm_design.group_manager_schedular')),(4, ref('base.group_user'))]"/>
			<field name="mode">primary</field>
			<field name="arch" type="xml">
				<xpath expr="//field[@name='visitor_id']" position="attributes">
					<attribute name="readonly">0</attribute>
				</xpath>
			</field>
		</record>

		<record id="appointment_visit_reject_view_form" model="ir.ui.view">
			<field name="name">appointment.visit.reject.view.form</field>
			<field name="model">appointment.visit.reject</field>
			<field name="arch" type="xml">
				<form string="Appointment Visit Reject">
					<field name="notes" placeholder="Notes"/>
					<!-- <h5>Your Appoinment Visit</h5> -->
					<footer>
						<button name="action_appointment_visit_reject" type="object" string="Reject" class="btn btn-primary"/>
						<button special="cancel" string="Cancel" class="btn btn-primary"/>
					</footer>
				</form>
			</field>
		</record>
		<!-- <record id="visit_appointment_view_form_inherited_employee" model="ir.ui.view">
			<field name="name">visit.appointment.view.form.inherited.employee</field>
			<field name="model">appointment.visit</field>
			<field name="inherit_id" ref="crm_design.visit_appointment_view_form"/>
			<field name="groups_id" eval="[(4, ref('crm_design.group_employee'))]"/>
			<field name="arch" type="xml">
				<xpath expr="//field[@name='visitor_id']" position="attributes">
					<attribute name="readonly">1</attribute>
				</xpath>
			</field>
		</record> -->

	</data>
</odoo>