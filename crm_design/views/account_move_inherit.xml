<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>
		<record id="account_move_date_view_tree_inherited" model="ir.ui.view">
	        <field name="name">account.move.date.view.tree.inherited</field>
	        <field name="model">account.move</field>
	        <field name="inherit_id" ref="account.view_in_invoice_bill_tree"/>
	        <field eval="100" name="priority"/>
	        <field name="arch" type="xml">
	        	<field name="state" position="after">
	        		<field name="receipt_status"/>
	        	</field>
	        </field>
	    </record>


		<record id="account_move_date_view_form_inherited" model="ir.ui.view">
	        <field name="name">account.move.date.view.form.inherited</field>
	        <field name="model">account.move</field>
	        <field name="inherit_id" ref="account.view_move_form"/>
	        <field eval="100" name="priority"/>
	        <field name="arch" type="xml">

	        	<field name="payment_reference" position="replace">
	        		<field name="payment_reference" attrs="{'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt'))], 'required': [('move_type', 'in', ('in_invoice',))]}"/>
	        	</field>


	        	<!-- Send And Print Button Replace -->
	        	<button name="action_invoice_sent"
                                type="object"
                                attrs="{'invisible':['|', '|', ('state', '!=', 'posted'), ('is_move_sent', '=', True), ('move_type', 'not in', ('out_invoice', 'out_refund'))]}"
                                class="oe_highlight"
                                data-hotkey="y" position="replace">
                	</button>
                	<button name="action_invoice_sent"
	                        type="object"
	                        attrs="{'invisible':['|', '|', ('state', '!=', 'posted'), ('is_move_sent', '=', False), ('move_type', 'not in', ('out_invoice', 'out_refund', 'in_invoice', 'in_refund'))]}"
	                        data-hotkey="y" position="replace">
	                                <!-- <button name="action_invoice_sent"
		                                type="object"
		                                string="Send &amp; Print"
		                                attrs="{'invisible':['|','|',('current_login_id','!=',True),('state','in',('draft','approve_pending')),('move_type', 'in', ('in_invoice',))]}"
		                                data-hotkey="y"/> -->

	                         	<button name="action_invoice_sent"
	                         	 
 									type="object" string="Send &amp; Print"/>

                	</button>

                <!-- Post Button Replace -->
	       	 	<button name="action_post" class="oe_highlight"
                                type="object" groups="account.group_account_invoice" data-hotkey="v"
                                context="{'validate_analytic': True}"
                                attrs="{'invisible': ['|', '|', ('hide_post_button', '=', True), ('move_type', '=', 'entry'), ('display_inactive_currency_warning','=',True)]}" position="replace" >

                    		<!-- For Customer Invoice -->
							<button name="action_post" string="Confirm" class="oe_highlight"
	                            type="object" groups="account.group_account_manager" data-hotkey="v"
	                            context="{'validate_analytic': True}"
	                            attrs="{'invisible': ['|','|', ('confirmed_by_customer','=',False),('state', '=', 'posted'),('move_type', 'in', ('in_invoice', 'in_refund'))]}"/>

                            <!-- For Vendor Bill -->
                            <button name="action_post" string="Confirm" class="oe_highlight"
                                type="object" groups="account.group_account_manager" data-hotkey="v"
                                context="{'validate_analytic': True}"
                                attrs="{'invisible': ['|','|',('move_type', 'in', ('entry','out_invoice', 'out_refund')), ('state', '=', 'posted'), ('display_inactive_currency_warning','=',True)]}"/>
                </button>
                
                <!-- Register Payment Button Replace -->
	        	<xpath expr="//header/button[@name='action_register_payment']" position="replace">
	        		 <button name="action_register_payment" id="account_invoice_payment_btn"
                        type="object" class="oe_highlight"
                        attrs="{'invisible': ['|', '|', ('state', '!=', 'posted'), ('payment_state', 'not in', ('not_paid', 'partial')), ('move_type', 'not in', ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt'))]}"
                        context="{'dont_redirect_to_payments': True}"
                        string="Register Payment" data-hotkey="g"
                        groups="account.group_account_manager"/>
	        	</xpath>

	        	<xpath expr="//header/field[@name='state']" position="replace">
	        		<field name="state" widget="statusbar" statusbar_visible="draft,sent,posted"/>
	        	</xpath>

	        	<xpath expr="//header" position="inside">

	        		<button name="request_for_approval" string="Send For Approval"
                       			type="object" class="btn-primary" attrs="{'invisible': ['|','|',('state','in',('draft','sent','posted')),('current_login_id','!=',True),('move_type','!=','out_invoice')]}"/>

                    		<button name="action_approve" string="Approve" type="object" 
                    			attrs="{'invisible':[('state','not in',('approve_pending',))]}" groups="crm_design.group_manager_quotation" class="btn-primary"/>
            
            			<button name="action_refuse" string="Refuse" type="object" 
            				attrs="{'invisible':[('state','not in',('approve_pending',))]}" groups="crm_design.group_manager_quotation" class="btn-primary"/>

	        	</xpath>

	        	<xpath expr="//field[@name='partner_id']" position="after">
	        		<field name="is_final_invoice" invisible="1"/>
	        		<field name="is_manager_login" invisible="1"/>
	        		<field name="is_visit_invoice" invisible="1"/>
	        		<field name="current_login_id" invisible="1"/>
	        		<field name="visitor_id" invisible="1"/>
	        		<field name="appointment_id" invisible="1"/>
	        		<field name="lead_id" invisible="1"/>
	        		<field name="appointment_access_link" invisible="1"/>
                	<field name="is_thai" widget="boolean_toggle" attrs="{'readonly': [('state','in',['posted','cancel'])]}"/>
	        		<field name="product_requirement" />
	        		<field name="confirmed_by_customer" invisible="1"/>
	        		<field name="paymentslip_uploaded" invisible="1"/>
	        	</xpath>

	        	<xpath expr="//label[@for='invoice_date']" position="attributes">
	        		<attribute name="string">Schedule Date</attribute>
	        	</xpath>

	        	<xpath expr="//notebook/page[@id='invoice_tab']/field[@name='invoice_line_ids']" position="attributes">
		                <attribute name="attrs">{'readonly': [('is_manager_login','=',False),'|',('state', 'not in', ['posted', 'cancel']),('is_manager_login','=',False),'|',('state', 'not in', ['draft',]),('is_manager_login','=',True),('state', 'not in', ['draft','approve_pending'])]}</attribute>
		                <attribute name="context">{'is_thai': is_thai}</attribute>
		        </xpath>

		        <xpath expr="//notebook/page[@id='invoice_tab']/field[@name='invoice_line_ids']/tree/field[@name='product_id']" position="before">
	        		<field name="is_thai" invisible='1'/>
		        </xpath>

		        <xpath expr="//notebook/page[@id='invoice_tab']/field[@name='invoice_line_ids']/tree/field[@name='product_id']" position="attributes">
	        		<attribute name="context">{'is_thai':is_thai}</attribute>
		        </xpath>

		        <xpath expr="//notebook/page[@id='aml_tab']/field[@name='line_ids']" position="attributes">
		            <attribute name="context">{'is_thai': is_thai}</attribute>
		        </xpath>
		        
		        <xpath expr="//notebook/page[@id='aml_tab']/field[@name='line_ids']/tree/field[@name='account_id']" position="before">
	        		<field name="is_thai" invisible='1'/>
		        </xpath>

		        <xpath expr="//notebook/page[@name='aml_tab']/field[@name='line_ids']/tree/field[@name='account_id']" position="attributes">
	        		<attribute name="context">{'is_thai':is_thai}</attribute>
		        </xpath>

		        <xpath expr="//notebook/page[@id='invoice_tab']/field[@name='invoice_line_ids']/tree/field[@name='tax_ids']" position="attributes">
	        		<attribute name="context">{'is_thai':is_thai}</attribute>
		        </xpath>

		        <xpath expr="//notebook/page[@name='aml_tab']/field[@name='line_ids']/tree/field[@name='tax_ids']" position="attributes">
	        		<attribute name="context">{'is_thai':is_thai}</attribute>
		        </xpath>

		        <xpath expr="//notebook/page[@name='other_info']" position="after">
			        <page string="Customer Signature">
                        <group>
                            <field name="manager_signature" widget="signature" readonly="1"/>
                            <field name="manager_name" readonly="1"/>
                            <field name="manager_signed_on" readonly="1"/>
                        </group>
	                </page>
	                <page string="Payment Slip">
                        <field name="payslip_multi_attachments" widget="many2many_binary" string="Attach a file" nolabel="1" colspan="8" readonly="0"/>                        
                    </page>
	            </xpath>
	            <xpath expr="//field[@name='tax_totals']" position="after" >
	            	<field name="amount_to_pay"/>
	    		</xpath>
	        </field>
	    </record>
	</data>
</odoo>