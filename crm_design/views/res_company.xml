<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>
		<record id="res_company_thai_form_view_inherit" model="ir.ui.view">
			<field name="name">res.company.thai.form.view.inherit</field>
	        <field name="model">res.company</field>
	        <field name="inherit_id" ref="base.view_company_form"/>
	        <field name="arch" type="xml">
	            <xpath expr="//notebook/page[@name='general_info']" position="after">
		    			<page string='Thai Address' name="thai_address">
		    				<group>
			    				<field name="thai_add" string='Thai Company'/>
				                <field name="thai_street1"/>
				                <field name="thai_street2"/>
				                <field name="thai_city"/>
				                <field name="thai_state"/>
				                <field name="thai_country"/>
			            	</group>
		    			</page>
	   			</xpath>	                
	        </field>
		</record>
	</data>
</odoo>