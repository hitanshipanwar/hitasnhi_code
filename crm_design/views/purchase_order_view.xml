<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<record id="purchase_order_inhert_form_view" model="ir.ui.view">
		<field name="name">purchase.order.inherit.form.view</field>
		<field name="model">purchase.order</field>
		<field name="inherit_id" ref="purchase.purchase_order_form"/>
		<field name="arch" type="xml">
			<xpath expr="//sheet/group/group/field[@name='partner_id']" position="attributes">
				<attribute name="options">{'no_create': True, 'no_create_edit':True}</attribute>
			</xpath>
			<xpath expr="//field[@name='currency_id']" position="after">
				<field name="is_thai" widget="boolean_toggle" attrs="{'readonly':[('state','in',['purchase','done','cancel'])]}"/>
			</xpath>
			<xpath expr="//page[@name='products']/field[@name='order_line']/tree/field[@name='product_id']" position="before">
				<field name="is_thai" widget="boolean_toggle" invisible='1'/>
			</xpath>
			<xpath expr="//page[@name='products']/field[@name='order_line']/tree/field[@name='product_id']" position="attributes">
				<attribute name="context">{'partner_id':parent.partner_id,'quantity':product_qty,'uom':product_uom, 'company_id': parent.company_id, 'is_thai':is_thai}
				</attribute>
			</xpath>
			<field name="order_line" position="attributes">
                <attribute name="context">{'is_thai': is_thai}</attribute>
            </field>
            <xpath expr="//notebook/page[@name='products']/field[@name='order_line']/tree/field[@name='taxes_id']" position="attributes">
                <attribute name="context">{'is_thai':is_thai}</attribute>
            </xpath>
		</field>
	</record>

</odoo>