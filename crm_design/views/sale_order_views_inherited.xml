    <!-- sale.order Inherited -->
    <record id="sale_order_view_form_inherited" model="ir.ui.view">
        <field name="name">sale.order.view.inherit.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//group[@name='note_group']" position="after">
                <group name="calculator_group" col="6" class="mt-2 mt-md-0">
                    <group colspan="4">
                    </group>
                    <group class="oe_subtotal_footer oe_right" colspan="2" name="sale_total">
                        <field name="precent_digits" colspan="2"/>
                        <field name="sale_per_amt" colspan="2"/>
                    </group>
                    <!-- <div class="clearfix"/> -->
                </group>
                <!-- <group>
                    <group></group>
                    <group>
                        <group></group>
                        <group>
                            <group></group>
                            <group>
                                <field name="precent_digits" style="font-weight:bold;" />
                                <field name="sale_per_amt" style="font-weight:bold;" />
                            </group>
                        </group>
                    </group>
                </group> -->
            </xpath>

            <xpath expr="//field[@name='validity_date']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_create_edit':True}</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="is_thai" widget="boolean_toggle" attrs="{'readonly': [('state', 'in', ['sale','done','cancel'])]}"/>
                <field name="is_custom_order" widget="boolean_toggle" attrs="{'readonly': [('state', 'in', ['sale','done','cancel'])]}"/>
            </xpath>       
            <xpath expr="//page[@name='order_lines']/field[@name='order_line']/tree/field[@name='product_id']" position="before">
                <field name="is_thai" widget="boolean_toggle" invisible='1'/>
            </xpath>
            <xpath expr="//page[@name='order_lines']/field[@name='order_line']/tree/field[@name='product_uom_qty']" position="before">
                <field name="formula"/>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('customer_rank','>', 0)]</attribute>
            </xpath>

            <!-- <xpath expr="//page[@name='order_lines']/field[@name='order_line']/tree/field[@name='price_unit']" position="attributes">
                <attribute name="attrs">{'readonly': [('product_id.product_type', 'in', ['standard'])]}</attribute>
            </xpath> -->

            <xpath expr="//page[@name='order_lines']/field[@name='order_line']/tree/field[@name='product_id']" position="before">
                <field name="standard_type"/>
            </xpath>

            <xpath expr="//page[@name='order_lines']/field[@name='order_line']/form/group/group/field[@name='product_id']" position="before">
                <field name="standard_type"/>
            </xpath>

            <xpath expr="//notebook/page[@name='order_lines']/field[@name='order_line']/tree/field[@name='tax_id']" position="attributes">
                <attribute name="context">{'is_thai':is_thai}</attribute>
            </xpath>

            <xpath expr="//notebook/page[@name='order_lines']/field[@name='order_line']" position="attributes">
                <attribute name="context">{'is_thai':is_thai}</attribute>
            </xpath>

            <xpath expr="//page[@name='order_lines']/field[@name='order_line']/form/group/group/field[@name='product_id']" position="replace">
                <field name="product_id"
                    domain="[('product_type','=',standard_type),('sale_ok', '=', True), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]"
                    context="{'partner_id':parent.partner_id, 'quantity':product_uom_qty, 'pricelist':parent.pricelist_id, 'uom':product_uom, 'company_id': parent.company_id, 'is_thai':parent.is_thai}"
                    attrs="{
                        'readonly': [('product_updatable', '=', False)],
                        'required': [('display_type', '=', False)],
                    }"
                    force_save="1"
                    widget="many2one_barcode"
                    />
            </xpath>

             <xpath expr="//page[@name='order_lines']/field[@name='order_line']/tree/field[@name='product_id']" position="replace">
                <field
                    name="product_id"
                    options="{'no_create': True}"
                    attrs="{
                        'readonly': [('product_updatable', '=', False)],
                        'required': [('display_type', '=', False)],
                    }"
                    force_save="1"
                    context="{
                        'partner_id': parent.partner_id,
                        'quantity': product_uom_qty,
                        'pricelist': parent.pricelist_id,
                        'uom':product_uom,
                        'company_id': parent.company_id,
                        'default_lst_price': price_unit,
                        'default_description_sale': name,
                    }"
                    domain="[('product_type','=',standard_type),('sale_ok', '=', True), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]"
                    widget="product_configurator"
                />
            </xpath>
            <xpath expr="//page[@name='customer_signature']" position="attributes">
                <attribute name="invisible">0</attribute>
                <attribute name="groups"></attribute>
            </xpath>

            <xpath expr="//sheet/notebook/page[@name='customer_signature']" position="after">
                <page string='Visitor Notes'>
                    <field name="visiter_notes" readonly="True"/>
                </page>
            </xpath>

            <xpath expr="//sheet/group[@name='sale_header']" position="after">
                <div>
                    <label for="extra_notes" name="Descriptions"/>
                    <field name="extra_notes" placeholder="Any Descriptions Here ..."/>
                </div>
            </xpath>

                <xpath expr="//div[@class='oe_button_box']" position="after">
                    <widget name="web_ribbon" title="Paid" attrs="{'invisible': [('final_paid', '=', False)]}"/>
                </xpath>

                <xpath expr="//div[@class='oe_button_box']" position="inside">

                        <button name="preview_design"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-globe icon" attrs="{'invisible': [('need_design', '=', False)]}">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Design</span>
                                <span class="o_stat_text">Preview</span>
                            </div>
                        </button>
                </xpath>
            <xpath expr="//header" position="inside">

                <button name="notify_salesperson" string="Notify SalesPerson"
                            type="object" class="btn-primary" groups="crm_design.group_allow_to_add_design"
                             attrs="{'invisible': [('saleperson_notified','=',True),('need_design','=',True)]}"/>

                <button name="notify_designer" string="Notify Designer"
                            type="object" class="btn-primary"
                            attrs="{'invisible': ['|','|','|',('state','not in',('site_visited','draft','design_confirm')),('current_login_id','!=',True),('designer_notified','=',True),('need_design','!=',True)]}"/>

                <!-- <button name="send_design" string="Send Design" type="object"
                            attrs="{'invisible': ['|',('need_design','=',False),('state','in',('final_approve_pending','final_approved','final_refused','sale','done','cancel'))]}"/> -->

                    <button name="send_design" string="Send Design"
                            type="object" class="btn-primary"
                            attrs="{'invisible': ['|','|','|',('state','not in',('site_visited','draft','design_confirm')),('current_login_id','!=',True),('designer_notified','=',True),('need_design','!=',True)]}"/>

                <!-- <button name="request_for_design_approval" string="Design Approve Request"
                            type="object" class="btn-primary" data-hotkey="q" attrs="{'invisible': ['|',('state','in',('approve_pending','sale','approved','site_visit','site_visited','final_approved','design_confirm')),'|',('current_login_id','!=',True),('design_count','=',0)]}"/> -->

                <button name="request_for_final_approval" string="Quotation Approve Request"
                            type="object" class="btn-primary" attrs="{'invisible': ['|',('state','in',('final_approve_pending','sale','final_approved','cancel','done')),('current_login_id','!=',True)]}"/>

                <!-- attrs="{'invisible':[('mark_as_sent','=',True)]}" -->
                <button name="action_mark_as_send" string="Mark Send" type="object" />


                <!-- <button name="action_approve" string="Approve" type="object" attrs="{'invisible':[('state','not in',('approve_pending','final_approve_pending'))]}" data-hotkey="q" groups="crm_design.group_manager_design" class="btn btn-primary"/>

                <button name="action_refuse" string="Refuse" type="object" attrs="{'invisible':[('state','not in',('approve_pending','final_approve_pending'))]}" data-hotkey="x" groups="crm_design.group_manager_design" class="btn btn-primary"/>
 -->
                <button name="action_approve" string="Approve" type="object" attrs="{'invisible':[('state','not in',('approve_pending','final_approve_pending'))]}" data-hotkey="q" groups="crm_design.group_manager_quotation" class="btn btn-primary"/>

                <button name="action_refuse" string="Refuse" type="object" attrs="{'invisible':[('state','not in',('approve_pending','final_approve_pending'))]}" data-hotkey="x" groups="crm_design.group_manager_quotation" class="btn btn-primary"/>

            </xpath>

            <button name="action_quotation_send" type="object" states="sent,sale" data-hotkey="g" position="replace">
            </button>

            <xpath expr="//button[@data-hotkey='g']" position="replace">
                <button name="action_quotation_send" string="Send by Email" type="object" data-hotkey="g"
                    attrs="{'invisible':[('state','not in',('final_approved'))]}"/>
                 <!-- <button name="action_quotation_send" string="Send by Email" type="object" data-hotkey="g"
                    attrs="{'invisible':['|','&amp;',('need_design','=',False),('state','not in',('final_approved')),
                    '|','&amp;',('current_login_id','=',False),('state','in',('draft','final_approved')),
                    '&amp;',('need_design','=',True),('state','in',('final_approve_pending','site_visit'))]}"/> -->
            </xpath>



            <!-- <button name="action_confirm" id="action_confirm" data-hotkey="v"
                    class="btn-primary" type="object" attrs="{'invisible': [('state', 'not in', ['sent'])]}" position="replace">

                    <button name="action_confirm" id="action_confirm" data-hotkey="v"
                            string="Confirm" class="btn-primary" type="object"
                            attrs="{'invisible': ['|','|',('confirmed_by_customer', '=',False),('current_login_id','!=',True),('state','not in',('final_approved',))]}"/>
            </button> -->

            <button name="action_confirm" data-hotkey="v" type="object"
                        attrs="{'invisible': [('state', 'not in', ['draft'])]}" position="replace">
            </button>
            <button name="action_confirm" id="action_confirm" data-hotkey="v"
                        class="btn-primary" type="object"
                        attrs="{'invisible': [('state', 'not in', ['sent'])]}" position="replace">
            </button>


            <button name="%(sale.action_view_sale_advance_payment_inv)d"
                        type="action" class="btn-primary" data-hotkey="q"
                        attrs="{'invisible': [('invoice_status', '!=', 'to invoice')]}" position="replace">
            </button>

            <!-- <button id="create_invoice" name="%(sale.action_view_sale_advance_payment_inv)d"
