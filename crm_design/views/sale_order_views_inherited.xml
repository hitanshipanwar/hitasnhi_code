            </button> -->

            <button name="action_cancel" type="object" attrs="{'invisible': ['|', ('state', 'not in', ['draft', 'sent','sale']), ('id', '=', False)]}" data-hotkey="z" position="replace">

                <button name="action_cancel" type="object" string="Cancel" attrs="{'invisible': ['|', ('state', 'not in', ['draft', 'sent','sale','final_approved']), ('id', '=', False)]}" data-hotkey="z" /> 

            </button>



            <xpath expr="//sheet/div[@name='button_box']" position="inside">
                <button name="action_view_appointments"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-calendar"  attrs="{'invisible': [('state', 'not in', ('site_visit','site_visited'))]}">
                        Appointments
                </button>

            </xpath>

            <xpath expr="//header/field[@name='state']" position="replace">
                <field name="state" widget="statusbar" statusbar_visible="draft,sent,design_confirm,site_visit,site_visited,final_approve_pending,final_approved,final_refused,sale"/>
            </xpath>

            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_create_appointment" type="object" string="Create Appointment" attrs="{'invisible': ['|',('appoinment_to_visit', '=', False),'|',('state','in',('site_visited','final_approve_pending','final_approved','final_refused','sale')),('current_login_id','!=',True)]}"/>
            </xpath>

            <xpath expr="//group[@name='partner_details']" position="inside">
                <field name="partner_id" invisible="1"/>
                <field name="platform_ids" widget="many2many_tags" options="{'no_create': True, 'no_create_edit':True}"/>
                <field name="product_requirement" />
                <field name="sizing"/>
            </xpath>

            <xpath expr="//group[@name='order_details']" position="inside">
                <!-- Invisile Fields -->
                <field name="mark_as_sent"/>
                <field name="previous_state" invisible="1"/>
                <field name="is_manager_login" invisible="1"/>
                <field name="design_count" invisible="1"/>
                <field name="is_final_invoice_created" invisible="1"/>
                <field name="is_quotation_approved" force_save="1" invisible="1"/>
                <field name="current_login_id" invisible="1"/>
                <field name="create_uid" invisible="1"/>
                <field name="is_designer_login" invisible="1"/>
                <field name="final_paid" invisible="1"/>
                <field name="designer_notified" invisible="1"/>
                <field name="saleperson_notified" invisible="1"/>

                <field name="need_design" force_save="1" attrs="{'readonly':[('state', 'in', ['sale', 'done', 'final_approve_pending', 'final_approved', 'cancel'])]}"/>
                <field name="designer_id" attrs="{'invisible': [('need_design', '=', False)], 'readonly':[('state', 'in', ['sale', 'done', 'final_approve_pending', 'final_approved'])]}"/>

                <field name="appoinment_to_visit" attrs="{'readonly':[('state', 'in', ['sale', 'done', 'final_approve_pending', 'final_approved', 'cancel'])]}"/>

                <field name="appointment_date" attrs="{'invisible': [('state', 'not in', ('site_visit','site_visited'))]}" force_save="1"/>
                <field name="visitor_id" attrs="{'invisible': [('state', 'not in', ('site_visit','site_visited'))]}" force_save="1"/>
                <field name="visit_charge" invisible="1"/>
                <field name="confirmed_by_customer" invisible="1"/>
            </xpath>

            <xpath expr="//notebook/page[@name='order_lines']/field[@name='order_line']/tree/field[@name='name']" position="after">
                <field name="model_id" widget="product_configurator"  attrs="{'column_invisible':[('parent.product_requirement','!=','doors')]}"/>
                <field name="thickness" attrs="{'column_invisible':[('parent.product_requirement','!=','doors')]}"/>
                <field name="width" attrs="{'column_invisible':[('parent.product_requirement','!=','doors')]}"/>
                <field name="height" attrs="{'column_invisible':[('parent.product_requirement','!=','doors')]}"/>
            </xpath>
            <xpath expr="//notebook/page[@name='order_lines']/field[@name='order_line']/tree/field[@name='customer_lead']" position="replace">
                <field name="customer_lead" invisible="1"/>
            </xpath>

            <field name="order_line" position="attributes">
                <attribute name="context">{'is_thai': is_thai}</attribute>
            </field>

            <xpath expr="//notebook/page[@name='order_lines']/field[@name='order_line']" position="attributes">

                <!-- <attribute name="attrs">{'readonly': [('is_manager_login','=',False),'|',('state', 'not in', ['sale', 'done']),('is_manager_login','=',False),'|',('state', 'not in', ['draft',]),('is_manager_login','=',True),('state', 'not in', ['draft','final_approve_pending'])]}</attribute> -->

                <!-- <attribute name="attrs">{'readonly': [('is_manager_login','=',False),'|',('state', 'in', ['sale', 'done','final_approve_pending','final_approved']),('is_manager_login','=',True),('state', 'in', ['sale', 'done','final_approved'])]}</attribute> -->

            </xpath>
            <xpath expr="//notebook/page[@name='order_lines']/field[@name='order_line']/tree/field[@name='product_packaging_qty']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//notebook/page[@name='order_lines']/field[@name='order_line']/tree/field[@name='product_packaging_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='payment_term_id']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>

            <xpath expr="//notebook/page[@name='order_lines']/field[@name='order_line']/tree/field[@name='price_unit']" position="attributes">
                <attribute name="attrs">{'readonly': ['|',('qty_invoiced', '&gt;', 0),('standard_type', '=', 'standard')]}</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>

