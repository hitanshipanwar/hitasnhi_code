            <button name="%(sale.action_view_sale_advance_payment_inv)d" 
                type="action" context="{'default_advance_payment_method': 'percentage'}" data-hotkey="q"
                attrs="{'invisible': ['|',('invoice_status', '!=', 'no'), ('state', '!=', 'sale')]}" position="replace">
                
                <button id="create_invoice" class="btn-primary" name="%(sale.action_view_sale_advance_payment_inv)d" 
                type="action" data-hotkey="q" string="Create Final Invoice" attrs="{'invisible': ['|',('state', 'not in',('sale',)),'|',('current_login_id','!=',True),('invoice_status', '!=', 'to invoice')]}" />
                <!-- context="{'default_advance_payment_method': 'percentage'}" -->
            </button>

            <!-- <button name="%(sale.action_view_sale_advance_payment_inv)d"
                        type="action" context="{'default_advance_payment_method': 'percentage'}" data-hotkey="q"
                        attrs="{'invisible': ['|',('invoice_status', '!=', 'no'), ('state', '!=', 'sale')]}" position="replace"> -->

                        <!-- name="create_final_invoice" -->
                        <!-- name="%(sale.action_view_sale_advance_payment_inv)d" -->
                        <!-- <button name="create_final_invoice" string="Create Final Invoice"
