                <!-- OLd Domain -->
                 <!-- attrs="{'readonly': [('parent.is_manager_login','=',False),'|',('parent.state', 'not in', ['sale', 'done']),('parent.is_manager_login','=',False),'|',('parent.state', 'not in', ['draft',]),('parent.is_manager_login','=',True),('parent.state', 'not in', ['draft','final_approve_pending'])]}" -->
               <!--  <field name="price_unit" attrs="{'readonly': [('parent.is_manager_login','=',False),('parent.state', 'in', ['sale', 'done','final_approve_pending','final_approved'])]}"/>
            </xpath>
            <xpath expr="//notebook/page[@name='order_lines']/field[@name='order_line']/tree/field[@name='tax_id']" position="replace">
                <field
                    name="tax_id"
                    widget="many2many_tags"
                    options="{'no_create': True}"
                    domain="[('type_tax_use','=','sale'),('company_id','=',parent.company_id), ('country_id', '=', parent.tax_country_id)]"
                    context="{'active_test': True}"
                    attrs="{'readonly': [('parent.is_manager_login','=',False),'|',('parent.state', 'not in', ['sale', 'done']),('parent.is_manager_login','=',False),'|',('parent.state', 'not in', ['draft',]),('parent.is_manager_login','=',True),('parent.state', 'not in', ['draft','final_approve_pending'])]}"
                    optional="show"
                    />
            </xpath> -->

            <xpath expr="//notebook/page[@name='other_information']" position="after">
                    <page name="materials" string="Material Specification" attrs="{'invisible':[('product_requirement','!=','doors')]}">
                        <group>
                            <group name="group1">
                                <field name="material_specification" attrs="{'required': [('product_requirement','=','doors')]}"/>
                                <field name="job_type" attrs="{'required': [('product_requirement','=','doors')]}"/>
                            </group>
                            <group name="group2">
                                <field name="gloss" attrs="{'required': [('product_requirement','=','doors')]}"/>
                                <field name="code" attrs="{'required': [('product_requirement','=','doors')]}"/>
                            </group>
                        </group>
                    </page>

                    <page name="design" string="Design" attrs="{'invisible':[('need_design','=',False)]}">
                        <field name="attachment_ids">
                            <tree delete="false">
                                <field name="name" />
                                <field name="create_uid" readonly="1" class="oe_inline" string="Uploaded By"/>
                                 <field name="share_design"/>
                                 <field name="is_approved" invisible="1"/>
                                 <field name="is_rejected" invisible="1"/>
                                 <field name="comment" attrs="{'invisible_column':[('approve_state','=','draft')]}"/>
                                <field name="is_final_design" attrs="{'column_invisible':[('parent.state','not in',('site_visited','final_approved','sale'))]}"/>
