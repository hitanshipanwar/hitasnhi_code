                                <header>
                                        <field name="approve_state" widget="statusbar" statusbar_visible="draft,approve,pre_approved,rejected"/>
                                </header>
                               <sheet>
                                <label for="name"/>
                                <h1>
                                    <field name="name" attrs="{'readonly':['|',('parent.state','in',('approved','approve_pending')),('approve_state', '!=', 'draft')]}"/>
                                </h1>
                                <group>
                                    <group>
                                        <!-- attrs="{'readonly':['|',('parent.state','=','approved'),('approve_state', '!=', 'draft')]}" -->
                                        <!-- Disable Domain for share in every stages -->
                                        <field name="share_design" />
                                        <field name="is_final_design" attrs="{'readonly':[('approve_state','!=','draft')],'invisible':['|',('approve_state','!=','draft'),('parent.state','not in',('site_visited','final_approved','sale'))]}"/>

                                        <field name="type" invisible="1"/>
                                        <field name="datas" filename="name" options="{'accepted_file_extensions': '.pdf'}" attrs="{'readonly':['|',('parent.state','in',('approved','approve_pending')),('approve_state', '!=', 'draft')]}"/>

                                        <field name="url" widget="url" attrs="{'invisible':[('type','=','binary')]}"/>
                                        <field name="mimetype" groups="base.group_no_one" invisible="1"/>

                                        <field name="customer_signature" widget="image" attrs="{'invisible':['|',('approve_state','=','draft'),('parent.state','not in',('design_confirm','site_visit','site_visited','final_approve_pending','final_approved','final_refused','sale'))],'readonly':['|',('parent.state','=','approved'),('approve_state', '!=', 'draft')]}" force_save="1"/>

                                    </group>
                                    <group string="Attached To" groups="base.group_no_one" invisible="1">
                                        <field name="res_model"/>
                                        <field name="res_field"/>
                                        <field name="res_id"/>
                                        <field name="res_name"/>
                                        <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                                        <field name="public"/>
                                    </group>
                                    <group string="History" groups="base.group_no_one" attrs="{'invisible':[('create_date','=',False)]}" invisible="1">
                                        <label for="create_uid" string="Creation"/>
                                        <div name="creation_div">
                                            <field name="create_uid" readonly="1" class="oe_inline"/> on
                                            <field name="create_date" readonly="1" class="oe_inline"/>
                                        </div>
                                    </group>
                                    <group name="description_group" string="Description" groups="base.group_no_one"  colspan="4" invisible="1">
                                        <field name="description" nolabel="1"/>
                                    </group>
                                    <group groups="base.group_no_one" string="Indexed Content" colspan="4" invisible="1">
                                        <field name="index_content" nolabel="1"/>
                                    </group>
                                </group>
                              </sheet>
                            </form>
                        </field>
                    </page>

                    <page string="Attachments">
                        <field name="multi_attachments" widget="many2many_binary" string="Attach a file" nolabel="1" colspan="2" invisible="1"/>
                        <field name="multi_attachments_ids" >
                            <tree delete="false">
                                <field name="name" />
                                <field name="create_uid" readonly="1" class="oe_inline" string="Uploaded By"/>
                                <field name="create_date" readonly="1" class="oe_inline" string="Uploaded On" />
                                <field name='datas' widget="binary" string='Download' filename="name"/>

                                <!-- <button name="unlink"
                                        type="object"
                                        class="fa fa-trash-o"
                                        attrs="{'invisible': [('approve_state', '!=', 'draft')]}"
                                        aria-label="Delete row 1"
                                        /> -->
                            </tree>
                            <form string="Attachments">
                                <sheet>
                                    <label for="name"/>
                                    <h1>
                                        <field name="name"/>
                                    </h1>
                                    <group>
                                        <group>
                                            <field name="type" invisible="1"/>
                                            <field name="datas" filename="name"/>

                                            <field name="url" widget="url" attrs="{'invisible':[('type','=','binary')]}"/>
                                            <field name="mimetype" groups="base.group_no_one" invisible="1"/>
                                        </group>
                                        <group string="Attached To" groups="base.group_no_one" invisible="1">
                                            <field name="res_model"/>
                                            <field name="res_field"/>
                                            <field name="res_id"/>
                                            <field name="res_name"/>
                                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                                            <field name="public"/>
                                        </group>
                                        <group string="History" groups="base.group_no_one" attrs="{'invisible':[('create_date','=',False)]}" invisible="1">
                                            <label for="create_uid" string="Creation"/>
                                            <div name="creation_div">
                                                <field name="create_uid" readonly="1" class="oe_inline"/> on
                                                <field name="create_date" readonly="1" class="oe_inline"/>
                                            </div>
                                        </group>
                                        <group name="description_group" string="Description" groups="base.group_no_one"  colspan="4" invisible="1">
                                            <field name="description" nolabel="1"/>
                                        </group>
                                        <group groups="base.group_no_one" string="Indexed Content" colspan="4" invisible="1">
                                            <field name="index_content" nolabel="1"/>
                                        </group>
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </page>

                    <page string="Manager Signature">
                        <field name="manager_info_ids" >
                            <tree delete="0" create="0">
                                <field name="manager_signature" widget="signature" style="height:80px;width:80px;" readonly="1"/>
                                <field name="manager_name" readonly="1"/>
                                <field name="manager_signed_on" readonly="1"/>
                                <field name="state" readonly="1"/>
                                <field name="is_approved"/>
                            </tree>
                            <form>
                                <sheet>
                                    <group>
                                        <group>
                                            <field name="manager_signature" widget="signature" style="height:80px;width:80px;" readonly="1"/>
                                            <field name="manager_name" readonly="1"/>
                                            <field name="manager_signed_on" readonly="1"/>
                                            <field name="state" readonly="1"/>
                                            <field name="is_approved"/>
                                        </group>
                                    </group>
                                </sheet>
                            </form>
                        </field>
<!--                         <group>
                            <field name="manager_signature" widget="signature"/>
                            <field name="manager_name"/>
                            <field name="manager_signed_on"/>
                        </group> -->
                    </page>
                </xpath>
        </field>
    </record>



    <!-- Create Domain Tree view for designer to display Quotation -->
    <record id="action_quotations_my_desing_to_upload" model="ir.actions.act_window">
            <field name="name">Design</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">sale.order</field>
            <field name="view_mode">tree,kanban,form,calendar,pivot,graph,activity</field>
            <field name="search_view_id" ref="sale.sale_order_view_search_inherit_quotation"/>
            <field name="domain">[('designer_id', '=', uid)]</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Create a new quotation, the first step of a new sale!
              </p><p>
                Once the quotation is confirmed by the customer, it becomes a sales order.<br/> You will be able to create an invoice and collect the payment.
              </p>
            </field>
        </record>


    <!-- Menu to display Upload Design Sale Order -->
    <menuitem id="my_design_upload_menu_item"
            name="Design to Upload"
            parent="sale.sale_order_menu"
            action="action_quotations_my_desing_to_upload">
    </menuitem>

    <!-- Group wise Readonly Salr Order Line -->
    <record id="sale_order_line_sales_person_group" model="ir.ui.view">
            <field name="name">sale.order.line.sales.person.group</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']" position="attributes">
                    <attribute name="readonly"></attribute>
                    <attribute name="attrs">{'readonly': [('is_manager_login', '=', False), ('state', 'in', ['sale', 'done', 'final_approve_pending', 'final_approved'])]}</attribute>
                </xpath>
            </field>
        </record>

        <record id="sale_order_line_sales_manager_group" model="ir.ui.view">
            <field name="name">sale.order.line.sales.manager.group</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="groups_id" eval="[(4, ref('crm_design.group_manager_quotation'))]"/>
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']" position="attributes">
                    <attribute name="readonly"></attribute>
                    <attribute name="attrs">{'readonly': [('is_manager_login','=',True),('state', 'in', ['sale', 'done','final_approved'])]}</attribute>
                </xpath>
            </field>
        </record>

        <record id="action_quotations_with_onboarding_crm_lead" model="ir.actions.act_window">
