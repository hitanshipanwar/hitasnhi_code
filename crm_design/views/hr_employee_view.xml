<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_inhert_form_view" model="ir.ui.view">
        <field name="name">hr.employee.inherit.form.view</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='oe_title']/h1" position="after">
                <h1 class="d-flex"><field name="name_surname_thai"/></h1>
            </xpath>
            <xpath expr="//field[@name='coach_id']" position="after">
                <field name="employee_number"/>
                <field name="section"/>
                <field name="start_date"/>
                <field name="social_security_number"/>
                <field name="nickname"/>
            </xpath>    
            <xpath expr="//field[@name='passport_id']" position="after">
                <field name="passport_expiration_date"/>
            </xpath>
            <xpath expr="//field[@name='work_email']" position="after">
                <field name="hospital_name"/>
            </xpath>
        </field>
    </record>
</odoo>
