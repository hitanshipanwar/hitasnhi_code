<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>

		<!-- Category -->
		<record model="ir.module.category" id="module_category_managers">
            <field name="name">Manager</field>
            <field name="description">Manager For Approvals</field>
            <field name="sequence">20</field>
    	</record>


    	<record model="ir.module.category" id="module_category_manage_contacts">
            <field name="name">Manage Contacts</field>
            <field name="description">Manage the Supplier and Customer</field>
            <field name="sequence">19</field>
    	</record>

		<!-- group to identidy manager -->
		<record model="res.groups" id="group_allow_suppliers">
			<field name="name">Allow to manage Supplier</field>
            <field name="category_id" ref="crm_design.module_category_manage_contacts"/>
        </record>
        <record model="res.groups" id="group_allow_customers">
			<field name="name">Allow to manage Customers</field>
            <field name="category_id" ref="crm_design.module_category_manage_contacts"/>
        </record>


		<record model="res.groups" id="group_manager">
			<field name="name">Manager</field>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>

        <record model="res.groups" id="group_manager_quotation">
			<field name="name">Quotation Approval Manager</field>
            <field name="category_id" ref="crm_design.module_category_managers"/>
        </record>

        <record model="res.groups" id="group_manager_schedular">
			<field name="name">Schedule Approval Manager</field>
            <field name="category_id" ref="crm_design.module_category_managers"/>
        </record>

        <record model="res.groups" id="group_manager_design">
			<field name="name">Design Approval Manager</field>
            <field name="category_id" ref="crm_design.module_category_managers"/>
        </record>

        <!-- group to identidy Employee -->
		<record model="res.groups" id="group_employee">
			<field name="name">Employee</field>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>


		<!-- Group to allow to add Design -->
		<record id="group_allow_to_add_design" model="res.groups">
	        <field name="name">Allow to add Design</field>
	        <field name="category_id" ref="crm_design.module_category_managers"/>
    	</record>

    	<!-- Record rule to display sale order to designer in which he/she selected as designer-->
		<record id="designer_access_record_rule" model="ir.rule">
	        <field name="name">Designer Record Rule</field>
	        <field name="model_id" ref="model_sale_order" /> 
	        <field name="domain_force">['|',('designer_id', '=', user.id),('message_is_follower','=',1)]</field> 
	        <field name="groups" eval="[(4, ref('crm_design.group_allow_to_add_design'))]"/>
    	</record>
    	<record id="visitor_access_record_rule" model="ir.rule">
	        <field name="name">Visitor Sale Access Record Rule</field>
	        <field name="model_id" ref="model_sale_order" /> 
	        <field name="domain_force">[('visitor_id', '=', user.id)]</field> 
	        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    	</record>
    	<!-- Allow All access of sale order to manager -->
    	<record id="manager_design_approver_record_rule" model="ir.rule">
	        <field name="name">Manager Design Approver</field>
	        <field name="model_id" ref="model_sale_order" /> 
	        <field name="groups" eval="[(4, ref('crm_design.group_manager_design'))]"/>
    	</record>


    	<!-- Record Rule to See all Appointment as a manager -->
    	<record model="ir.rule" id="appointment_view_rule_manager">
		    <field name="name">Manager View Rule Appointment</field>
		    <field name="model_id" ref="crm_design.model_appointment_visit"/>
		    <field name="groups" eval="[(4, ref('crm_design.group_manager_schedular')),(4, ref('base.group_user'))]" />
		    <field name="domain_force">[(1, '=', 1)]</field>
		</record>
		

		<!-- Record Rule to See Only own Appointment as a Employee -->
