<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_picking_form_inherit" model="ir.ui.view" >
		<field name="name">stock.move.form</field>
		<field name="model">stock.picking</field>
		<field name="inherit_id" ref="stock.view_picking_form"/>
		<field name="arch" type="xml">
			<xpath expr="//notebook/page[@name='operations']/field[@name='move_ids_without_package']/tree/field[@name='product_id']" position="after">
				<field name="vendor_product_code" optional="show"/>
			</xpath>
		</field>
	</record>

	<record id="view_stock_move_line_detailed_operation_tree_inherit" model="ir.ui.view" >
		<field name="name">view.stock.move.line.detailed.operation.tree.inherit</field>
		<field name="model">stock.move.line</field>
		<field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
		<field name="arch" type="xml">
			<xpath expr="//field[@name='product_id']" position="after">
				<field name="vendor_product_code" optional="show"/>
			</xpath>
		</field>
	</record>
	
</odoo>