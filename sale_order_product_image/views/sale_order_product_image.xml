<odoo>
    <record id="view_order_form_inherit_product_image" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.product.image</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='order_line']/tree/field[@name='product_template_id']" position="before">
                <field name="product_image"  widget="image" style="height:50px ;width:50px;" readonly="1"/>
            </xpath>

        </field>
    </record>
</odoo>