<?xml version="1.0"?>
<odoo>

    <record id="specs_helpdesk_ticket_view_form" model="ir.ui.view">
        <field name="name">specs.helpdesk.ticket.form</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" postion="after">
                <div class="alert alert-warning mb-0" role="alert" invisible="warning_msg==''">
                    <field name="warning_msg"/>
                </div>
            </xpath>

            <xpath expr="//field[@name='company_id']" position="after">
                <field name="specs_id" readonly="1" force_save="1"
                       invisible="specs_count == 0"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="specs_call_view"
                        type="object"
                        invisible="specs_count == 0"
                        class="oe_stat_button"
                        icon="fa-hand-o-right">
                    <field string="Specs" name="specs_count" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
