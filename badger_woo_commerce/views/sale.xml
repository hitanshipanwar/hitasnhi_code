<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_shipping_id']" position='attributes'>
                <attribute name="widget">res_partner_many2one</attribute>
                <attribute name='context'>{'default_type': 'delivery', 'show_address': 1, 'show_vat': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_invoice_id']" position='attributes'>
                <attribute name="widget">res_partner_many2one</attribute>
                <attribute name='context'>{'default_type': 'invoice', 'show_address': 1, 'show_vat': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">draft,sent,draft_so,sale</attribute>
            </xpath>
            <xpath expr="//button[@name='action_confirm']" position="attributes">
                <attribute name="attrs">{'invisible': [('state', '!=', 'draft_so')]}</attribute>
            </xpath>
            <xpath expr="//button[@name='action_confirm']" position="after">
                <button name="action_draft_so" data-hotkey="v" string="Draft SO" class="btn-primary"
                        confirm="This will set the state to Draft SO. Do you wish to continue?"
                        type="object" attrs="{'invisible': [('state', 'not in', ['draft', 'sent'])]}"/>
            </xpath>
            <xpath expr="//button[@name='action_confirm'][last()]" position="replace"/>
            <xpath expr="//button[@name='action_cancel']" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('state', 'not in', ['draft', 'sent','sale', 'draft_so']), ('id', '=', False)]}</attribute>
            </xpath>
            <!-- hide tag_ids in current possition and move to other Place -->
            <!-- hide tag_ids in current possition and move to other Place -->
            <xpath expr="//page[@name='other_information']//field[@name='tag_ids']" position="replace">
                <div/> 
            </xpath>
            <xpath expr="//field[@name='rep_template_id']" position="after">
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}"/> 
            </xpath>
           <!--  <xpath expr="//field[@name='tag_ids']" position="attributes">
                <attribute name="invisible">1</attribute> 
            </xpath>
            <xpath expr="//field[@name='rep_template_id']" position="after">
                <field name="tag_ids"/> 
            </xpath> -->

      </field>
    </record>
    
    <record id="sale_order_search_inherit" model="ir.ui.view">
        <field name="name">sale.order.search.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_view_search_inherit_quotation"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='draft']" position="after">
                <filter string="Draft SO" name="draft_so" domain="[('state','=', 'draft_so')]"/>
            </xpath>
        </field>
    </record>
</odoo>