<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_form_inheritff" model="ir.ui.view">
        <field name="name">account.move.form.inheritff</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="sale.account_invoice_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_shipping_id']" position='attributes'>
              
                <attribute name="widget">res_partner_many2one</attribute>
                <attribute name='context'>{'show_address': 1, 'show_vat': True}</attribute>
                <attribute name='options'>{"always_reload": True, "no_quick_create": True}</attribute>
            </xpath>
           
        </field>
    </record>
</odoo>
