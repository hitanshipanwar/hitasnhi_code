<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_picking_inherit" model="ir.ui.view">
        <field name="name">stock.picking.view.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids_without_package']/tree//field[@name='product_id']" position="after">
                <field name="employee_name" />
            </xpath>
        </field>
    </record>
    <record id="view_stock_move_line_detailed_operation_tree_employee" model="ir.ui.view">
        <field name="name">stock.move.line.operations.tree.employee</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="employee_name" />
            </xpath>
        </field>
    </record>
</odoo>