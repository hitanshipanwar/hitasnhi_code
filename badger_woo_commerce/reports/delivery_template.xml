<?xml version="1.0" encoding="utf-8" ?>
    <odoo>
        <template id="wmssoft_report_delivery_document">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="wmssoft_report.header_template_delivery">
                        <div class="page" style="padding-left:30px;padding-right:30px;font-size:14px;">
                            <div class="row" style="padding-left:0px; padding-right:0px;">
                                <div t-if="doc.rep_template_id" class="col-12" style="text-align:left">
                                    <span t-field="doc.rep_template_id.address_delivery"/>
                                </div>
                            </div>
                            <table style="border-collapse: collapse; width: 100%; padding-left:0px; padding-right:0px;" border="1">
                                <tbody>
                                <tr>
                                <td style="width: 33.3333%; text-align:center; border-right:12px solid #fff !important; background-color:#000000;color:#FFFFFF;"><strong>Bill To</strong></td>
                                <td style="width: 33.3333%; text-align:center; border-right:12px solid #fff !important; border-left:1px solid #fff !important; background-color:#000000;color:#FFFFFF;"><strong>Ship To</strong></td>
                                <td style="width: 33.3333%; text-align:center; border-left:1px solid #fff !important; background-color:#000000;color:#FFFFFF;"><strong>Order Details</strong></td>
                                </tr>
                                <tr style="font-size:15px;">
                                <td style="width: 33.3333%; text-align:left; border-right:12px solid #fff !important;">
                                  <!-- <span t-field="doc.company_id.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}' /> --><p><b><span t-field="doc.sale_id.partner_invoice_id.display_name"></span> 
                                    <!-- - <span t-field="doc.sale_id.partner_invoice_id.name"></span> -->
                                    </b></p><p><span t-field="doc.sale_id.partner_invoice_id" t-options='{"widget": "contact", "fields": ["address", "email"], "no_marker": True}' /></p>
                                <!-- <p><b><span class="text-o-color-1" style="box-sizing:border-box;color:#35979c;" t-field="doc.sale_id.partner_invoice_id.email"></span></b></p> --></td>
                                <td style="width: 33.3333%; text-align:left;border-right:12px solid #fff !important; border-left:1px solid #fff !important;"><p><b><span t-field="doc.sale_id.partner_shipping_id.display_name"></span></b></p><p><span t-field="doc.sale_id.partner_shipping_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}' /></p></td>
                                <td style="width: 33.3333%; text-align:left;border-left:1px solid #fff !important;">
                                    <p><strong>Sale Order Reference: </strong><span t-field="doc.sale_id.name"/></p>
                                    <p><strong>Customer Reference: </strong><span t-field="doc.sale_id.client_order_ref"/></p>
                                    <p><strong>Payment Terms:</strong><span t-field="doc.sale_id.payment_term_id"/></p></td>
                                </tr>
                                </tbody>
                            </table>
                           <!--  <div class="row" style="border:1px solid grey">
                                <div class="col-4" style="text-align:left">
                                    <p><strong>Bill to</strong></p>
                                    <p><span t-field="doc.company_id.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}' /><span t-field="doc.sale_id.partner_invoice_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}' /></p>
                                </div>
                                <div class="col-4" style="text-align:left">
                                    <p><strong>Ship to</strong></p>
                                    <p><span t-field="doc.sale_id.partner_shipping_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}' /></p>
                                </div>
                                <div class="col-4" style="text-align:left">
                                    <p><strong>SO Reference: </strong><span t-field="doc.sale_id.name"/></p>
                                    <p><strong>PO Number: </strong><span t-field="doc.sale_id.client_order_ref"/></p>
                                    <p><strong>Payment Terms: </strong><span t-field="doc.sale_id.payment_term_id"/></p>
                                </div>
                            </div> -->
                            <br/>
                            <div class="row o_table_row" style="padding-left:13px; padding-right:13px;">
                                <table class="o_table_row" style="width: 100%;">
                                    <thead style="background-color:#000000;">
                                        <tr style="background-color:#000000;color:#FFFFFF;">
                                            <th class="text-left" style="width:18%;padding-left:3px"><span>Item Code</span></th>
                                            <th class="text-left" style="padding-left:3px;"><span>Item Description</span></th>
                                            <t t-if="any(additional_info for additional_info in doc.move_lines.sale_line_id.mapped('x_studio_additional_information'))">
                                            <th class="text-left" style="padding-left:3px;"><span>Additional Info</span></th>
                                            </t>
                                            <th class="text-left" style="width:10%;padding-left:3px;"><span>Qty Ordered</span></th>
                                            <th class="text-left" style="width:10%;padding-left:3px;"><span>Shipped</span></th>
                                            <th class="text-right" style="width:10%;padding-left:3px;"><span>Backordered</span></th>
                                        </tr>
                                    </thead>
                                    <tbody class="sale_tbody" style="border-bottom: 1px solid black; font-size:14px;">
                                        <t t-set="lines" t-value="doc.move_lines.filtered(lambda x: x.product_uom_qty)"/>
                                        <t t-foreach="lines" t-as="line">
                                            <t t-set="qty_bo" t-value="line.org_qty - line.product_uom_qty"/>
                                            <tr>
                                                <td name="product_code" style="padding-left:3px">
                                                    <span t-field="line.product_id.default_code" t-options="{'widget': 'text'}"/>
                                                </td>
                                                <td name="sale_line_name" style="padding-left:3px;">
                                                    <span t-field="line.product_id.name"/>
                                                    <t t-if="line.sale_line_id.employee_name">
                                                        <br/><i>Associated to <span t-field="line.sale_line_id.employee_name" t-options="{'widget': 'text'}"/></i>
                                                    </t>
                                                </td>
                                                <!-- <td>
                                                    <span t-field="line.employee_name"/>
                                                </td> -->
                                                <t t-if="any(additional_info for additional_info in doc.move_lines.sale_line_id.mapped('x_studio_additional_information'))">
                                                <td name="td_additional_info" style="padding-left:3px;"><span t-field="line.sale_line_id.x_studio_additional_information" t-options="{'widget': 'text'}"/></td></t>
                                                <td name="qty_ordered" class="text-left" style="padding-left:3px;"><span t-esc="line.org_qty" t-options='{"widget": "float", "precision": 2}'/></td>
                                                <td name="qty_shipped" class="text-left" style="padding-left:3px;">
                                                <span t-esc="'{:.2f}'.format(round(line.product_uom_qty, 2))"/></td>
                                                <td name="qty_backorder" class="text-right" style="padding-left:3px;"><span t-esc="qty_bo" t-options='{"widget": "float", "precision": 2}'/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                            <br/>
                            <!-- Item Backorder Product List -->
                            <!-- <br/> -->
                            <t t-set="backorders" t-value="doc.backorder_ids.filtered(lambda x: x.state not in ('done', 'cancel'))"/>
                            <!-- <div class="row" style="padding-left:13px; padding-right:13px;width:100%;">    
                                <t t-if="doc.backorder_ids and backorders">
                                    <p>
                                        <b>Items backordered, still to be delivered:</b>
                                    </p>
                                </t>
                            </div> -->
                            <div class="row" style="padding-left:13px; padding-right:13px;">
                              <t t-if="doc.backorder_ids and backorders">
                                <table style="border-collapse: collapse; width: 100%;">
                                  <tbody>
                                    <tr>
                                      <td style="width: 100%;"><b>Items backordered, still to be delivered:</b></td>
                                    </tr>
                                  </tbody>
                                </table>
                              </t>
                            </div>
                            <br/>

                            <div class="row" style="padding-left:13px; padding-right:13px;">
                                <t t-if="doc.backorder_ids and backorders">
                                    <table class="o_table_row" style="padding-left:13px; padding-right:13px;font-size:15px !important;width:100%;">
                                        <thead style="background-color:#000000;">
                                            <tr style="background-color:#000000;color:#FFFFFF;">
                                                <th class="text-left" style="width:20%;padding-left:3px"><span>Item Code</span></th>
                                                <th class="text-left" style="width:60%;"><span>Description</span></th>
                                                <!-- <th class="text-left" style=""><span>Employee Name</span></th> -->
                                                <th class="text-right" style="width:20%;"><span>Quantity</span></th>
                                            </tr>
                                        </thead>
                                        <tbody class="sale_tbody" style="border-bottom: 1px solid black; font-size:14px;">
                                            <t t-foreach="backorders" t-as="backorder">
                                                <t t-set="bo_lines" t-value="backorder.move_lines.filtered(lambda x: x.product_uom_qty)"/>
                                                <tr t-foreach="bo_lines" t-as="bo_line">
                                                    <td name="product_code" style="padding-left:3px;width:20%">
                                                        <span t-field="bo_line.product_id.default_code" t-options="{'widget': 'text'}"/>
                                                    </td>
                                                    <td class="w-auto" style="width:60%">
                                                        <span t-field="bo_line.product_id.name"/>
                                                        <!-- <p t-if="bo_line.description_picking != bo_line.product_id.name and bo_line.description_picking != bo_line.product_id.display_name">
                                                            <span t-field="bo_line.description_picking"/>
                                                        </p> -->
                                                    </td>
                                                    <!-- <td>
                                                        <span t-field="bo_line.employee_name"/>
                                                    </td> -->
                                                    <td class="text-right w-auto" style="width:20%;">
                                                        <span t-field="bo_line.product_uom_qty"/>
                                                        <span t-field="bo_line.product_uom"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </t>
                            </div>
                            <br/>
                            <div class="row">
                                <div class="col-7 o_table_row" style="padding-left:13px;">
                                    <br/>
                                    <table class="o_table_row" style="width: 100%;">
                                        <thead style="background:#000000;color:#FFFFFF;">
                                            <tr>
                                                <th class="text-left" style="width:62%;padding-left:2px;"><span>Shipping Information</span></th>
                                                <th class="text-left" style="width:38%;padding-left:2px;"><span>Order Notes</span></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <td class="text-left" style="padding-left:2px;">
                                                <p>Courier: <span t-field="doc.carrier_id"/></p>
                                            </td>
                                            <td class="text-left" style="padding-left:2px;">
                                                
                                            </td>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>
        
        
        <template id="report_delivery_order">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-set="lang" t-value="doc.partner_id.lang"/>
                    <t t-call="badger_woo_commerce.wmssoft_report_delivery_document" t-lang="lang"/>
                </t>
            </t>
        </template>

        <record id="delivery_order_report" model="ir.actions.report">
            <field name="name">Badger Delivery Order (PDF)</field>
            <field name="model">stock.picking</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">badger_woo_commerce.report_delivery_order</field>
            <field name="report_file">badger_woo_commerce.report_delivery_order</field>
            <field name="print_report_name">'Delivery Order - %s' % (object.name)</field>
            <field name="binding_model_id" ref="stock.model_stock_picking"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="wmssoft_report.invoice_format"/>
        </record>
    </odoo>