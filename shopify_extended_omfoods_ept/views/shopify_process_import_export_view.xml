        <record id="action_wizard_shopify_update_products" model="ir.actions.act_window">
        <field name="name">Update Product Track</field>
        <field name="res_model">shopify.process.import.export</field>
        <field name="binding_model_id" ref="model_product_template"/>
        <field name="binding_view_types">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_shopify_process_import_export_from_more_ts"/>
<!--        <field name="groups_id" eval="[(4, ref('shopify_ept.group_shopify_ept'))]"/>-->
