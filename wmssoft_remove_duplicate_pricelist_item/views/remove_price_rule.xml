<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="duplicate_pricelist_remove" model="ir.actions.server">
        <field name="name">Remove Duplicate Price Rules</field>
        <field name="state">code</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="product.model_product_pricelist" />
        <field name="binding_model_id" ref="product.model_product_pricelist" />
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
        <field name="code">
            if records:
                records.remove_duplicate_product_items()
        </field>
    </record>
</odoo>