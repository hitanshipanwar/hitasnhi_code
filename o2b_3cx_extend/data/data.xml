<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="group_call_description_access" model="res.groups">
        <field name="name">3CX Information Access</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>

    <record id="res_call_log_company_rule" model="ir.rule">
        <field name="name">Call Logs per Company</field>
        <field name="model_id" ref="o2b_3cx_extend.model_res_call_log"/>
        <!-- <field name="domain_force">[('company_id', 'in', company_ids)]</field> -->
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- 3cx_template Inherit -->
    <template id="3cx_template" inherit_id="nalios_3cx_full.3cx_template">
        <xpath expr="//Parameters" position="inside">
            <Parameter Name="CompanyID" Type="String" Parent="General Configuration" Editor="String" Title="Company ID:" t-att-Default="rse_company.id"/>
        </xpath>
        <xpath expr="//PostValues" position="inside">
            <Value Key="company" Passes="1" Type="String">[CompanyID]</Value>
        </xpath>

